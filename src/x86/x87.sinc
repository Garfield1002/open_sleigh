    # Otherwise the quotient's low three bits land in C0, C3 and C1. A NaN
    # result has no quotient at all: hardware then clears C1 and C2 and leaves
    # C0 and C3 as it found them.
    local undefined:1 = nan(result) || faulted;
    local incomplete:1 = (quotient & 8) != 0;
    local kept0:1 = ((FPUStatusWord >> 8) & 1) != 0;
    local kept3:1 = ((FPUStatusWord >> 14) & 1) != 0;
