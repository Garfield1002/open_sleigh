:FXAM           is vexMode=0 & byte=0xD9; byte=0xE5
{
  FPUInstructionPointer = inst_start;
  local top:2 = (FPUStatusWord >> 11) & 7;
  local value:10 = *[x87]:10 (top * 10);
  local tag:2 = (FPUTagWord >> (top * 2)) & 3;
  local exponent:2 = value[64,15];
  local significand:8 = value[0,64];
  local fraction:8 = value[0,63];
  local integer_bit:1 = value[63,1];
  local sign:1 = value[79,1];
  local empty:1 = tag == 3;
  local zero:1 = !empty && exponent == 0 && significand == 0;
  local normal:1 = !empty && exponent != 0 && exponent != 0x7fff && integer_bit;
  local infinity:1 = !empty && exponent == 0x7fff && integer_bit && fraction == 0;
  local nan:1 = !empty && exponent == 0x7fff && integer_bit && fraction != 0;
  local denormal:1 = !empty && exponent == 0 && significand != 0;
  # Codes are C3:C2:C0: unsupported=000, NaN=001, normal=010,
  # infinity=011, zero=100, empty=101, denormal=110.
  local c0:1 = empty || infinity || nan;
  local c1:1 = !empty && sign;
  local c2:1 = normal || infinity || denormal;
  local c3:1 = empty || zero || denormal;
  fpu_set_condition_codes(c0, c1, c2, c3);
    fpu_record_opcode(0x1e5:2);
}
                                                                    
:FXCH fregop      is vexMode=0 & byte=0xD9; frow=12 & fpage=1 & fregop & freg=0 & modidx & regidx & rmidx
{
    FPUInstructionPointer = inst_start;
    FPUStatusWord = FPUStatusWord & 0xfdff;
    fpu_record_opcode((0x100:2 | (modidx << 6) | (regidx << 3) | rmidx));
}
:FXCH fregop      is vexMode=0 & byte=0xD9; frow=12 & fpage=1 & fregop & freg=1 & modidx & regidx & rmidx
{
    FPUInstructionPointer = inst_start;
    # FXCH references ST(0) and ST(i), so an empty either side is a stack
    # fault. The exchange itself still happens under a masked underflow.
    fpu_stack_underflow(1:2);
    local tmp = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10);
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = fregop;
    fregop = tmp;
    tagswap1();
    fpu_record_opcode((0x100:2 | (modidx << 6) | (regidx << 3) | rmidx));
}
