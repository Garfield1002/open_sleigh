# Be careful that you don't clobber fregop during fpushv, need a tmp to hold the value
# Loading an empty ST(i) is a stack underflow: the push still happens and the
# indefinite lands in the new ST(0), so the fault is applied after `fpushv`
# has moved TOP.
:FLD fregop       is vexMode=0 & byte=0xD9; frow=12 & fpage=0 & fregop & fregidx
{
    FPUInstructionPointer = inst_start;
    local faulted:1;
    fpu_stack_underflow_src(fregidx, faulted);
    tmp:10 = fregop;
    fpushv(tmp);
    local slot:2 = ((FPUStatusWord >> 11) & 7) * 10;
    fpu_underflow_indefinite(faulted, slot);
}
                                                                      
:FLD1           is vexMode=0 & byte=0xD9; byte=0xE8  
{ 
    FPUInstructionPointer = inst_start;
    one:4 = 1; 
    tmp:10 = int2float(one); 
    fpushv(tmp); 
    fpu_record_opcode(0x1e8:2);
}  

:FLDL2T		is vexMode=0 & byte=0xD9; byte=0xE9
{ 
    FPUInstructionPointer = inst_start;
    # Exact 80-bit log2(10); the f64 source constant this replaced lost
    # the low 11 significand bits at float2float.
    significand:10 = zext(0xd49a784bcd1b8afe:8);
    sign_exponent:10 = zext(0x4000:2);
    tmp:10 = (sign_exponent << 64) | significand;
    fpushv(tmp); 
    fpu_record_opcode(0x1e9:2);
}

:FLDL2E		is vexMode=0 & byte=0xD9; byte=0xEA			
{ 
    FPUInstructionPointer = inst_start;
    # Exact 80-bit log2(e); the f64 source constant this replaced lost
    # the low 11 significand bits at float2float.
    significand:10 = zext(0xb8aa3b295c17f0bc:8);
    sign_exponent:10 = zext(0x3fff:2);
    tmp:10 = (sign_exponent << 64) | significand;
    fpushv(tmp); 
    fpu_record_opcode(0x1ea:2);
}

:FLDPI		is vexMode=0 & byte=0xD9; byte=0xEB			
{
    FPUInstructionPointer = inst_start;
    # Exact 80-bit pi; the f64 source constant this replaced lost
    # the low 11 significand bits at float2float.
    significand:10 = zext(0xc90fdaa22168c235:8);
    sign_exponent:10 = zext(0x4000:2);
    tmp:10 = (sign_exponent << 64) | significand;
    fpushv(tmp);
    fpu_record_opcode(0x1eb:2);
}

:FLDLG2		is vexMode=0 & byte=0xD9; byte=0xEC			
{ 
    FPUInstructionPointer = inst_start;
    # Exact 80-bit log10(2); the f64 source constant this replaced lost
    # the low 11 significand bits at float2float.
    significand:10 = zext(0x9a209a84fbcff799:8);
    sign_exponent:10 = zext(0x3ffd:2);
    tmp:10 = (sign_exponent << 64) | significand;
    fpushv(tmp); 
    fpu_record_opcode(0x1ec:2);
}

:FLDLN2		is vexMode=0 & byte=0xD9; byte=0xED			
{ 
    FPUInstructionPointer = inst_start;
    # Exact 80-bit ln(2); the f64 source constant this replaced lost
    # the low 11 significand bits at float2float.
    significand:10 = zext(0xb17217f7d1cf79ac:8);
    sign_exponent:10 = zext(0x3ffe:2);
    tmp:10 = (sign_exponent << 64) | significand;
    fpushv(tmp); 
    fpu_record_opcode(0x1ed:2);
}

:FLDZ		is vexMode=0 & byte=0xD9; byte=0xEE			
{ 
    FPUInstructionPointer = inst_start;
    zero:4 = 0;
    tmp:10 = int2float(zero); 
    fpushv(tmp); 
    fpu_record_opcode(0x1ee:2);
}

:FLDCW m16      is vexMode=0 & byte=0xD9; (mod != 0b11 & reg_opcode=5) ... & m16            
{ 
    FPUControlWord = m16; 
    # A new control word can unmask an exception that is already pending, so
    # the error summary has to be recomputed against the masks just loaded.
    fpu_refresh_error_summary();
}

define pcodeop fldenv;
:FLDENV Mem     is vexMode=0 & byte=0xD9; (mod != 0b11 & reg_opcode=4) ... & Mem
{
  FPUControlWord           = *:2 (Mem);
  FPUStatusWord            = *:2 (Mem +  4);
  FPUTagWord               = *:2 (Mem +  8);
  # Legacy environments carry 32-bit pointers.  Explicitly zero-extend them:
  # assigning a bare *:4 to the 64-bit x86-64 register makes SLEIGH widen the
  # memory load itself, incorrectly consuming the FOP/selector-adjacent bytes.
  FPUDataPointer           = zext(*:4 (Mem + 20));
  FPUInstructionPointer    = zext(*:4 (Mem + 12));
  FPULastInstructionOpcode = *:2 (Mem + 18);
}

:FMUL m32fp       is vexMode=0 & byte=0xD8; reg_opcode=1 ... & m32fp & modidx & regidx & rmidx & Mem & st0
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = float2float(m32fp);
    fpu_guarded_mul(st0, a, b);
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x000:2 | (modidx << 6) | (regidx << 3) | rmidx));
}

:FMUL m64fp       is vexMode=0 & byte=0xDC; reg_opcode=1 ... & m64fp & modidx & regidx & rmidx & Mem & st0
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = float2float(m64fp);
    fpu_guarded_mul(st0, a, b);
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x400:2 | (modidx << 6) | (regidx << 3) | rmidx));
}

:FMUL fregop      is vexMode=0 & byte=0xD8; frow=12 & fpage=1 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = fregop;
    fpu_guarded_mul(st0, a, b);
    fpu_record_opcode((0x0c8:2 | zext(fregidx)));
}          

:FMUL fregop      is vexMode=0 & byte=0xDC; frow=12 & fpage=1 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local a:10 = fregop;
    local b:10 = st0;
