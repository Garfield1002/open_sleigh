:FLD m32fp        is vexMode=0 & byte=0xD9; (mod != 0b11 & reg_opcode=0) ... & m32fp & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    # A narrow memory source reports its own denormal-operand and
    # signalling-NaN facts: the widened extended value is normal and quiet.
    local mem_de:1;
    local mem_snan:1;
    fpu_f32_source_flags(m32fp, mem_de, mem_snan);
    fpu_signal_invalid_if(mem_snan);
    fpu_signal_denormal_if(mem_de);
    local value:10 = float2float(m32fp);
    fpushv(value);
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x100:2 | (modidx << 6) | (regidx << 3) | rmidx));
}           

