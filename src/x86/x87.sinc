macro tagswap6() {
    FPUStatusWord = FPUStatusWord & 0xfdff;
    local top:2 = (FPUStatusWord >> 11) & 7;
    local s0:2 = top * 2;
    local s1:2 = ((top + 6) & 7) * 2;
    local t0:2 = (FPUTagWord >> s0) & 3;
    local t1:2 = (FPUTagWord >> s1) & 3;
    FPUTagWord = FPUTagWord - (t0 << s0) - (t1 << s1);
    FPUTagWord = FPUTagWord | (t0 << s1) | (t1 << s0);
}
macro tagswap7() {
    FPUStatusWord = FPUStatusWord & 0xfdff;
    local top:2 = (FPUStatusWord >> 11) & 7;
    local s0:2 = top * 2;
    local s1:2 = ((top + 7) & 7) * 2;
    local t0:2 = (FPUTagWord >> s0) & 3;
    local t1:2 = (FPUTagWord >> s1) & 3;
    FPUTagWord = FPUTagWord - (t0 << s0) - (t1 << s1);
    FPUTagWord = FPUTagWord | (t0 << s1) | (t1 << s0);
}

macro fdec() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    FPUStatusWord = (FPUStatusWord & 0xc7ff) | (((top - 1) & 7) << 11);
}

macro finc() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    FPUStatusWord = (FPUStatusWord & 0xc7ff) | (((top + 1) & 7) << 11);
}

macro fpop() {
    tagempty0();
    finc();
}

macro fpushv(val) {
    # Capture before changing TOP: FLD ST(i) may source an old logical view.
    local value:10 = val;
    fdec();
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = top * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    local overflow:1 = old_tag != 3;
    local overflow_mask:10 = 0 - zext(overflow);
    local indefinite:10 = zext(0xc000000000000000:8);
    indefinite = indefinite | (zext(0xffff:2) << 64);
    local stored:10 = (value & ~overflow_mask) | (indefinite & overflow_mask);
    *[x87]:10 (top * 10) = stored;
    # A masked stack overflow writes the indefinite QNaN, marks the new slot
    # special, sets IE/SF/C1, and still updates TOP.  A normal push is valid
    # and clears C1.
    local new_tag:2 = overflow * 2;
    FPUTagWord = (FPUTagWord - (old_tag << shift)) | (new_tag << shift);
    FPUStatusWord = (FPUStatusWord & 0xfdff) |
                    (overflow << 9) | (overflow * 0x41);
    C1 = overflow;
}

macro fpopv(val) {
    local value:10 = *[x87]:10 (((FPUStatusWord >> 11) & 7) * 10);
    val = value;
    fpop();
}

# Update only x87 condition codes.  TOP, exception/sticky status, and the
# busy/error-summary bits are not comparison results and must survive.
macro fpu_set_condition_codes(c0, c1, c2, c3) {
    FPUStatusWord = (FPUStatusWord & 0xb8ff) |
                    (zext(c0) << 8) | (zext(c1) << 9) |
                    (zext(c2) << 10) | (zext(c3) << 14);
}

# FDP records the memory operand's address. Hardware writes it together with
# FOP and under the same condition: only when an unmasked exception is pending.
macro fpu_record_data_pointer(address) {
    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x3f;
    local pending:8 = zext(unmasked != 0);
    local keep:8 = zext(unmasked == 0);
    FPUDataPointer = (FPUDataPointer * keep) | (address * pending);
}

# Refresh ES from the sticky exception bits against their masks.
# FOP records the instruction's 11-bit opcode: the low three bits of the first
# opcode byte and the whole second byte. This processor writes it only when an
# unmasked exception is pending, so the field is otherwise left alone.
macro fpu_record_opcode(value) {
    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x3f;
    local pending:2 = zext(unmasked != 0);
    local keep:2 = zext(unmasked == 0);
    FPULastInstructionOpcode = (FPULastInstructionOpcode * keep) | (value * pending);
}

macro fpu_refresh_error_summary() {
    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x3f;
    local pending:2 = zext(unmasked != 0);
    # B mirrors ES on every processor since the 387; both are recomputed from
    # the sticky exception bits against their masks.
    FPUStatusWord = (FPUStatusWord & 0x7f7f) | (pending << 7) | (pending << 15);
}

# Referencing an empty register is a stack fault: IE and SF are set together
# and C1 reports the direction, cleared for an underflow. `index` is the
# logical ST(i) of the second operand; ST(0) is always checked too.
# As `fpu_stack_underflow`, but also reports the fault so a comparison can
# force its unordered answer instead of comparing empty slots.
macro fpu_stack_underflow_out(index, faulted) {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift0:2 = (top & 7) * 2;
    local shift1:2 = ((top + index) & 7) * 2;
    local empty0:1 = ((FPUTagWord >> shift0) & 3) == 3;
    local empty1:1 = ((FPUTagWord >> shift1) & 3) == 3;
    faulted = empty0 || empty1;
    local fault:2 = zext(faulted);
    FPUStatusWord = (FPUStatusWord | (fault * 0x41)) & ~(fault * 0x200);
    fpu_refresh_error_summary();
}

# A masked stack underflow delivers the indefinite QNaN in place of the result
# and leaves the destination reading as occupied. `slot` is the byte address of
# the destination register in the x87 space.
macro fpu_underflow_indefinite(faulted, slot) {
    local keep:8 = zext(!faulted);
    local take:8 = zext(faulted);
    *[x87]:8 (slot) = (*[x87]:8 (slot) * keep) | (0xc000000000000000 * take);
    local keep2:2 = zext(!faulted);
    local take2:2 = zext(faulted);
    *[x87]:2 (slot + 8) = (*[x87]:2 (slot + 8) * keep2) | (0xffff * take2);
    # Mark the slot special rather than empty; the abridged tag only records
    # occupancy, which is what a save reports.
    local shift:2 = (slot / 10) * 2;
    local cleared:2 = FPUTagWord & ~(3 << shift);
    FPUTagWord = (FPUTagWord * zext(!faulted)) | ((cleared | (2 << shift)) * zext(faulted));
}

# As `fpu_stack_underflow_out`, but checks the named register alone. FLD ST(i)
# reads only its source: the destination does not exist until the push, so
# faulting on an empty ST(0) would report an underflow the instruction never
# had.
macro fpu_stack_underflow_src(index, faulted) {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + index) & 7) * 2;
    faulted = ((FPUTagWord >> shift) & 3) == 3;
    local fault:2 = zext(faulted);
    FPUStatusWord = (FPUStatusWord | (fault * 0x41)) & ~(fault * 0x200);
    fpu_refresh_error_summary();
}

macro fpu_stack_underflow(index) {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift0:2 = (top & 7) * 2;
    local shift1:2 = ((top + index) & 7) * 2;
    local empty0:1 = ((FPUTagWord >> shift0) & 3) == 3;
    local empty1:1 = ((FPUTagWord >> shift1) & 3) == 3;
    local fault:2 = zext(empty0 || empty1);
    FPUStatusWord = (FPUStatusWord | (fault * 0x41)) & ~(fault * 0x200);
    fpu_refresh_error_summary();
}

# True when an f80 holds a denormal: a zero exponent with a non-zero
# significand. An unnormal - a non-zero exponent with the explicit integer bit
# clear - is an invalid encoding rather than a denormal, and raises IE instead.
macro fpu_is_denormal(value, result) {
    local exponent:2 = value[64,15];
    local significand:8 = value[0,64];
    result = (exponent == 0) && (significand != 0);
}

# Raise the denormal-operand exception when `cond` holds.
macro fpu_signal_denormal_if(cond) {
    FPUStatusWord = FPUStatusWord | (zext(cond) << 1);
    fpu_refresh_error_summary();
}

# Report a denormal operand for a one- or two-source operation.
macro fpu_signal_denormal1(a) {
    local da:1; fpu_is_denormal(a, da);
    fpu_signal_denormal_if(da);
}

# True when an f80 holds either signed zero.
macro fpu_is_zero(value, result) {
    local exponent:2 = value[64,15];
    local significand:8 = value[0,64];
    result = (exponent == 0) && (significand == 0);
}

macro fpu_signal_denormal2(a, b) {
    local da:1; fpu_is_denormal(a, da);
    local db:1; fpu_is_denormal(b, db);
    # Invalid takes precedence: when an operand is a NaN the operation reports
    # IE and leaves DE alone.
    local invalid:1 = nan(a) || nan(b);
    fpu_signal_denormal_if((da || db) && !invalid);
}

# The exceptions this instruction raised that its own mask leaves unmasked.
# An unmasked exception aborts the instruction: hardware leaves x87 state as it
# found it, so the destination and TOP must not be committed.
#
# The exception flags are sticky, so this compares against `before` rather than
# reading the whole status word. Testing the accumulated word would let a single
# unmasked flag left by an earlier instruction abort every x87 instruction after
# it. Operand exceptions (IE, DE) have to be signalled and tested before the
# operation runs, or the operation's own result exceptions are recorded on the
# way past; the result is held in a local and tested again after it, so a
# commit only happens once no aborting exception has fired.
#
# Only IE, DE and ZE abort. The other three unmasked exceptions still write a
# destination before trapping, so treating them as aborts would suppress a
# store hardware performs: #P delivers the rounded result and then traps, and
# #O/#U deliver an exponent-scaled result. Masking them out here keeps the
# guard to the cases where hardware leaves x87 state untouched.
macro fpu_raised_unmasked(before, raised) {
    raised = FPUStatusWord & ~before & ~FPUControlWord & 0x07;
}

# Snapshot the status word, report the operand exceptions a one- or two-source
# operation raises, and say whether any of them aborts. Operand exceptions have
# to be signalled before the operation runs: afterwards its own result
# exceptions are already in the word and cannot be told apart.
macro fpu_operand_check1(a, before, raised) {
    before = FPUStatusWord;
    fpu_signal_denormal1(a);
    fpu_raised_unmasked(before, raised);
}

macro fpu_operand_check2(a, b, before, raised) {
    before = FPUStatusWord;
    fpu_signal_denormal2(a, b);
    fpu_raised_unmasked(before, raised);
}

# As `fpu_signal_denormal2`, for a division. A zero divisor decides the result
# on its own: hardware reports the divide by zero alone and leaves DE clear,
# even when the dividend is denormal.
macro fpu_signal_denormal_div(a, b) {
    local da:1; fpu_is_denormal(a, da);
    local db:1; fpu_is_denormal(b, db);
    local invalid:1 = nan(a) || nan(b);
    local divisor_zero:1; fpu_is_zero(b, divisor_zero);
    fpu_signal_denormal_if((da || db) && !invalid && !divisor_zero);
}

macro fpu_operand_check2_div(a, b, before, raised) {
    before = FPUStatusWord;
    fpu_signal_denormal_div(a, b);
    fpu_raised_unmasked(before, raised);
}

# Raise the invalid-operation exception when `cond` holds, and refresh ES to
# reflect whether any unmasked exception is now pending. Branch-free so it is
# safe to expand more than once in a constructor.
macro fpu_signal_invalid_if(cond) {
    FPUStatusWord = FPUStatusWord | zext(cond);
    fpu_refresh_error_summary();
}

# The unordered compare. Only a signalling NaN raises invalid, which the
# concrete interpreter already applies to the f80 comparison itself.
macro fucom_faulted(val, faulted) {
    fpu_signal_denormal2(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), val);
    # An underflowed compare reports unordered: C0, C2 and C3 all set.
    local c2 = faulted || nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10)) || nan(val);
    local c0 = c2 | (*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f< val);
    local c3 = c2 | (*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f== val);
    fpu_set_condition_codes(c0, 0:1, c2, c3);
}

# The ordered compare. It raises invalid for a quiet NaN too, which is the only
# thing separating it from FUCOM: both produce identical p-code otherwise.
macro fcom_faulted(val, faulted) {
    fpu_signal_denormal2(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), val);
    # An underflowed compare reports unordered: C0, C2 and C3 all set.
    local c2 = faulted || nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10)) || nan(val);
    local c0 = c2 | (*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f< val);
    local c3 = c2 | (*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f== val);
    fpu_set_condition_codes(c0, 0:1, c2, c3);
    fpu_signal_invalid_if(c2);
}

# Produce the architectural full tag associated with an occupied f80 slot.
# The abridged tag transport only distinguishes occupied from empty, so saves
# must recover zero and special classes from the physical f80 encoding.
macro fpu_tag_class(value, old_tag, result) {
    local exponent:2 = value[64,15];
    local significand:8 = value[0,64];
    local integer_bit:1 = value[63,1];
    local is_zero:1 = (exponent == 0) && (significand == 0);
    local is_normal:1 = (exponent != 0) && (exponent != 0x7fff) && integer_bit;
    local occupied_class:2 = zext(is_zero) | (zext(!is_zero && !is_normal) << 1);
    local is_empty:1 = old_tag == 3;
    local is_occupied:1 = old_tag != 3;
    result = (zext(is_empty) * 3) | (zext(is_occupied) * occupied_class);
}

macro fpu_synthesized_tag(result) {
    local r0:10 = *[x87]:10 0:2;  local old0:2 = (FPUTagWord >>  0) & 3; local c0:2; fpu_tag_class(r0, old0, c0);
    local r1:10 = *[x87]:10 10:2; local old1:2 = (FPUTagWord >>  2) & 3; local c1:2; fpu_tag_class(r1, old1, c1);
    local r2:10 = *[x87]:10 20:2; local old2:2 = (FPUTagWord >>  4) & 3; local c2:2; fpu_tag_class(r2, old2, c2);
    local r3:10 = *[x87]:10 30:2; local old3:2 = (FPUTagWord >>  6) & 3; local c3:2; fpu_tag_class(r3, old3, c3);
    local r4:10 = *[x87]:10 40:2; local old4:2 = (FPUTagWord >>  8) & 3; local c4:2; fpu_tag_class(r4, old4, c4);
    local r5:10 = *[x87]:10 50:2; local old5:2 = (FPUTagWord >> 10) & 3; local c5:2; fpu_tag_class(r5, old5, c5);
    local r6:10 = *[x87]:10 60:2; local old6:2 = (FPUTagWord >> 12) & 3; local c6:2; fpu_tag_class(r6, old6, c6);
    local r7:10 = *[x87]:10 70:2; local old7:2 = (FPUTagWord >> 14) & 3; local c7:2; fpu_tag_class(r7, old7, c7);
    # Build incrementally so every shift/OR inherits the two-byte result type.
    result = c0;
    result = result | (c1 << 2);
    result = result | (c2 << 4);
    result = result | (c3 << 6);
    result = result | (c4 << 8);
    result = result | (c5 << 10);
    result = result | (c6 << 12);
    result = result | (c7 << 14);
}

macro store_synthesized_fpu_tag(Mem) {
    local full_tag:2;
    fpu_synthesized_tag(full_tag);
    *:2 (Mem + 8) = full_tag;
}

macro fpu_clear_c1() {
    FPUStatusWord = FPUStatusWord & 0xfdff;
    C1 = 0;
}

# An unmasked exception aborts the instruction on hardware: it produces no
# result, records no rounding, and does not pop. `raised` is non-zero exactly
# when the operand check or the operation itself signalled one, and the guard
# then skips the commit.
#
# The abort label cannot be split across two macros - SLEIGH scopes a label to
# a single expansion, so a begin/end pair fails to link - which is why each
# guard owns the whole operation. Two consequences: the operator cannot be a
# parameter, so there is one macro per operation, and the pop is baked in
# rather than passed as a flag, so that a non-popping form emits no dead
# tag/TOP update. The reverse forms (FSUBR, FDIVR) swap `a` and `b` at the
# call site instead of getting macros of their own.
#
# `dst` is the destination view itself - `st0`, `st1` or `fregop`. Nothing in
# the guard moves TOP before the commit, so the view still resolves to the
# slot the instruction started with, and a pop happens strictly after it.

macro fpu_guarded_add(dst, a, b) {
    fpu_clear_c1();
    local before:2;
    local raised:2;
    fpu_operand_check2(a, b, before, raised);
    if (raised != 0) goto <abort>;
    local result:10 = a f+ b;
    fpu_raised_unmasked(before, raised);
    if (raised != 0) goto <abort>;
    dst = result;
<abort>
}

macro fpu_guarded_add_pop(dst, a, b) {
    fpu_clear_c1();
    local before:2;
    local raised:2;
    fpu_operand_check2(a, b, before, raised);
    if (raised != 0) goto <abort>;
    local result:10 = a f+ b;
    fpu_raised_unmasked(before, raised);
    if (raised != 0) goto <abort>;
    dst = result;
    fpop();
<abort>
}

macro fpu_guarded_sub(dst, a, b) {
    fpu_clear_c1();
    local before:2;
    local raised:2;
    fpu_operand_check2(a, b, before, raised);
    if (raised != 0) goto <abort>;
    local result:10 = a f- b;
    fpu_raised_unmasked(before, raised);
    if (raised != 0) goto <abort>;
    dst = result;
<abort>
}

macro fpu_guarded_sub_pop(dst, a, b) {
    fpu_clear_c1();
    local before:2;
    local raised:2;
    fpu_operand_check2(a, b, before, raised);
    if (raised != 0) goto <abort>;
    local result:10 = a f- b;
    fpu_raised_unmasked(before, raised);
    if (raised != 0) goto <abort>;
    dst = result;
    fpop();
<abort>
}

macro fpu_guarded_mul(dst, a, b) {
    fpu_clear_c1();
    local before:2;
    local raised:2;
    fpu_operand_check2(a, b, before, raised);
