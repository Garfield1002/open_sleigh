macro fdec() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    FPUStatusWord = (FPUStatusWord & 0xc7ff) | (((top - 1) & 7) << 11);
}

macro finc() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    FPUStatusWord = (FPUStatusWord & 0xc7ff) | (((top + 1) & 7) << 11);
}

macro fpop() {
    tagempty0();
    finc();
}

macro fpushv(val) {
    # Capture before changing TOP: FLD ST(i) may source an old logical view.
    local value:10 = val;
    fdec();
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = top * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    local overflow:1 = old_tag != 3;
    local overflow_mask:10 = 0 - zext(overflow);
    local indefinite:10 = zext(0xc000000000000000:8);
    indefinite = indefinite | (zext(0xffff:2) << 64);
    local stored:10 = (value & ~overflow_mask) | (indefinite & overflow_mask);
    *[x87]:10 (top * 10) = stored;
    # A masked stack overflow writes the indefinite QNaN, marks the new slot
    # special, sets IE/SF/C1, and still updates TOP.  A normal push is valid
    # and clears C1.
    local new_tag:2 = overflow * 2;
    FPUTagWord = (FPUTagWord - (old_tag << shift)) | (new_tag << shift);
    FPUStatusWord = (FPUStatusWord & 0xfdff) |
                    (overflow << 9) | (overflow * 0x41);
    C1 = overflow;
}

macro fpopv(val) {
    local value:10 = *[x87]:10 (((FPUStatusWord >> 11) & 7) * 10);
    val = value;
    fpop();
}

# Update only x87 condition codes.  TOP, exception/sticky status, and the
# busy/error-summary bits are not comparison results and must survive.
macro fpu_set_condition_codes(c0, c1, c2, c3) {
    FPUStatusWord = (FPUStatusWord & 0xb8ff) |
                    (zext(c0) << 8) | (zext(c1) << 9) |
                    (zext(c2) << 10) | (zext(c3) << 14);
}

# FDP records the memory operand's address. Hardware writes it together with
# FOP and under the same condition: only when an unmasked exception is pending.
macro fpu_record_data_pointer(address) {
    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x3f;
    local pending:8 = zext(unmasked != 0);
    local keep:8 = zext(unmasked == 0);
    FPUDataPointer = (FPUDataPointer * keep) | (address * pending);
}

# Refresh ES from the sticky exception bits against their masks.
# FOP records the instruction's 11-bit opcode: the low three bits of the first
# opcode byte and the whole second byte. This processor writes it only when an
# unmasked exception is pending, so the field is otherwise left alone.
macro fpu_record_opcode(value) {
    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x3f;
    local pending:2 = zext(unmasked != 0);
    local keep:2 = zext(unmasked == 0);
    FPULastInstructionOpcode = (FPULastInstructionOpcode * keep) | (value * pending);
}

macro fpu_refresh_error_summary() {
    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x3f;
    local pending:2 = zext(unmasked != 0);
    # B mirrors ES on every processor since the 387; both are recomputed from
    # the sticky exception bits against their masks.
    FPUStatusWord = (FPUStatusWord & 0x7f7f) | (pending << 7) | (pending << 15);
}

# Referencing an empty register is a stack fault: IE and SF are set together
# and C1 reports the direction, cleared for an underflow. `index` is the
# logical ST(i) of the second operand; ST(0) is always checked too.
# As `fpu_stack_underflow`, but also reports the fault so a comparison can
# force its unordered answer instead of comparing empty slots.
macro fpu_stack_underflow_out(index, faulted) {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift0:2 = (top & 7) * 2;
    local shift1:2 = ((top + index) & 7) * 2;
    local empty0:1 = ((FPUTagWord >> shift0) & 3) == 3;
    local empty1:1 = ((FPUTagWord >> shift1) & 3) == 3;
    faulted = empty0 || empty1;
    local fault:2 = zext(faulted);
    FPUStatusWord = (FPUStatusWord | (fault * 0x41)) & ~(fault * 0x200);
    fpu_refresh_error_summary();
}

# A masked stack underflow delivers the indefinite QNaN in place of the result
# and leaves the destination reading as occupied. `slot` is the byte address of
# the destination register in the x87 space.
macro fpu_underflow_indefinite(faulted, slot) {
    local keep:8 = zext(!faulted);
    local take:8 = zext(faulted);
    *[x87]:8 (slot) = (*[x87]:8 (slot) * keep) | (0xc000000000000000 * take);
    local keep2:2 = zext(!faulted);
    local take2:2 = zext(faulted);
    *[x87]:2 (slot + 8) = (*[x87]:2 (slot + 8) * keep2) | (0xffff * take2);
    # Mark the slot special rather than empty; the abridged tag only records
    # occupancy, which is what a save reports.
    local shift:2 = (slot / 10) * 2;
    local cleared:2 = FPUTagWord & ~(3 << shift);
    FPUTagWord = (FPUTagWord * zext(!faulted)) | ((cleared | (2 << shift)) * zext(faulted));
}

macro fpu_stack_underflow(index) {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift0:2 = (top & 7) * 2;
    local shift1:2 = ((top + index) & 7) * 2;
    local empty0:1 = ((FPUTagWord >> shift0) & 3) == 3;
    local empty1:1 = ((FPUTagWord >> shift1) & 3) == 3;
    local fault:2 = zext(empty0 || empty1);
    FPUStatusWord = (FPUStatusWord | (fault * 0x41)) & ~(fault * 0x200);
    fpu_refresh_error_summary();
}

# Register transfers do not perform floating-point arithmetic. Inspect tags,
# not payloads: an empty slot can contain an otherwise valid old value.
macro fpu_store_register(index, pop) {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local source:2 = top * 10;
    local target:2 = ((top + index) & 7) * 10;
    local faulted:1;
    fpu_stack_underflow_out(0:2, faulted);
    FPUStatusWord = FPUStatusWord & 0xfdff;
    C1 = 0;
    local commit:1 = !faulted || ((FPUControlWord & 1) != 0);
    local mask:10 = 0 - zext(commit);
    local value:10 = *[x87]:10 source;
    local faultmask:10 = 0 - zext(faulted);
    local indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    value = (value & ~faultmask) | (indefinite & faultmask);
    *[x87]:10 target = (value & mask) | (*[x87]:10 target & ~mask);
    local tag:2 = (FPUTagWord >> (top * 2)) & 3;
    tag = (tag * zext(!faulted)) | (2 * zext(faulted));
    local shift:2 = (target / 10) * 2;
    local tags:2 = (FPUTagWord & ~(3 << shift)) | (tag << shift);
    local tagmask:2 = 0 - zext(commit);
    FPUTagWord = (tags & tagmask) | (FPUTagWord & ~tagmask);
    local popped:2 = zext(commit) * pop;
    FPUTagWord = FPUTagWord | ((3 * popped) << (top * 2));
    FPUStatusWord = (FPUStatusWord & 0xc7ff) | (((top + popped) & 7) << 11);
    fpu_record_opcode(0x5d0:2 | index | (pop << 3));
}

macro fpu_exchange_register(index) {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local source:2 = top * 10;
    local target:2 = ((top + index) & 7) * 10;
    local shift0:2 = top * 2;
    local shift1:2 = (target / 10) * 2;
    local tag0:2 = (FPUTagWord >> shift0) & 3;
    local tag1:2 = (FPUTagWord >> shift1) & 3;
    local empty0:1 = tag0 == 3;
    local empty1:1 = tag1 == 3;
    local faulted:1;
    fpu_stack_underflow_out(index, faulted);
    FPUStatusWord = FPUStatusWord & 0xfdff;
    C1 = 0;
    local commit:1 = !faulted || ((FPUControlWord & 1) != 0);
    local mask:10 = 0 - zext(commit);
    local mask0:10 = 0 - zext(empty0);
    local mask1:10 = 0 - zext(empty1);
    local indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    local old0:10 = *[x87]:10 source;
    local old1:10 = *[x87]:10 target;
    local value0:10 = (old0 & ~mask0) | (indefinite & mask0);
    local value1:10 = (old1 & ~mask1) | (indefinite & mask1);
    *[x87]:10 source = (value1 & mask) | (old0 & ~mask);
    *[x87]:10 target = (value0 & mask) | (old1 & ~mask);
    tag0 = (tag0 * zext(!empty0)) | (2 * zext(empty0));
    tag1 = (tag1 * zext(!empty1)) | (2 * zext(empty1));
    local tags:2 = (FPUTagWord & ~((3 << shift0) | (3 << shift1))) |
                   (tag1 << shift0) | (tag0 << shift1);
    local tagmask:2 = 0 - zext(commit);
    FPUTagWord = (tags & tagmask) | (FPUTagWord & ~tagmask);
}

macro fpu_load_register(index) {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local source:2 = ((top + index) & 7) * 10;
    local next:2 = (top - 1) & 7;
    local target:2 = next * 10;
    local tag:2 = (FPUTagWord >> ((source / 10) * 2)) & 3;
    local overflow:1 = ((FPUTagWord >> (next * 2)) & 3) != 3;
    local faulted:1 = (tag == 3) || overflow;
    local commit:1 = !faulted || ((FPUControlWord & 1) != 0);
    local mask:10 = 0 - zext(commit);
    local faultmask:10 = 0 - zext(faulted);
    local indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    local value:10 = (*[x87]:10 source & ~faultmask) | (indefinite & faultmask);
    *[x87]:10 target = (value & mask) | (*[x87]:10 target & ~mask);
    tag = (tag * zext(!faulted)) | (2 * zext(faulted));
    local tags:2 = (FPUTagWord & ~(3 << (next * 2))) | (tag << (next * 2));
    local tagmask:2 = 0 - zext(commit);
    FPUTagWord = (tags & tagmask) | (FPUTagWord & ~tagmask);
    top = (top * zext(!commit)) | (next * zext(commit));
    FPUStatusWord = (FPUStatusWord & 0xc5ff) | (top << 11) |
                    (zext(faulted) * 0x41) | (zext(overflow) << 9);
    C1 = overflow;
    fpu_refresh_error_summary();
    fpu_record_opcode(0x1c0:2 | index);
}

# True when an f80 holds a denormal: a zero exponent with a non-zero
# significand. An unnormal - a non-zero exponent with the explicit integer bit
# clear - is an invalid encoding rather than a denormal, and raises IE instead.
macro fpu_is_denormal(value, result) {
    local exponent:2 = value[64,15];
    local significand:8 = value[0,64];
    result = (exponent == 0) && (significand != 0);
}

# True when an f80 holds a signalling NaN: the all-ones exponent with the
# explicit integer bit set, the quiet bit clear and a non-zero fraction. An
# all-ones exponent with the integer bit clear is a pseudo-NaN, an unsupported
# encoding rather than a signalling one.
macro fpu_is_signaling_nan(value, result) {
    result = (value[64,15] == 0x7fff) && (value[63,1] == 1) &&
             (value[62,1] == 0) && (value[0,62] != 0);
}

# True when an f80 holds an unsupported encoding: any non-zero exponent with
# the explicit integer bit clear. That covers the unnormals, pseudo-NaNs and
# pseudo-infinities, all of which raise invalid wherever a signalling NaN does.
macro fpu_is_unsupported(value, result) {
    result = (value[64,15] != 0) && (value[63,1] == 0);
}

# Raise the denormal-operand exception when `cond` holds.
macro fpu_signal_denormal_if(cond) {
    FPUStatusWord = FPUStatusWord | (zext(cond) << 1);
    fpu_refresh_error_summary();
}

# Report a denormal operand for a one- or two-source operation.
macro fpu_signal_denormal1(a) {
    local da:1; fpu_is_denormal(a, da);
    fpu_signal_denormal_if(da);
}


# `mem_de` reports a denormal single- or double-precision memory source, whose
# widened f80 is a normal number and so cannot be recognised from `b`.
macro fpu_signal_denormal2_mem(a, b, mem_de) {
    local da:1; fpu_is_denormal(a, da);
    local db:1; fpu_is_denormal(b, db);
    # Invalid takes precedence: when an operand is a NaN the operation reports
    # IE and leaves DE alone.
    local invalid:1 = nan(a) || nan(b);
    fpu_signal_denormal_if((da || db || mem_de) && !invalid);
}
macro fpu_signal_denormal2(a, b) {
    fpu_signal_denormal2_mem(a, b, 0:1);
}

# Raise the invalid-operation exception when `cond` holds, and refresh ES to
# reflect whether any unmasked exception is now pending. Branch-free so it is
# safe to expand more than once in a constructor.
macro fpu_signal_invalid_if(cond) {
    FPUStatusWord = FPUStatusWord | zext(cond);
    fpu_refresh_error_summary();
}

# The unordered compare. Only a signalling NaN raises invalid; a quiet NaN is
# merely unordered.

macro fucom_faulted_mem(val, faulted, mem_de) {
    fpu_signal_denormal2_mem(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), val, mem_de && !faulted);
    # An underflowed compare reports unordered: C0, C2 and C3 all set.
    local c2 = faulted || nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10)) || nan(val);
    local c0 = c2 | (*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f< val);
    local c3 = c2 | (*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f== val);
    fpu_set_condition_codes(c0, 0:1, c2, c3);
    local snan_a:1;
    fpu_is_signaling_nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), snan_a);
    local snan_b:1;
    fpu_is_signaling_nan(val, snan_b);
    local unsup_a:1;
    fpu_is_unsupported(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), unsup_a);
    local unsup_b:1;
    fpu_is_unsupported(val, unsup_b);
    fpu_signal_invalid_if(snan_a || snan_b || unsup_a || unsup_b);
}
macro fucom_faulted(val, faulted) {
    fucom_faulted_mem(val, faulted, 0:1);
}

# The ordered compare. It raises invalid for a quiet NaN too, which is the only
# thing separating it from FUCOM: both produce identical p-code otherwise.

macro fcom_faulted_mem(val, faulted, mem_de) {
    # An empty ST(0) is read as the indefinite QNaN, which suppresses DE.
    fpu_signal_denormal2_mem(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), val, mem_de && !faulted);
    # An underflowed compare reports unordered: C0, C2 and C3 all set.
    local c2 = faulted || nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10)) || nan(val);
    local c0 = c2 | (*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f< val);
    local c3 = c2 | (*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f== val);
    fpu_set_condition_codes(c0, 0:1, c2, c3);
    fpu_signal_invalid_if(c2);
}
macro fcom_faulted(val, faulted) {
    fcom_faulted_mem(val, faulted, 0:1);
}

# Produce the architectural full tag associated with an occupied f80 slot.
# The abridged tag transport only distinguishes occupied from empty, so saves
# must recover zero and special classes from the physical f80 encoding.
macro fpu_tag_class(value, old_tag, result) {
    local exponent:2 = value[64,15];
    local significand:8 = value[0,64];
    local integer_bit:1 = value[63,1];
    local is_zero:1 = (exponent == 0) && (significand == 0);
    local is_normal:1 = (exponent != 0) && (exponent != 0x7fff) && integer_bit;
    local occupied_class:2 = zext(is_zero) | (zext(!is_zero && !is_normal) << 1);
    local is_empty:1 = old_tag == 3;
    local is_occupied:1 = old_tag != 3;
    result = (zext(is_empty) * 3) | (zext(is_occupied) * occupied_class);
}

macro fpu_synthesized_tag(result) {
    local r0:10 = *[x87]:10 0:2;  local old0:2 = (FPUTagWord >>  0) & 3; local c0:2; fpu_tag_class(r0, old0, c0);
    local r1:10 = *[x87]:10 10:2; local old1:2 = (FPUTagWord >>  2) & 3; local c1:2; fpu_tag_class(r1, old1, c1);
    local r2:10 = *[x87]:10 20:2; local old2:2 = (FPUTagWord >>  4) & 3; local c2:2; fpu_tag_class(r2, old2, c2);
    local r3:10 = *[x87]:10 30:2; local old3:2 = (FPUTagWord >>  6) & 3; local c3:2; fpu_tag_class(r3, old3, c3);
    local r4:10 = *[x87]:10 40:2; local old4:2 = (FPUTagWord >>  8) & 3; local c4:2; fpu_tag_class(r4, old4, c4);
    local r5:10 = *[x87]:10 50:2; local old5:2 = (FPUTagWord >> 10) & 3; local c5:2; fpu_tag_class(r5, old5, c5);
    local r6:10 = *[x87]:10 60:2; local old6:2 = (FPUTagWord >> 12) & 3; local c6:2; fpu_tag_class(r6, old6, c6);
    local r7:10 = *[x87]:10 70:2; local old7:2 = (FPUTagWord >> 14) & 3; local c7:2; fpu_tag_class(r7, old7, c7);
    # Build incrementally so every shift/OR inherits the two-byte result type.
    result = c0;
    result = result | (c1 << 2);
    result = result | (c2 << 4);
    result = result | (c3 << 6);
    result = result | (c4 << 8);
    result = result | (c5 << 10);
    result = result | (c6 << 12);
    result = result | (c7 << 14);
}

macro store_synthesized_fpu_tag(Mem) {
    local full_tag:2;
    fpu_synthesized_tag(full_tag);
    *:2 (Mem + 8) = full_tag;
}

macro fpu_clear_c1() {
    FPUStatusWord = FPUStatusWord & 0xfdff;
    C1 = 0;
}


# x87 narrows an extended register when it stores to a single- or
# double-precision destination. The conversion is a generic IEEE narrowing;
# the destination format's indefinite, the C1 rounding indication, the mask
# handling and the suppression of the store are x87's.
macro fpu_narrow_store(source, size, indefinite, converted, commit) {
    local round:2 = (FPUControlWord >> 10) & 3;
    converted = float_narrow(source, size, round);
    local flags:1 = float_narrow_flags(source, size, round);
    # An unnormal is not an IEEE encoding at all; x87 rejects it as invalid.
    local unsupported:1 = (source[64,15] != 0) && (source[63,1] == 0);
    flags = flags | zext(unsupported);
    # A masked invalid conversion stores the destination's indefinite QNaN.
    # A signalling NaN is the exception: it is quieted and keeps its payload,
    # which the conversion has already produced.
    local snan:1 = (source[64,15] == 0x7fff) && (source[62,1] == 0) &&
                   (source[0,62] != 0) && !unsupported;
    local substitute:1 = ((flags & 1) != 0) && !snan;
    converted = (converted * zext(!substitute)) | (indefinite * zext(substitute));

    # Sized by copy: a macro parameter's width is not a literal here.
    local toward_zero = converted;
    toward_zero = float_narrow(source, size, 3:2);
    local inexact:1 = (flags & 0x20) != 0;
    # Compare magnitudes: shifting the sign bit out leaves the exponent and
    # significand in place, and a larger magnitude rounded away from zero.
    local rounded_up:1 = (converted << 1) > (toward_zero << 1);
    FPUStatusWord = FPUStatusWord | zext(flags);
    FPUStatusWord = (FPUStatusWord & 0xfdff) |
                    (zext(inexact && rounded_up && !substitute) << 9);

    # An unmasked invalid, overflow or underflow aborts the store and any pop:
    # unlike an arithmetic result, a narrowed one cannot be delivered at all,
    # so hardware leaves the destination and the stack untouched. Such a fault
    # also has no rounding indication and no precision report.
    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x1f;
    commit = (unmasked & 0x19) == 0;
    local clear:2 = (zext(unmasked != 0) * 0x200) |
                    (zext((unmasked & 0x18) != 0) * 0x20);
    FPUStatusWord = FPUStatusWord & ~clear;
    fpu_refresh_error_summary();
}

# FIST/FISTP/FISTTP convert ST(0) to an integer. Only invalid and precision
# are architecturally possible: the integer indefinite delivered for a masked
# invalid, C1, and the suppression of the store and the pop on an unmasked
# invalid are x87's; the conversion itself is the generic IEEE operation.
macro fpu_integer_store(source, size, indefinite, round, converted, commit) {
    converted = float_to_int(source, size, round);
    local flags:1 = float_to_int_flags(source, size, round);
    local unsupported:1 = (source[64,15] != 0) && (source[63,1] == 0);
    flags = flags | zext(unsupported);
    local invalid:1 = (flags & 1) != 0;
    converted = (converted * zext(!invalid)) | (indefinite * zext(invalid));

    # Sized by copy: a macro parameter's width is not a literal here.
    local toward_zero = converted;
    toward_zero = float_to_int(source, size, 3:2);
    local inexact:1 = (flags & 0x20) != 0;
    local negative:1 = source[79,1];
    local rounded_up:1 = (!negative && (converted s> toward_zero)) ||
                         (negative && (converted s< toward_zero));
    FPUStatusWord = FPUStatusWord | zext(flags & 0x21);
    FPUStatusWord = (FPUStatusWord & 0xfdff) |
                    (zext(inexact && rounded_up && !invalid) << 9);

    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x1f;
    commit = (unmasked & 1) == 0;
    FPUStatusWord = FPUStatusWord & ~(zext(unmasked != 0) * 0x200);
    fpu_refresh_error_summary();
}

# FBSTP packs ST(0) as eighteen decimal digits. As for the integer stores,
# only invalid and precision are architecturally possible: the conversion is
# the generic one, while the packed-decimal indefinite delivered for a masked
# invalid, C1, and the suppression of the store and the pop on an unmasked
# invalid are x87's.
macro fpu_bcd_store(source, round, converted, commit) {
    converted = to_bcd(source, round);
    local flags:1 = to_bcd_flags(source, round);
    # An unnormal is not an IEEE encoding at all; x87 rejects it as invalid.
    local unsupported:1 = (source[64,15] != 0) && (source[63,1] == 0);
    flags = flags | zext(unsupported);
    local invalid:1 = (flags & 1) != 0;
    local indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    converted = (converted * zext(!invalid)) | (indefinite * zext(invalid));

    # Packed decimal is positional, so the digits compare as magnitudes once
    # the sign bit is shifted out.
    local toward_zero:10 = to_bcd(source, 3:2);
    local inexact:1 = (flags & 0x20) != 0;
    local rounded_up:1 = (converted << 1) > (toward_zero << 1);
    FPUStatusWord = FPUStatusWord | zext(flags & 0x21);
    FPUStatusWord = (FPUStatusWord & 0xfdff) |
                    (zext(inexact && rounded_up && !invalid) << 9);

    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x1f;
    commit = (unmasked & 1) == 0;
    FPUStatusWord = FPUStatusWord & ~(zext(unmasked != 0) * 0x200);
    fpu_refresh_error_summary();
}

# A stack-underflow operand is the indefinite value, not the stale payload
# in an empty slot. Stage the conversion before committing memory or popping
# so an unmasked invalid exception leaves both destinations alone. A precision
# exception, even unmasked, still commits the rounded result and pops.
macro fpu_store_integer_st0(destination, size, indefinite_integer, round, pop, converted) {
    local faulted:1;
    fpu_stack_underflow_out(0:2, faulted);
    local mask:10 = 0 - zext(faulted);
    local indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    local value:10 = (*[x87]:10 (((FPUStatusWord >> 11) & 7) * 10) & ~mask) | (indefinite & mask);
    local store:1;
    fpu_integer_store(value, size, indefinite_integer, round, converted, store);
    if (store == 0) goto <store_done>;
    destination = converted;
    if (pop == 0) goto <store_done>;
    fpop();
<store_done>
}

# A single- or double-precision memory source is widened to the extended
# format before the operation uses it. The widened value is a normal f80 and a
# widened signalling NaN has been quieted, so the denormal-operand and
# signalling-NaN facts must be read from the original encoding.
macro fpu_f32_source_flags(bits, denormal, snan) {
    local exponent:1 = bits[23,8];
    local fraction:3 = bits[0,23];
    denormal = (exponent == 0) && (fraction != 0);
    snan = (exponent == 0xff) && (fraction != 0) && (bits[22,1] == 0);
}

macro fpu_f64_source_flags(bits, denormal, snan) {
    local exponent:2 = bits[52,11];
    local fraction:7 = bits[0,52];
    denormal = (exponent == 0) && (fraction != 0);
    snan = (exponent == 0x7ff) && (fraction != 0) && (bits[51,1] == 0);
}

# x87 rejects unnormal f80 encodings and selects NaN payloads differently from
# generic IEEE arithmetic. Keep that architecture-specific result policy here.
macro fpu_ieee_invalid_result(a, b, flags, result) {
    local unsupported_a:1 = (a[64,15] != 0) && (a[63,1] == 0);
    local unsupported_b:1 = (b[64,15] != 0) && (b[63,1] == 0);
    local unsupported:1 = unsupported_a || unsupported_b;
    flags = flags | zext(unsupported);
    local invalid:1 = (flags & 1) != 0;
    local a_nan:1 = nan(a);
    local b_nan:1 = nan(b);
    # A NaN operand is propagated, quieted, with its own sign and payload.
    # Two NaNs are resolved by the larger significand; hardware breaks a tie
    # between equal payloads in favour of the positive one.
    local a_sign:1 = a[79,1];
    local b_sign:1 = b[79,1];
    local a_significand:8 = a[0,64];
    local b_significand:8 = b[0,64];
    local a_preferred:1 = (a_significand > b_significand) ||
                          ((a_significand == b_significand) &&
                           (!a_sign || b_sign));
    local a_wins:1 = !unsupported && a_nan && (!b_nan || a_preferred);
    local b_wins:1 = !unsupported && b_nan && !a_wins;
    local indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    local selected:10 = (a * zext(a_wins)) | (b * zext(b_wins)) |
                        (indefinite * zext(!a_wins && !b_wins));
    # Quiet a selected signalling NaN without changing its sign or payload.
    selected = selected | (zext(a_wins || b_wins) << 62);
    # A quiet NaN operand raises no invalid exception, yet x87 still chooses
    # the propagated NaN by its own rule rather than the generic operation's,
    # so the substitution applies whenever any operand is a NaN.
    local substitute:1 = invalid || a_nan || b_nan;
    result = (result * zext(!substitute)) | (selected * zext(substitute));
}

# Apply the architecture-neutral IEEE facts returned by an explicit arithmetic
# p-code operation.  Their exception-bit layout deliberately matches x87's
# IE/ZE/OE/UE/PE bits; DE is determined from the source encodings here.
macro fpu_ieee_arithmetic_status(a, b, mem_de, flags, result, toward_zero, wrapped, commit) {
    # Invalid and divide-by-zero both take precedence over the denormal
    # report: a denormal dividend over a zero divisor raises ZE alone.
    local da:1; fpu_is_denormal(a, da);
    local db:1; fpu_is_denormal(b, db);
    local de_suppressed:1 = nan(a) || nan(b) || ((flags & 5) != 0);
    fpu_signal_denormal_if((da || db || mem_de) && !de_suppressed);
    FPUStatusWord = FPUStatusWord | zext(flags);

    # C1 reports that the rounded magnitude is farther from zero than the
    # toward-zero result.  It is meaningful only for an inexact operation.
    local inexact:1 = (flags & 0x20) != 0;
    local result_exponent:2 = result[64,15];
    local zero_exponent:2 = toward_zero[64,15];
    local result_significand:8 = result[0,64];
    local zero_significand:8 = toward_zero[0,64];
    local rounded_up:1 = (result_exponent > zero_exponent) ||
                          ((result_exponent == zero_exponent) &&
                           (result_significand > zero_significand));
    FPUStatusWord = (FPUStatusWord & 0xfdff) |
                    (zext(inexact && rounded_up) << 9);

    commit = (FPUStatusWord & ~FPUControlWord & 7) == 0;
    # Unmasked exceptions have no C1 rounding result. DE discards all
    # result-derived range/precision flags; unmasked OE/UE retain their range
    # bit but discard PE. IE and ZE retain PE when the operation was inexact.
    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x1f;
    # An exponent-wrapped result is a real, delivered result: its rounding
    # indication and inexactness are reported rather than discarded, so the
    # range bits are excluded from the clearing rules when `wrapped` is set.
    local range_mask:2 = 0x18 - (zext(wrapped) * 0x18);
    local clear_c1:2 = zext((unmasked & (7 | range_mask)) != 0) * 0x200;
    local unmasked_de:2 = zext((unmasked & 2) != 0);
    local unmasked_range:2 = zext((unmasked & range_mask) != 0);
    local clear:2 = clear_c1 | (unmasked_de * 0x38) | (unmasked_range * 0x20);
    FPUStatusWord = FPUStatusWord & ~clear;
    fpu_refresh_error_summary();
}

# x87 precision control (PC) narrows the significand of an extended result to
# 24 or 53 bits while keeping the extended exponent range.  The PC encoding and
# the reserved 01 value (treated as extended here) are architectural, so the
# mapping lives in the specification; the rounding itself is the generic IEEE
# operation.
macro fpu_precision_control(value, round, result, flags) {
    local pc:2 = (FPUControlWord >> 8) & 3;
    local single:1 = pc == 0;
    local double:1 = pc == 2;
    local precision:2 = 64 - (zext(single) * 40) - (zext(double) * 11);
    ieee_round_to_precision(value, precision, round, result, flags);
}

# Reading an empty register is a stack fault. It is reported before the
# operation looks at its sources, and the operation then behaves as though
# both sources were the indefinite QNaN: it raises invalid, delivers the
# indefinite, and reports nothing else.
macro fpu_ieee_fault_operands(index, a, b, source_a, source_b, faulted) {
    fpu_stack_underflow_out(index, faulted);
    local fault_mask:10 = 0 - zext(faulted);
    local indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    source_a = (a & ~fault_mask) | (indefinite & fault_mask);
    source_b = (b & ~fault_mask) | (indefinite & fault_mask);
}

# A masked stack fault leaves the destination holding the indefinite and
# reading as occupied. `dest` is the logical ST(i) written by the operation.
macro fpu_ieee_fault_deliver(faulted, dest, commit) {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local slot:2 = ((top + dest) & 7) * 10;
    local deliver:1 = faulted && commit;
    fpu_underflow_indefinite(deliver, slot);
}

# x87 delivers an exponent-wrapped result for an unmasked overflow or
# underflow: the true exponent is biased by -24576 or +24576 so a result that
# the format cannot hold is still handed to the handler, together with its
# real rounding and inexactness. Rescaling the operands by that same factor
# and repeating the operation reproduces it exactly. With no unmasked range
# exception the operands are unchanged, so one evaluation serves both cases.
macro fpu_ieee_scale_operand(value, up, down, result, scaled) {
    local word:2 = value[64,16];
    local exponent:2 = word & 0x7fff;
    local can_up:1 = up && (exponent != 0) && (exponent < 0x1fff);
    local can_down:1 = down && (exponent > 0x6000) && (exponent != 0x7fff);
    scaled = can_up || can_down;
    local scaled_word:2 = (word + (zext(can_up) * 0x6000)) -
                          (zext(can_down) * 0x6000);
    result = zext(value[0,64]) | (zext(scaled_word) << 64);
}

macro fpu_ieee_unmasked_range(flags, under, over, wrapped) {
    local unmasked:2 = zext(flags) & ~FPUControlWord;
    under = (unmasked & 0x10) != 0;
    over = (unmasked & 8) != 0;
    wrapped = under || over;
}

# For a product or a quotient the whole adjustment goes on a single operand;
# whichever has the exponent room carries it. `b_inverse` marks the operand
# that divides, whose adjustment runs the other way.
macro fpu_ieee_scale_factors(a, b, flags, b_inverse, scaled_a, scaled_b, wrapped) {
    local under:1; local over:1;
    fpu_ieee_unmasked_range(flags, under, over, wrapped);
    local a_scaled:1;
    fpu_ieee_scale_operand(a, under, over, scaled_a, a_scaled);
    local b_up:1 = !a_scaled && ((!b_inverse && under) || (b_inverse && over));
    local b_down:1 = !a_scaled && ((!b_inverse && over) || (b_inverse && under));
    local b_scaled:1;
    fpu_ieee_scale_operand(b, b_up, b_down, scaled_b, b_scaled);
}

# A sum keeps its value only if both terms move by the same factor, so both
# must have the exponent room. A zero term needs no adjustment.
macro fpu_ieee_scale_terms(a, b, flags, scaled_a, scaled_b, wrapped) {
    local under:1; local over:1;
    fpu_ieee_unmasked_range(flags, under, over, wrapped);
    local a_zero:1 = (a[64,15] == 0) && (a[0,64] == 0);
    local b_zero:1 = (b[64,15] == 0) && (b[0,64] == 0);
    local a_scaled:1; local b_scaled:1;
    local shifted_a:10; local shifted_b:10;
    fpu_ieee_scale_operand(a, under, over, shifted_a, a_scaled);
    fpu_ieee_scale_operand(b, under, over, shifted_b, b_scaled);
    local usable:1 = (a_scaled || a_zero) && (b_scaled || b_zero);
    local mask:10 = 0 - zext(usable);
    scaled_a = (shifted_a & mask) | (a & ~mask);
    scaled_b = (shifted_b & mask) | (b & ~mask);
}

macro fpu_ieee_add_result_ex(index, dest, a, b, mem_de, mem_ie, result, commit) {
    local faulted:1;
    local source_a:10;
    local source_b:10;
    fpu_ieee_fault_operands(index, a, b, source_a, source_b, faulted);
    local round:2 = (FPUControlWord >> 10) & 3;
    local flags:1;
    local unwrapped:10;
    ieee_add(source_a, source_b, round, unwrapped, flags);
    # Precision control applies before the invalid substitution; special values
    # are untouched by it, so the two are order-independent in practice.
    local precision_flags:1;
    fpu_precision_control(unwrapped, round, unwrapped, precision_flags);
    flags = flags | precision_flags;
    # A memory source narrower than the extended format carries its own
    # signalling-NaN fact: the widening quiets it before the operation sees it.
    flags = flags | zext(mem_ie);
    local scaled_a:10;
    local scaled_b:10;
    local wrapped:1;
    fpu_ieee_scale_terms(source_a, source_b, flags, scaled_a, scaled_b, wrapped);
    local scaled_flags:1;
    ieee_add(scaled_a, scaled_b, round, result, scaled_flags);
    local scaled_precision:1;
    fpu_precision_control(result, round, result, scaled_precision);
    scaled_flags = scaled_flags | scaled_precision;
    flags = (flags & ~0x20) | (scaled_flags & 0x20);
    fpu_ieee_invalid_result(source_a, source_b, flags, result);
    local toward_zero:10 = float_add(scaled_a, scaled_b, 3:2);
    # The C1 comparison must be made at the same precision as the result.
    local toward_zero_flags:1;
    fpu_precision_control(toward_zero, 3:2, toward_zero, toward_zero_flags);
    fpu_ieee_arithmetic_status(source_a, source_b, mem_de, flags, result, toward_zero, wrapped, commit);
    fpu_ieee_fault_deliver(faulted, dest, commit);
}

macro fpu_ieee_sub_result_ex(index, dest, a, b, mem_de, mem_ie, result, commit) {
    local faulted:1;
    local source_a:10;
    local source_b:10;
    fpu_ieee_fault_operands(index, a, b, source_a, source_b, faulted);
    local round:2 = (FPUControlWord >> 10) & 3;
    local flags:1;
    local unwrapped:10;
    ieee_sub(source_a, source_b, round, unwrapped, flags);
    local precision_flags:1;
    fpu_precision_control(unwrapped, round, unwrapped, precision_flags);
    flags = flags | precision_flags;
    # A memory source narrower than the extended format carries its own
    # signalling-NaN fact: the widening quiets it before the operation sees it.
    flags = flags | zext(mem_ie);
    local scaled_a:10;
    local scaled_b:10;
    local wrapped:1;
    fpu_ieee_scale_terms(source_a, source_b, flags, scaled_a, scaled_b, wrapped);
    local scaled_flags:1;
    ieee_sub(scaled_a, scaled_b, round, result, scaled_flags);
    local scaled_precision:1;
    fpu_precision_control(result, round, result, scaled_precision);
    scaled_flags = scaled_flags | scaled_precision;
    flags = (flags & ~0x20) | (scaled_flags & 0x20);
    fpu_ieee_invalid_result(source_a, source_b, flags, result);
    local toward_zero:10 = float_sub(scaled_a, scaled_b, 3:2);
    local toward_zero_flags:1;
    fpu_precision_control(toward_zero, 3:2, toward_zero, toward_zero_flags);
    fpu_ieee_arithmetic_status(source_a, source_b, mem_de, flags, result, toward_zero, wrapped, commit);
    fpu_ieee_fault_deliver(faulted, dest, commit);
}

macro fpu_ieee_mul_result_ex(index, dest, a, b, mem_de, mem_ie, result, commit) {
    local faulted:1;
    local source_a:10;
    local source_b:10;
    fpu_ieee_fault_operands(index, a, b, source_a, source_b, faulted);
    local round:2 = (FPUControlWord >> 10) & 3;
    local flags:1;
    local unwrapped:10;
    ieee_mul(source_a, source_b, round, unwrapped, flags);
    local precision_flags:1;
    fpu_precision_control(unwrapped, round, unwrapped, precision_flags);
    flags = flags | precision_flags;
    # A memory source narrower than the extended format carries its own
    # signalling-NaN fact: the widening quiets it before the operation sees it.
    flags = flags | zext(mem_ie);
    local scaled_a:10;
    local scaled_b:10;
    local wrapped:1;
    fpu_ieee_scale_factors(source_a, source_b, flags, 0:1, scaled_a, scaled_b, wrapped);
    local scaled_flags:1;
    ieee_mul(scaled_a, scaled_b, round, result, scaled_flags);
    local scaled_precision:1;
    fpu_precision_control(result, round, result, scaled_precision);
    scaled_flags = scaled_flags | scaled_precision;
    flags = (flags & ~0x20) | (scaled_flags & 0x20);
    fpu_ieee_invalid_result(source_a, source_b, flags, result);
    local toward_zero:10 = float_mul(scaled_a, scaled_b, 3:2);
    local toward_zero_flags:1;
    fpu_precision_control(toward_zero, 3:2, toward_zero, toward_zero_flags);
    fpu_ieee_arithmetic_status(source_a, source_b, mem_de, flags, result, toward_zero, wrapped, commit);
    fpu_ieee_fault_deliver(faulted, dest, commit);
}

macro fpu_ieee_div_result_ex(index, dest, a, b, mem_de, mem_ie, result, commit) {
    local faulted:1;
    local source_a:10;
    local source_b:10;
    fpu_ieee_fault_operands(index, a, b, source_a, source_b, faulted);
    local round:2 = (FPUControlWord >> 10) & 3;
    local flags:1;
    local unwrapped:10;
    ieee_div(source_a, source_b, round, unwrapped, flags);
    local precision_flags:1;
    fpu_precision_control(unwrapped, round, unwrapped, precision_flags);
    flags = flags | precision_flags;
    # A memory source narrower than the extended format carries its own
    # signalling-NaN fact: the widening quiets it before the operation sees it.
    flags = flags | zext(mem_ie);

    # The range exceptions and their masks decide whether a wrapped result is
    # delivered; the scaled evaluation then supplies the result itself and its
    # precision facts.
    local scaled_a:10;
    local scaled_b:10;
    local wrapped:1;
    fpu_ieee_scale_factors(source_a, source_b, flags, 1:1, scaled_a, scaled_b, wrapped);
    local scaled_flags:1;
    ieee_div(scaled_a, scaled_b, round, result, scaled_flags);
    local scaled_precision:1;
    fpu_precision_control(result, round, result, scaled_precision);
    scaled_flags = scaled_flags | scaled_precision;
    flags = (flags & ~0x20) | (scaled_flags & 0x20);

    fpu_ieee_invalid_result(source_a, source_b, flags, result);
    local toward_zero:10 = float_div(scaled_a, scaled_b, 3:2);
    local toward_zero_flags:1;
    fpu_precision_control(toward_zero, 3:2, toward_zero, toward_zero_flags);
    fpu_ieee_arithmetic_status(source_a, source_b, mem_de, flags, result, toward_zero, wrapped, commit);
    fpu_ieee_fault_deliver(faulted, dest, commit);
}


# The unary counterparts of the arithmetic families. `fpu_ieee_invalid_result`
# and `fpu_ieee_arithmetic_status` take the single operand twice: their NaN
# choice then resolves to that operand, and their denormal and NaN tests to
# its own class, which is exactly the one-operand rule.
macro fpu_ieee_sqrt_result(a, result, commit) {
    local faulted:1;
    local source:10;
    local unused:10;
    fpu_ieee_fault_operands(0:2, a, a, source, unused, faulted);
    local round:2 = (FPUControlWord >> 10) & 3;
    local flags:1 = float_sqrt_flags(source, round);
    result = float_sqrt(source, round);
    local precision_flags:1;
    fpu_precision_control(result, round, result, precision_flags);
    flags = flags | precision_flags;
    fpu_ieee_invalid_result(source, source, flags, result);
    local toward_zero:10 = float_sqrt(source, 3:2);
    local toward_zero_flags:1;
    fpu_precision_control(toward_zero, 3:2, toward_zero, toward_zero_flags);
    fpu_ieee_arithmetic_status(source, source, 0:1, flags, result, toward_zero, 0:1, commit);
    fpu_ieee_fault_deliver(faulted, 0:2, commit);
}

macro fpu_ieee_round_result(a, result, commit) {
    local faulted:1;
    local source:10;
    local unused:10;
    fpu_ieee_fault_operands(0:2, a, a, source, unused, faulted);
    local round:2 = (FPUControlWord >> 10) & 3;
    local flags:1 = float_round_to_integral_flags(source, round);
    result = float_round_to_integral(source, round);
    fpu_ieee_invalid_result(source, source, flags, result);
    local toward_zero:10 = float_round_to_integral(source, 3:2);
    fpu_ieee_arithmetic_status(source, source, 0:1, flags, result, toward_zero, 0:1, commit);
    fpu_ieee_fault_deliver(faulted, 0:2, commit);
}

# FSCALE scales ST(0) by the truncated integer value of ST(1). The scaling is
# IEEE scaleB; the infinite and zero combinations follow Intel's FSCALE table,
# which is architectural and lives here.
macro fpu_ieee_scale_result(a, b, result, commit) {
    local faulted:1;
    local source_a:10;
    local source_b:10;
    fpu_ieee_fault_operands(1:2, a, b, source_a, source_b, faulted);
    local round:2 = (FPUControlWord >> 10) & 3;

    local a_zero:1 = (source_a[64,15] == 0) && (source_a[0,64] == 0);
    local a_inf:1 = (source_a[64,15] == 0x7fff) && (source_a[63,1] == 1) &&
                    (source_a[0,63] == 0);
    local b_inf:1 = (source_b[64,15] == 0x7fff) && (source_b[63,1] == 1) &&
                    (source_b[0,63] == 0);
    local b_negative:1 = source_b[79,1];

    # The exponent range is far narrower than any count a 64-bit conversion
    # can lose, so an out-of-range scale saturates by its sign.
    local steps:8 = float_to_int(source_b, 8:2, 3:2);
    local steps_flags:1 = float_to_int_flags(source_b, 8:2, 3:2);
    local saturate:1 = (steps_flags & 1) != 0;
    steps = (steps * zext(!saturate)) | (0x20000 * zext(saturate && !b_negative)) |
            ((0 - 0x20000) * zext(saturate && b_negative));

    local flags:1 = float_scalb_flags(source_a, steps, round);
    result = float_scalb(source_a, steps, round);
    # scaleB has no opinion about a signalling NaN; x87 does.
    local signalling:1 = (nan(source_a) && (source_a[62,1] == 0)) ||
                         (nan(source_b) && (source_b[62,1] == 0));

    # Zero scaled by +INF, and an infinity scaled by -INF, are indeterminate.
    local indeterminate:1 = (a_zero && b_inf && !b_negative) ||
                            (a_inf && b_inf && b_negative);
    local infinite_result:1 = b_inf && !b_negative && !a_zero;
    local zero_result:1 = b_inf && b_negative && !a_inf;
    local saturated:1 = infinite_result || zero_result;
    # A saturated result is exact by definition: the range and precision facts
    # the clamped scale produced describe an operation that never happened.
    flags = flags * zext(!(saturated || indeterminate ||
                           nan(source_a) || nan(source_b)));
    flags = flags | zext(indeterminate) | zext(signalling);
    local sign:10 = zext(source_a[79,1]) << 79;
    local infinity:10 = (zext(0x7fff:2) << 64) | zext(0x8000000000000000:8);
    result = (result * zext(!saturated)) |
             ((sign | (infinity * zext(infinite_result))) * zext(saturated));

    fpu_ieee_invalid_result(source_a, source_b, flags, result);
    local toward_zero:10 = float_scalb(source_a, steps, 3:2);
    # A scaled result is delivered even when the range exception is unmasked,
    # so it keeps its rounding indication and its inexactness.
    local under:1;
    local over:1;
    local wrapped:1;
    fpu_ieee_unmasked_range(flags, under, over, wrapped);
    fpu_ieee_arithmetic_status(source_a, source_b, 0:1, flags, result, toward_zero, wrapped, commit);
    fpu_ieee_fault_deliver(faulted, 0:2, commit);
}

# A register-only form has no narrow memory source, so it reports neither a
# memory denormal nor a memory signalling NaN.
macro fpu_ieee_add_result(index, dest, a, b, result, commit) {
    fpu_ieee_add_result_ex(index, dest, a, b, 0:1, 0:1, result, commit);
}

# A register-only form has no narrow memory source, so it reports neither a
# memory denormal nor a memory signalling NaN.
macro fpu_ieee_sub_result(index, dest, a, b, result, commit) {
    fpu_ieee_sub_result_ex(index, dest, a, b, 0:1, 0:1, result, commit);
}

# A register-only form has no narrow memory source, so it reports neither a
# memory denormal nor a memory signalling NaN.
macro fpu_ieee_mul_result(index, dest, a, b, result, commit) {
    fpu_ieee_mul_result_ex(index, dest, a, b, 0:1, 0:1, result, commit);
}

# A register-only form has no narrow memory source, so it reports neither a
# memory denormal nor a memory signalling NaN.
macro fpu_ieee_div_result(index, dest, a, b, result, commit) {
    fpu_ieee_div_result_ex(index, dest, a, b, 0:1, 0:1, result, commit);
}

# Legacy generic f+ constructors still rely on QCode's contextual x87 path.
macro fpu_arithmetic_result(expression, result, commit) {
    result = expression;
    commit = (FPUStatusWord & ~FPUControlWord & 7) == 0;
    # Unmasked exceptions have no C1 rounding result. DE discards all
    # result-derived range/precision flags; unmasked OE/UE retain their range
    # bit but discard PE. IE and ZE retain PE when the operation was inexact.
    local unmasked:2 = FPUStatusWord & ~FPUControlWord & 0x1f;
    local clear_c1:2 = zext(unmasked != 0) * 0x200;
    local unmasked_de:2 = zext((unmasked & 2) != 0);
    local unmasked_range:2 = zext((unmasked & 0x18) != 0);
    local clear:2 = clear_c1 | (unmasked_de * 0x38) | (unmasked_range * 0x20);
    FPUStatusWord = FPUStatusWord & ~clear;
    fpu_refresh_error_summary();
}

# The unordered EFLAGS compare: like fcomi, but a quiet NaN is not invalid.
macro fucomi_faulted(val, faulted) {
    fpu_signal_denormal2(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), val);
    PF = faulted || nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10)) || nan(val);
	ZF = PF | ( *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f== val );
	CF = PF | ( *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f< val  );

    OF = 0;
    AF = 0;
    SF = 0;
    # Only a signalling NaN is invalid for an unordered compare. The FCOMI
    # family reports through ZF/PF/CF alone, so C0-C3 are left as they were.
    local snan_a:1;
    fpu_is_signaling_nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), snan_a);
    local snan_b:1;
    fpu_is_signaling_nan(val, snan_b);
    local unsup_a:1;
    fpu_is_unsupported(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), unsup_a);
    local unsup_b:1;
    fpu_is_unsupported(val, unsup_b);
    fpu_signal_invalid_if(snan_a || snan_b || unsup_a || unsup_b);
}

macro fcomi_faulted(val, faulted) {
    fpu_signal_denormal2(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), val);
    PF = faulted || nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10)) || nan(val);
	ZF = PF | ( *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f== val );
	CF = PF | ( *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f< val  );
 
    OF = 0;
    AF = 0;
    SF = 0;
    # The FCOMI family reports its result only through ZF/PF/CF. C0-C3 are
    # unaffected, so C1 must keep whatever the previous operation left there.
    # PF is set exactly when an operand is a NaN, which is invalid for an
    # ordered compare.
    fpu_signal_invalid_if(PF);
}

with : lockprefx=0 {

#
# floating point instructions
#
define pcodeop f2xm1;
#@family x87
# Informs the 80287 coprocessor of the switch to protected mode, treated as NOP for 80387 and later.
# We used to have a pseudo-op, but as this is a legacy instruction which is now explicitly treated
# as a NOP.  We treat it as a NOP as well.
:FSETPM 	is vexMode=0 & byte=0xdb; byte=0xe4	{ } # 80287 set protected mode

:F2XM1          is vexMode=0 & byte=0xD9; byte=0xF0 
{ 
    FPUInstructionPointer = inst_start;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = f2xm1(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
    fpu_record_opcode(0x1f0:2);
} # compute 2^x-1

:FABS           is vexMode=0 & byte=0xD9; byte=0xE1 
{ 
    FPUInstructionPointer = inst_start;
    # FABS only clears the sign bit, so it rewrites the top word and leaves
    # the significand untouched. Writing that word directly avoids a bit-range
    # assignment into 80-bit storage, which the lifter cannot mask.
    local absslotfaulted:1;
    fpu_stack_underflow_out(0:2, absslotfaulted);
    local absslot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    *[x87]:2 (absslot + 8) = *[x87]:2 (absslot + 8) & 0x7fff;
    # An underflow aborts the operation, so the indefinite result is
    # delivered after it rather than being modified by it.
    fpu_underflow_indefinite(absslotfaulted, absslot);
    # C1 is defined clear; the other condition codes are left untouched.
    FPUStatusWord = FPUStatusWord & 0xfdff;
    fpu_record_opcode(0x1e1:2);
}
    
:FADD m32fp      is vexMode=0 & byte=0xD8; reg_opcode=0 ... & m32fp & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    local arithmetic_result:10;
    local arithmetic_commit:1;
    local mem_de:1;
    local mem_snan:1;
    fpu_f32_source_flags(m32fp, mem_de, mem_snan);
    local arithmetic_rhs:10 = float2float(m32fp);
    # x87 chooses between two NaN operands by significand before quieting
    # either, so restore the signalling bit the widening cleared.
    arithmetic_rhs = arithmetic_rhs & ~(zext(mem_snan) << 62);
    fpu_ieee_add_result_ex(0:2, 0:2, *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), arithmetic_rhs, mem_de, mem_snan, arithmetic_result, arithmetic_commit);
    if (arithmetic_commit == 0) goto <arithmetic_done>;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = arithmetic_result;
<arithmetic_done>
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x000:2 | (modidx << 6) | (regidx << 3) | rmidx));
}
 
:FADD m64fp      is vexMode=0 & byte=0xDC; reg_opcode=0 ... & m64fp & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    local arithmetic_result:10;
    local arithmetic_commit:1;
    local mem_de:1;
    local mem_snan:1;
    fpu_f64_source_flags(m64fp, mem_de, mem_snan);
    local arithmetic_rhs:10 = float2float(m64fp);
    # x87 chooses between two NaN operands by significand before quieting
    # either, so restore the signalling bit the widening cleared.
    arithmetic_rhs = arithmetic_rhs & ~(zext(mem_snan) << 62);
    fpu_ieee_add_result_ex(0:2, 0:2, *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), arithmetic_rhs, mem_de, mem_snan, arithmetic_result, arithmetic_commit);
    if (arithmetic_commit == 0) goto <arithmetic_done>;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = arithmetic_result;
<arithmetic_done>
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x400:2 | (modidx << 6) | (regidx << 3) | rmidx));
} 

:FADD st0, fregop     is vexMode=0 & byte=0xD8; frow=12 & fpage=0 & fregop & st0 & fregidx
{ 
    FPUInstructionPointer = inst_start;
    # For arithmetic C1 is the rounding indicator, set by the operation when
    # an inexact result rounds away from zero. Clear it first; clearing after
    # the add would discard what the add reported.
    fpu_clear_c1();
    local arithmetic_result:10;
    local arithmetic_commit:1;
    fpu_ieee_add_result(fregidx, 0:2, *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), fregop, arithmetic_result, arithmetic_commit);
    if (arithmetic_commit == 0) goto <arithmetic_done>;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = arithmetic_result;
<arithmetic_done>
    fpu_record_opcode((0x0c0:2 | zext(fregidx)));
}
             
:FADD fregop, st0     is vexMode=0 & byte=0xDC; frow=12 & fpage=0 & fregop & st0 & fregidx
{ 
    FPUInstructionPointer = inst_start;
    local arithmetic_result:10;
    local arithmetic_commit:1;
    fpu_ieee_add_result(fregidx, fregidx, fregop, *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), arithmetic_result, arithmetic_commit);
    if (arithmetic_commit == 0) goto <arithmetic_done>;
    fregop = arithmetic_result;
<arithmetic_done>
    fpu_record_opcode((0x4c0:2 | zext(fregidx)));
}        

:FADDP              is vexMode=0 & byte=0xDE; byte=0xC1                 
{ 
    FPUInstructionPointer = inst_start;
    local arithmetic_result:10;
    local arithmetic_commit:1;
    fpu_ieee_add_result(1:2, 1:2, *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10), arithmetic_result, arithmetic_commit);
    if (arithmetic_commit == 0) goto <arithmetic_done>;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10) = arithmetic_result;
    fpop();
<arithmetic_done>
    fpu_record_opcode(0x6c1:2);
}      

:FADDP fregop, st0    is vexMode=0 & byte=0xDE; frow=12 & fpage=0 & fregop & st0 & fregidx
{ 
    FPUInstructionPointer = inst_start;
    local arithmetic_result:10;
    local arithmetic_commit:1;
    fpu_ieee_add_result(fregidx, fregidx, *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), fregop, arithmetic_result, arithmetic_commit);
    if (arithmetic_commit == 0) goto <arithmetic_done>;
    fregop = arithmetic_result;
    fpop();
<arithmetic_done>
    fpu_record_opcode((0x6c0:2 | zext(fregidx)));
}    

