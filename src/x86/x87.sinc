    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 6) & 7) * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    FPUTagWord = FPUTagWord - (old_tag << shift);
}

macro tagvalid7() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 7) & 7) * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    FPUTagWord = FPUTagWord - (old_tag << shift);
}

# Copy the complete full-tag class of ST(0) to a fixed logical destination.
# These are separate no-argument macros because raw SLEIGH fields and literal
# macro arguments leak into the flat p-code lowering as discarded expressions.
macro tagcopy0to0() {
    local top:2 = (FPUStatusWord >> 11) & 7; local source:2 = top * 2; local destination:2 = top * 2;
    local tag:2 = (FPUTagWord >> source) & 3; local old:2 = (FPUTagWord >> destination) & 3;
    FPUTagWord = (FPUTagWord - (old << destination)) | (tag << destination);
}
macro tagcopy0to1() {
    local top:2 = (FPUStatusWord >> 11) & 7; local source:2 = top * 2; local destination:2 = ((top + 1) & 7) * 2;
    local tag:2 = (FPUTagWord >> source) & 3; local old:2 = (FPUTagWord >> destination) & 3;
    FPUTagWord = (FPUTagWord - (old << destination)) | (tag << destination);
}
macro tagcopy0to2() {
    local top:2 = (FPUStatusWord >> 11) & 7; local source:2 = top * 2; local destination:2 = ((top + 2) & 7) * 2;
    local tag:2 = (FPUTagWord >> source) & 3; local old:2 = (FPUTagWord >> destination) & 3;
    FPUTagWord = (FPUTagWord - (old << destination)) | (tag << destination);
}
macro tagcopy0to3() {
    local top:2 = (FPUStatusWord >> 11) & 7; local source:2 = top * 2; local destination:2 = ((top + 3) & 7) * 2;
    local tag:2 = (FPUTagWord >> source) & 3; local old:2 = (FPUTagWord >> destination) & 3;
    FPUTagWord = (FPUTagWord - (old << destination)) | (tag << destination);
}
macro tagcopy0to4() {
    local top:2 = (FPUStatusWord >> 11) & 7; local source:2 = top * 2; local destination:2 = ((top + 4) & 7) * 2;
    local tag:2 = (FPUTagWord >> source) & 3; local old:2 = (FPUTagWord >> destination) & 3;
    FPUTagWord = (FPUTagWord - (old << destination)) | (tag << destination);
}
macro tagcopy0to5() {
    local top:2 = (FPUStatusWord >> 11) & 7; local source:2 = top * 2; local destination:2 = ((top + 5) & 7) * 2;
    local tag:2 = (FPUTagWord >> source) & 3; local old:2 = (FPUTagWord >> destination) & 3;
    FPUTagWord = (FPUTagWord - (old << destination)) | (tag << destination);
}
macro tagcopy0to6() {
    local top:2 = (FPUStatusWord >> 11) & 7; local source:2 = top * 2; local destination:2 = ((top + 6) & 7) * 2;
    local tag:2 = (FPUTagWord >> source) & 3; local old:2 = (FPUTagWord >> destination) & 3;
    FPUTagWord = (FPUTagWord - (old << destination)) | (tag << destination);
}
macro tagcopy0to7() {
    local top:2 = (FPUStatusWord >> 11) & 7; local source:2 = top * 2; local destination:2 = ((top + 7) & 7) * 2;
    local tag:2 = (FPUTagWord >> source) & 3; local old:2 = (FPUTagWord >> destination) & 3;
    FPUTagWord = (FPUTagWord - (old << destination)) | (tag << destination);
}

macro tagempty0() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 0) & 7) * 2;
    local mask:2 = 3 << shift;
    FPUTagWord = FPUTagWord | mask;
}

macro tagempty1() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 1) & 7) * 2;
    local mask:2 = 3 << shift;
    FPUTagWord = FPUTagWord | mask;
}

