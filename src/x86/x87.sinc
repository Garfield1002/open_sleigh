# The x87 floating-point unit: logical ST(i) operand subtables, the stack,
# tag and exception-delivery macros, and every x87 constructor (FXSAVE and
# FXRSTOR included). The x87 address space, the FPU registers and the MMX
# view of the same physical slots are defined in ia.sinc, which must be
# included first.

fregidx: is freg=0 { export *[const]:2 0; }
fregidx: is freg=1 { export *[const]:2 1; }
fregidx: is freg=2 { export *[const]:2 2; }
fregidx: is freg=3 { export *[const]:2 3; }
fregidx: is freg=4 { export *[const]:2 4; }
fregidx: is freg=5 { export *[const]:2 5; }
fregidx: is freg=6 { export *[const]:2 6; }
fregidx: is freg=7 { export *[const]:2 7; }

fregop: "ST0" is freg=0 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 0) & 7) * 10;
  export *[x87]:10 offset;
}
st0: "ST0" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 0) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST1" is freg=1 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 1) & 7) * 10;
  export *[x87]:10 offset;
}
st1: "ST1" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 1) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST2" is freg=2 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 2) & 7) * 10;
  export *[x87]:10 offset;
}
st2: "ST2" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 2) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST3" is freg=3 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 3) & 7) * 10;
  export *[x87]:10 offset;
}
st3: "ST3" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 3) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST4" is freg=4 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 4) & 7) * 10;
  export *[x87]:10 offset;
}
st4: "ST4" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 4) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST5" is freg=5 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 5) & 7) * 10;
  export *[x87]:10 offset;
}
st5: "ST5" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 5) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST6" is freg=6 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 6) & 7) * 10;
  export *[x87]:10 offset;
}
st6: "ST6" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 6) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST7" is freg=7 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 7) & 7) * 10;
  export *[x87]:10 offset;
}
st7: "ST7" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 7) & 7) * 10;
  export *[x87]:10 offset;
}

# `FPUStatusWord.TOP` maps logical ST(i) to a physical x87 slot. `FPUTagWord`
# is deliberately in physical-register order.
macro tagvalid0() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 0) & 7) * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    FPUTagWord = FPUTagWord - (old_tag << shift);
}

macro tagvalid1() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 1) & 7) * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    FPUTagWord = FPUTagWord - (old_tag << shift);
}

macro tagvalid2() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 2) & 7) * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    FPUTagWord = FPUTagWord - (old_tag << shift);
}

macro tagvalid3() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 3) & 7) * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    FPUTagWord = FPUTagWord - (old_tag << shift);
}

macro tagvalid4() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 4) & 7) * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    FPUTagWord = FPUTagWord - (old_tag << shift);
}

