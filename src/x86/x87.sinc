# FDIV reports a denormal operand only when the divisor does not by
# itself decide the result, so it uses the division-specific check.
macro fpu_guarded_div(dst, a, b) {
    fpu_clear_c1();
    local before:2;
    local raised:2;
    fpu_operand_check2_div(a, b, before, raised);
    if (raised != 0) goto <abort>;
    local result:10 = a f/ b;
    fpu_raised_unmasked(before, raised);
    if (raised != 0) goto <abort>;
    dst = result;
<abort>
}

macro fpu_guarded_div_pop(dst, a, b) {
    fpu_clear_c1();
    local before:2;
    local raised:2;
    fpu_operand_check2_div(a, b, before, raised);
    if (raised != 0) goto <abort>;
    local result:10 = a f/ b;
    fpu_raised_unmasked(before, raised);
    if (raised != 0) goto <abort>;
    dst = result;
    fpop();
<abort>
}

# The unordered EFLAGS compare: like fcomi, but a quiet NaN is not invalid.
macro fucomi_faulted(val, faulted) {
    fpu_signal_denormal2(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), val);
    PF = faulted || nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10)) || nan(val);
	ZF = PF | ( *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f== val );
	CF = PF | ( *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f< val  );

    OF = 0;
    AF = 0;
    SF = 0;
}

macro fcomi_faulted(val, faulted) {
    fpu_signal_denormal2(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), val);
    PF = faulted || nan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10)) || nan(val);
	ZF = PF | ( *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f== val );
	CF = PF | ( *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) f< val  );
 
    OF = 0;
    AF = 0;
    SF = 0;
    # The FCOMI family reports its result only through ZF/PF/CF. C0-C3 are
    # unaffected, so C1 must keep whatever the previous operation left there.
    # PF is set exactly when an operand is a NaN, which is invalid for an
    # ordered compare.
    fpu_signal_invalid_if(PF);
}

#
# Logical ST(i) views and the ModR/M register index
#

fregidx: is freg=0 { export *[const]:2 0; }
fregidx: is freg=1 { export *[const]:2 1; }
fregidx: is freg=2 { export *[const]:2 2; }
fregidx: is freg=3 { export *[const]:2 3; }
fregidx: is freg=4 { export *[const]:2 4; }
fregidx: is freg=5 { export *[const]:2 5; }
fregidx: is freg=6 { export *[const]:2 6; }
fregidx: is freg=7 { export *[const]:2 7; }

fregop: "ST0" is freg=0 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 0) & 7) * 10;
  export *[x87]:10 offset;
}
st0: "ST0" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 0) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST1" is freg=1 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 1) & 7) * 10;
  export *[x87]:10 offset;
}
st1: "ST1" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 1) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST2" is freg=2 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 2) & 7) * 10;
  export *[x87]:10 offset;
}
st2: "ST2" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 2) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST3" is freg=3 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 3) & 7) * 10;
  export *[x87]:10 offset;
}
st3: "ST3" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 3) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST4" is freg=4 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 4) & 7) * 10;
  export *[x87]:10 offset;
}
st4: "ST4" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 4) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST5" is freg=5 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 5) & 7) * 10;
  export *[x87]:10 offset;
}
st5: "ST5" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 5) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST6" is freg=6 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 6) & 7) * 10;
  export *[x87]:10 offset;
}
st6: "ST6" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 6) & 7) * 10;
  export *[x87]:10 offset;
}
fregop: "ST7" is freg=7 {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 7) & 7) * 10;
  export *[x87]:10 offset;
}
st7: "ST7" is epsilon {
  local top:2 = (FPUStatusWord >> 11) & 7;
  local offset:2 = ((top + 7) & 7) * 10;
  export *[x87]:10 offset;
}

#
# floating point instructions
#
define pcodeop f2xm1;
#@family x87
:F2XM1          is vexMode=0 & byte=0xD9; byte=0xF0 
{ 
    FPUInstructionPointer = inst_start;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = f2xm1(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
    fpu_record_opcode(0x1f0:2);
} # compute 2^x-1

:FABS           is vexMode=0 & byte=0xD9; byte=0xE1 
{ 
    FPUInstructionPointer = inst_start;
    # FABS only clears the sign bit, so it rewrites the top word and leaves
    # the significand untouched. Writing that word directly avoids a bit-range
    # assignment into 80-bit storage, which the lifter cannot mask.
    local absslotfaulted:1;
    fpu_stack_underflow_out(0:2, absslotfaulted);
    local absslot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    *[x87]:2 (absslot + 8) = *[x87]:2 (absslot + 8) & 0x7fff;
    # An underflow aborts the operation, so the indefinite result is
    # delivered after it rather than being modified by it.
    fpu_underflow_indefinite(absslotfaulted, absslot);
    # C1 is defined clear; the other condition codes are left untouched.
    FPUStatusWord = FPUStatusWord & 0xfdff;
    fpu_record_opcode(0x1e1:2);
}
    
:FADD m32fp      is vexMode=0 & byte=0xD8; reg_opcode=0 ... & m32fp & modidx & regidx & rmidx & Mem & st0
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = float2float(m32fp);
    fpu_guarded_add(st0, a, b);
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x000:2 | (modidx << 6) | (regidx << 3) | rmidx));
}
 
:FADD m64fp      is vexMode=0 & byte=0xDC; reg_opcode=0 ... & m64fp & modidx & regidx & rmidx & Mem & st0
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = float2float(m64fp);
    fpu_guarded_add(st0, a, b);
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x400:2 | (modidx << 6) | (regidx << 3) | rmidx));
}

:FADD st0, fregop     is vexMode=0 & byte=0xD8; frow=12 & fpage=0 & fregop & st0 & fregidx
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = fregop;
    fpu_guarded_add(st0, a, b);
    fpu_record_opcode((0x0c0:2 | zext(fregidx)));
}
             
:FADD fregop, st0     is vexMode=0 & byte=0xDC; frow=12 & fpage=0 & fregop & st0 & fregidx
{
    FPUInstructionPointer = inst_start;
    local a:10 = fregop;
    local b:10 = st0;
    fpu_guarded_add(fregop, a, b);
    fpu_record_opcode((0x4c0:2 | zext(fregidx)));
}

:FADDP              is vexMode=0 & byte=0xDE; byte=0xC1 & st0 & st1
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = st1;
    fpu_guarded_add_pop(st1, a, b);
    fpu_record_opcode(0x6c1:2);
}      

:FADDP fregop, st0    is vexMode=0 & byte=0xDE; frow=12 & fpage=0 & fregop & st0 & fregidx
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = fregop;
    fpu_guarded_add_pop(fregop, a, b);
    fpu_record_opcode((0x6c0:2 | zext(fregidx)));
}

:FIADD m32     is vexMode=0 & byte=0xDA; reg_opcode=0 ... & m32 & modidx & regidx & rmidx & Mem & st0
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = int2float(m32);
    fpu_guarded_add(st0, a, b);
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x200:2 | (modidx << 6) | (regidx << 3) | rmidx));
}

:FIADD m16     is vexMode=0 & byte=0xDE; reg_opcode=0 ... & m16 & modidx & regidx & rmidx & Mem & st0
{
    FPUInstructionPointer = inst_start;
    local a:10 = st0;
    local b:10 = int2float(m16);
    fpu_guarded_add(st0, a, b);
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x600:2 | (modidx << 6) | (regidx << 3) | rmidx));
}   

define pcodeop from_bcd;
:FBLD  m80     is vexMode=0 & byte=0xDF; reg_opcode=4 ... & m80 & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    local value:10 = from_bcd(m80);
    fpushv(value);
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x700:2 | (modidx << 6) | (regidx << 3) | rmidx));
}

define pcodeop to_bcd;
:FBSTP m80     is vexMode=0 & byte=0xDF; reg_opcode=6 ... & m80 & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    m80 = to_bcd(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
    fpop(); 
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x700:2 | (modidx << 6) | (regidx << 3) | rmidx));
}

:FCHS           is vexMode=0 & byte=0xD9; byte=0xE0                 
{ 
    FPUInstructionPointer = inst_start;
    # FCHS inverts the sign bit and leaves everything else alone.
    local chsslotfaulted:1;
    fpu_stack_underflow_out(0:2, chsslotfaulted);
    local chsslot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    *[x87]:2 (chsslot + 8) = *[x87]:2 (chsslot + 8) ^ 0x8000;
    # An underflow aborts the operation, so the indefinite result is
    # delivered after it rather than being modified by it.
    fpu_underflow_indefinite(chsslotfaulted, chsslot);
    # C1 is defined clear; the other condition codes are left untouched.
    FPUStatusWord = FPUStatusWord & 0xfdff;
    fpu_record_opcode(0x1e0:2);
}

:FCLEX          is vexMode=0 & byte=0x9B; byte=0xDB; byte=0xE2      
{ 
    FPUStatusWord[0,8] = 0; 
    FPUStatusWord[15,1] = 0; 
}

:FNCLEX         is vexMode=0 & byte=0xDB; byte=0xE2                 
{ 
    FPUStatusWord[0,8] = 0; 
    FPUStatusWord[15,1] = 0; 
} 

# FCMOV references ST(0) and ST(i) whether or not it moves, so an empty
# operand is a stack fault either way: the fault is detected before the
# condition is tested, and the indefinite it delivers overwrites whatever the
# move left behind.
:FCMOVB st0, fregop   is vexMode=0 & byte=0xDA; frow=12 & fpage=0 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local faulted:1;
    fpu_stack_underflow_out(fregidx, faulted);
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    if ( !CF ) goto <skip>;
    *[x87]:10 (slot) = fregop;
<skip>
    fpu_underflow_indefinite(faulted, slot);
    fpu_record_opcode((0x2c0:2 | zext(fregidx)));
}   

:FCMOVE st0, fregop   is vexMode=0 & byte=0xDA; frow=12 & fpage=1 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local faulted:1;
    fpu_stack_underflow_out(fregidx, faulted);
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    if ( !ZF ) goto <skip>;
    *[x87]:10 (slot) = fregop;
<skip>
    fpu_underflow_indefinite(faulted, slot);
    fpu_record_opcode((0x2c8:2 | zext(fregidx)));
}   

:FCMOVBE st0, fregop   is vexMode=0 & byte=0xDA; frow=13 & fpage=0 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local faulted:1;
    fpu_stack_underflow_out(fregidx, faulted);
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    if ( !CF & !ZF ) goto <skip>;
    *[x87]:10 (slot) = fregop;
<skip>
    fpu_underflow_indefinite(faulted, slot);
    fpu_record_opcode((0x2d0:2 | zext(fregidx)));
} 

:FCMOVU st0, fregop   is vexMode=0 & byte=0xDA; frow=13 & fpage=1 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local faulted:1;
    fpu_stack_underflow_out(fregidx, faulted);
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    if ( !PF ) goto <skip>;
    *[x87]:10 (slot) = fregop;
<skip>
    fpu_underflow_indefinite(faulted, slot);
    fpu_record_opcode((0x2d8:2 | zext(fregidx)));
}   

:FCMOVNB st0, fregop   is vexMode=0 & byte=0xDB; frow=12 & fpage=0 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local faulted:1;
    fpu_stack_underflow_out(fregidx, faulted);
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    if ( CF ) goto <skip>;
    *[x87]:10 (slot) = fregop;
<skip>
    fpu_underflow_indefinite(faulted, slot);
    fpu_record_opcode((0x3c0:2 | zext(fregidx)));
}    

:FCMOVNE st0, fregop   is vexMode=0 & byte=0xDB; frow=12 & fpage=1 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local faulted:1;
    fpu_stack_underflow_out(fregidx, faulted);
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    if ( ZF ) goto <skip>;
    *[x87]:10 (slot) = fregop;
<skip>
    fpu_underflow_indefinite(faulted, slot);
    fpu_record_opcode((0x3c8:2 | zext(fregidx)));
}    

:FCMOVNBE st0, fregop   is vexMode=0 & byte=0xDB; frow=13 & fpage=0 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local faulted:1;
    fpu_stack_underflow_out(fregidx, faulted);
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    if ( CF || ZF ) goto <skip>;
    *[x87]:10 (slot) = fregop;
<skip>
    fpu_underflow_indefinite(faulted, slot);
    fpu_record_opcode((0x3d0:2 | zext(fregidx)));
}   
:FCMOVNU st0, fregop   is vexMode=0 & byte=0xDB; frow=13 & fpage=1 & fregop & fregidx & st0
{
    FPUInstructionPointer = inst_start;
    local faulted:1;
    fpu_stack_underflow_out(fregidx, faulted);
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    if ( PF ) goto <skip>;
    *[x87]:10 (slot) = fregop;
<skip>
    fpu_underflow_indefinite(faulted, slot);
    fpu_record_opcode((0x3d8:2 | zext(fregidx)));
}    
                                                                 
:FCOM m32fp       is vexMode=0 & byte=0xD8; reg_opcode=2 ... & m32fp & modidx & regidx & rmidx & Mem
{
    FPUInstructionPointer = inst_start; 
    local tmp=float2float(m32fp); 
    local faulted:1;
    fpu_stack_underflow_out(0:2, faulted);
    fcom_faulted(tmp, faulted); 
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x000:2 | (modidx << 6) | (regidx << 3) | rmidx));
}         

:FCOM m64fp       is vexMode=0 & byte=0xDC; reg_opcode=2 ... & m64fp & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    local tmp=float2float(m64fp); 
    local faulted:1;
