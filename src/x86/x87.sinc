:FNOP           is vexMode=0 & byte=0xD9; byte=0xD0                 
{ 
    FPUInstructionPointer = inst_start;
    fpu_record_opcode(0x1d0:2);
}

define pcodeop fpatan;
:FPATAN		is vexMode=0 & byte=0xD9; byte=0xF3
{
    FPUInstructionPointer = inst_start;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10) = fpatan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10), *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
    fpop(); 
    fpu_record_opcode(0x1f3:2);
}

define pcodeop fprem;
define pcodeop fprem1;
:FPREM          is vexMode=0 & byte=0xD9; byte=0xF8                 
{ 
    FPUInstructionPointer = inst_start;
    # The remainder is exact, and its condition codes are operation
    # results: the quotient's low three bits in C0/C3/C1, and C2 for an
    # incomplete reduction. Computing it as x - trunc(x/y)*y reported
    # none of them.
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = fprem(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10));
    fpu_record_opcode(0x1f8:2);
}

:FPREM1         is vexMode=0 & byte=0xD9; byte=0xF5                 
{ 
    FPUInstructionPointer = inst_start;
    # The remainder is exact, and its condition codes are operation
    # results: the quotient's low three bits in C0/C3/C1, and C2 for an
    # incomplete reduction. Computing it as x - trunc(x/y)*y reported
    # none of them.
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = fprem1(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10));
    fpu_record_opcode(0x1f5:2);
}

define pcodeop fptan;
:FPTAN		is vexMode=0 & byte=0xD9; byte=0xF2			
{ 
    FPUInstructionPointer = inst_start;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = fptan(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
    one:4 = 1;
    tmp:10 = int2float(one);
    fpushv(tmp); 
    fpu_record_opcode(0x1f2:2);
}

:FRNDINT        is vexMode=0 & byte=0xD9; byte=0xFC                 
{
    FPUInstructionPointer = inst_start;
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    local src:10 = *[x87]:10 (slot);
    local before:2 = FPUStatusWord;
    local raised:2;
    fpu_signal_denormal1(src);
    fpu_raised_unmasked(before, raised);
    if (raised != 0) goto <abort>;
    local tmp:10 = round(src);
    fpu_raised_unmasked(before, raised);
    if (raised != 0) goto <abort>;
    *[x87]:10 (slot) = tmp;
<abort>
    fpu_record_opcode(0x1fc:2);
}

:FRSTOR Mem     is vexMode=0 & byte=0xDD; reg_opcode=4 ... & Mem
{
  FPUControlWord           = *:2  (Mem);
  FPUStatusWord            = *:2  (Mem +  4);
  FPUTagWord               = *:2  (Mem +  8);
  # The legacy image has 32-bit pointers even in long mode; do not widen the
  # memory access when assigning the x86-64 pointer registers.
  FPUDataPointer           = zext(*:4 (Mem + 20));
  FPUInstructionPointer    = zext(*:4 (Mem + 12));
  FPULastInstructionOpcode = *:2  (Mem + 18);

  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10)                      = *:10 (Mem + 28);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10)                      = *:10 (Mem + 38);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 2) & 7) * 10)                      = *:10 (Mem + 48);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 3) & 7) * 10)                      = *:10 (Mem + 58);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 4) & 7) * 10)                      = *:10 (Mem + 68);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 5) & 7) * 10)                      = *:10 (Mem + 78);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 6) & 7) * 10)                      = *:10 (Mem + 88);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 7) & 7) * 10)                      = *:10 (Mem + 98);
}

:FSAVE Mem      is vexMode=0 & byte=0x9B; byte=0xDD; reg_opcode=6 ... & Mem
{
  *:2  (Mem)      = FPUControlWord; *:2 (Mem +  2) = 0xffff;
  *:2  (Mem +  4) = FPUStatusWord;  *:2 (Mem +  6) = 0xffff;
  store_synthesized_fpu_tag(Mem);    *:2 (Mem + 10) = 0xffff;
  *:4  (Mem + 20) = FPUDataPointer;          *:2 (Mem + 24) = 0;
  *:4  (Mem + 12) = FPUInstructionPointer;    *:2 (Mem + 16) = 0;
  *:2  (Mem + 18) = FPULastInstructionOpcode; *:2 (Mem + 26) = 0xffff;

  *:10 (Mem + 28) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10);
  *:10 (Mem + 38) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10);
  *:10 (Mem + 48) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 2) & 7) * 10);
  *:10 (Mem + 58) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 3) & 7) * 10);
  *:10 (Mem + 68) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 4) & 7) * 10);
  *:10 (Mem + 78) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 5) & 7) * 10);
  *:10 (Mem + 88) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 6) & 7) * 10);
  *:10 (Mem + 98) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 7) & 7) * 10);

  FPUControlWord = 0x037f;
  FPUStatusWord = 0x0000;
  FPUTagWord = 0xffff;
  FPUDataPointer = 0x00000000;
  FPUInstructionPointer = 0x00000000;
  FPULastInstructionOpcode = 0x0000;
}

:FNSAVE Mem     is vexMode=0 & byte=0xDD; reg_opcode=6 ... & Mem
{
  *:2  (Mem)      = FPUControlWord; *:2 (Mem +  2) = 0xffff;
  *:2  (Mem +  4) = FPUStatusWord;  *:2 (Mem +  6) = 0xffff;
  store_synthesized_fpu_tag(Mem);    *:2 (Mem + 10) = 0xffff;
  *:4  (Mem + 20) = FPUDataPointer;          *:2 (Mem + 24) = 0;
  *:4  (Mem + 12) = FPUInstructionPointer;    *:2 (Mem + 16) = 0;
  *:2  (Mem + 18) = FPULastInstructionOpcode; *:2 (Mem + 26) = 0xffff;

  *:10 (Mem + 28) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10);
  *:10 (Mem + 38) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10);
  *:10 (Mem + 48) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 2) & 7) * 10);
  *:10 (Mem + 58) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 3) & 7) * 10);
  *:10 (Mem + 68) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 4) & 7) * 10);
  *:10 (Mem + 78) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 5) & 7) * 10);
  *:10 (Mem + 88) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 6) & 7) * 10);
  *:10 (Mem + 98) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 7) & 7) * 10);

  local stack_fault:1 = (FPUStatusWord & 0x40) != 0;
  local stack_fault_mask:10 = 0 - zext(stack_fault);
  local reset_indefinite:10 = zext(0xc000000000000000:8);
  reset_indefinite = reset_indefinite | (zext(0xffff:2) << 64);
  local stack_slot:2 = ((FPUStatusWord >> 11) & 7) * 10;
  local old_stack_value:10 = *[x87]:10 (stack_slot);
  *[x87]:10 (stack_slot) = (old_stack_value & ~stack_fault_mask) |
                              (reset_indefinite & stack_fault_mask);

  FPUControlWord = 0x037f;
  FPUStatusWord = 0x0000;
  FPUTagWord = 0xffff;
  FPUDataPointer = 0x00000000;
  FPUInstructionPointer = 0x00000000;
  FPULastInstructionOpcode = 0x0000;
}

define pcodeop fscale;
:FSCALE		    is vexMode=0 & byte=0xD9; byte=0xFD			
{ 
    FPUInstructionPointer = inst_start;
    # C1 is FSCALE's rounding indicator, cleared unless the result rounds
    # up. Clear it before the operation so the scale can set it.
    FPUStatusWord = FPUStatusWord & 0xfdff;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = fscale(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10));
    fpu_record_opcode(0x1fd:2);
}

define pcodeop fsin;
:FSIN		    is vexMode=0 & byte=0xD9; byte=0xFE			
{ 
    FPUInstructionPointer = inst_start;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = fsin(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
    fpu_record_opcode(0x1fe:2);
}

:FSINCOS	    is vexMode=0 & byte=0xD9; byte=0xFB			
{ 
    FPUInstructionPointer = inst_start;
    tmp:10 = fcos(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = fsin(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
    fpushv(tmp);
    fpu_record_opcode(0x1fb:2);
}

:FSQRT          is vexMode=0 & byte=0xD9; byte=0xFA                 
{
    FPUInstructionPointer = inst_start;
    # C1 is FSQRT's rounding indicator, cleared unless the result rounds
    # up. Clear it before the operation so a rounding-aware sqrt can set
    # it; the current f80 sqrt never rounds up.
    FPUStatusWord = FPUStatusWord & 0xfdff;
    local slot:2 = ((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10;
    local a:10 = *[x87]:10 (slot);
    local before:2;
    local raised:2;
    fpu_operand_check1(a, before, raised);
    if (raised != 0) goto <abort>;
    local result:10 = sqrt(a);
    fpu_raised_unmasked(before, raised);
    if (raised != 0) goto <abort>;
    *[x87]:10 (slot) = result;
<abort>
    fpu_record_opcode(0x1fa:2);
}

:FST m32fp   is vexMode=0 & byte=0xD9; (mod != 0b11 & reg_opcode=2) ... & m32fp & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    m32fp = float2float(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x100:2 | (modidx << 6) | (regidx << 3) | rmidx));
}     

:FST m64fp   is vexMode=0 & byte=0xDD; reg_opcode=2 ... & m64fp & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    m64fp = float2float(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10));
