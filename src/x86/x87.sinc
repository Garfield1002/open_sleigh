    # and an unnormal encoding delivers the indefinite.
    # An infinite dividend or a zero divisor has no remainder, and a
    # signalling NaN operand always raises invalid; a quiet NaN is merely
    # propagated.
    local dividend_nan:1 = nan(dividend);
    local divisor_nan:1 = nan(divisor);
    local signalling:1 = (dividend_nan && (dividend[62,1] == 0)) ||
                         (divisor_nan && (divisor[62,1] == 0));
    local dividend_infinite:1 = (dividend[64,15] == 0x7fff) && (dividend[63,1] == 1) &&
                                (dividend[0,63] == 0);
    local divisor_zero:1 = (divisor[64,15] == 0) && (divisor[0,64] == 0);
    local flags:1 = zext(signalling ||
                         ((dividend_infinite || divisor_zero) &&
                          !dividend_nan && !divisor_nan));
