    if (arithmetic_commit == 0) goto <arithmetic_done>;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10) = arithmetic_result;
    fpop();
<arithmetic_done>
    fpu_record_opcode(0x6e1:2);
}               

