:FBLD  m80     is vexMode=0 & byte=0xDF; reg_opcode=4 ... & m80 & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    # Packed BCD is an integer format, not a floating one: eighteen decimal
    # digits and a sign byte whose top bit applies even to zero.
    local accumulator:8 = 0;
    accumulator = (accumulator * 10) + zext(m80[68,4]);
    accumulator = (accumulator * 10) + zext(m80[64,4]);
    accumulator = (accumulator * 10) + zext(m80[60,4]);
    accumulator = (accumulator * 10) + zext(m80[56,4]);
    accumulator = (accumulator * 10) + zext(m80[52,4]);
    accumulator = (accumulator * 10) + zext(m80[48,4]);
    accumulator = (accumulator * 10) + zext(m80[44,4]);
    accumulator = (accumulator * 10) + zext(m80[40,4]);
    accumulator = (accumulator * 10) + zext(m80[36,4]);
    accumulator = (accumulator * 10) + zext(m80[32,4]);
    accumulator = (accumulator * 10) + zext(m80[28,4]);
    accumulator = (accumulator * 10) + zext(m80[24,4]);
    accumulator = (accumulator * 10) + zext(m80[20,4]);
    accumulator = (accumulator * 10) + zext(m80[16,4]);
    accumulator = (accumulator * 10) + zext(m80[12,4]);
    accumulator = (accumulator * 10) + zext(m80[8,4]);
    accumulator = (accumulator * 10) + zext(m80[4,4]);
    accumulator = (accumulator * 10) + zext(m80[0,4]);
    local magnitude:10 = int2float(accumulator);
    local value:10 = magnitude | (zext(m80[79,1]) << 79);
    fpushv(value);
    fpu_record_data_pointer(Mem);
    fpu_record_opcode((0x700:2 | (modidx << 6) | (regidx << 3) | rmidx));
}

:FBSTP m80     is vexMode=0 & byte=0xDF; reg_opcode=6 ... & m80 & modidx & regidx & rmidx & Mem
{ 
    FPUInstructionPointer = inst_start;
    fpu_clear_c1();
    local faulted:1;
    fpu_stack_underflow_out(0:2, faulted);
    local mask:10 = 0 - zext(faulted);
    local indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    local value:10 = (*[x87]:10 (((FPUStatusWord >> 11) & 7) * 10) & ~mask) | (indefinite & mask);
    local round:2 = (FPUControlWord >> 10) & 3;
    local converted:10;
    local store:1;
    fpu_bcd_store(value, round, converted, store);
    # Unlike invalid, an unmasked precision exception still stores and pops.
    if (store == 0) goto <done>;
