# FFREE marks one TOP-mapped logical x87 stack entry empty. `fregop` exports
# a dynamic x87-RAM lvalue, so the constructors retain the ModR/M low-bit
# selection and use the corresponding TOP-indexed physical full-tag pair.
# FFREE's condition codes are architecturally undefined. Choose the C1=0
# behavior observed on the hardware oracle, consistently for all ST(i).
:FFREE fregop          is vexMode=0 & byte=0xDD; frow=12 & fpage=0 & fregop & freg=0 & modidx & regidx & rmidx
{
    FPUInstructionPointer = inst_start;
    tagempty0();
    fpu_clear_c1();
    fpu_record_opcode((0x500:2 | (modidx << 6) | (regidx << 3) | rmidx));
}
