macro tagempty6() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 6) & 7) * 2;
    local mask:2 = 3 << shift;
    FPUTagWord = FPUTagWord | mask;
}

macro tagempty7() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 7) & 7) * 2;
    local mask:2 = 3 << shift;
    FPUTagWord = FPUTagWord | mask;
}

# FXCH exchanges both physical payloads and their full tag classes. The
# ModR/M-selected logical operand is specialized below, so these helpers have
# no macro arguments and expand reliably in SLEIGH.
macro tagswap1() {
    FPUStatusWord = FPUStatusWord & 0xfdff;
    local top:2 = (FPUStatusWord >> 11) & 7;
    local s0:2 = top * 2;
    local s1:2 = ((top + 1) & 7) * 2;
    local t0:2 = (FPUTagWord >> s0) & 3;
    local t1:2 = (FPUTagWord >> s1) & 3;
    FPUTagWord = FPUTagWord - (t0 << s0) - (t1 << s1);
    FPUTagWord = FPUTagWord | (t0 << s1) | (t1 << s0);
}
macro tagswap2() {
    FPUStatusWord = FPUStatusWord & 0xfdff;
    local top:2 = (FPUStatusWord >> 11) & 7;
    local s0:2 = top * 2;
    local s1:2 = ((top + 2) & 7) * 2;
    local t0:2 = (FPUTagWord >> s0) & 3;
    local t1:2 = (FPUTagWord >> s1) & 3;
    FPUTagWord = FPUTagWord - (t0 << s0) - (t1 << s1);
    FPUTagWord = FPUTagWord | (t0 << s1) | (t1 << s0);
}
macro tagswap3() {
    FPUStatusWord = FPUStatusWord & 0xfdff;
    local top:2 = (FPUStatusWord >> 11) & 7;
    local s0:2 = top * 2;
    local s1:2 = ((top + 3) & 7) * 2;
    local t0:2 = (FPUTagWord >> s0) & 3;
    local t1:2 = (FPUTagWord >> s1) & 3;
    FPUTagWord = FPUTagWord - (t0 << s0) - (t1 << s1);
    FPUTagWord = FPUTagWord | (t0 << s1) | (t1 << s0);
}
macro tagswap4() {
    FPUStatusWord = FPUStatusWord & 0xfdff;
    local top:2 = (FPUStatusWord >> 11) & 7;
    local s0:2 = top * 2;
    local s1:2 = ((top + 4) & 7) * 2;
    local t0:2 = (FPUTagWord >> s0) & 3;
    local t1:2 = (FPUTagWord >> s1) & 3;
    FPUTagWord = FPUTagWord - (t0 << s0) - (t1 << s1);
    FPUTagWord = FPUTagWord | (t0 << s1) | (t1 << s0);
}
macro tagswap5() {
    FPUStatusWord = FPUStatusWord & 0xfdff;
    local top:2 = (FPUStatusWord >> 11) & 7;
    local s0:2 = top * 2;
    local s1:2 = ((top + 5) & 7) * 2;
    local t0:2 = (FPUTagWord >> s0) & 3;
    local t1:2 = (FPUTagWord >> s1) & 3;
    FPUTagWord = FPUTagWord - (t0 << s0) - (t1 << s1);
    FPUTagWord = FPUTagWord | (t0 << s1) | (t1 << s0);
