# x86 x87 floating-point unit.
#
# Split out of ia.sinc. The x87 register file itself stays there: MMX aliases
# the same physical registers and reads FPUStatusWord/FPUTagWord directly.
# Included after ia.sinc, so the token fields and addressing subtables it
# builds on are already in scope.

#
# x87 status-word, tag-word and stack helpers
#

# `FPUStatusWord.TOP` maps logical ST(i) to a physical x87 slot. `FPUTagWord`
# is deliberately in physical-register order.
macro tagvalid0() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 0) & 7) * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    FPUTagWord = FPUTagWord - (old_tag << shift);
}

macro tagvalid1() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 1) & 7) * 2;
    local old_tag:2 = (FPUTagWord >> shift) & 3;
    FPUTagWord = FPUTagWord - (old_tag << shift);
}

macro tagvalid2() {
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = ((top + 2) & 7) * 2;
