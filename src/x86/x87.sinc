# FXSAVE carries an abridged (one-bit) tag image in physical-register order;
# keep the architectural full tag word private to the x87 model.
macro fxsave_tag(Mem) {
  local t0:1 = ((FPUTagWord >>  0) & 3) != 3;
  local t1:1 = ((FPUTagWord >>  2) & 3) != 3;
  local t2:1 = ((FPUTagWord >>  4) & 3) != 3;
  local t3:1 = ((FPUTagWord >>  6) & 3) != 3;
  local t4:1 = ((FPUTagWord >>  8) & 3) != 3;
  local t5:1 = ((FPUTagWord >> 10) & 3) != 3;
  local t6:1 = ((FPUTagWord >> 12) & 3) != 3;
  local t7:1 = ((FPUTagWord >> 14) & 3) != 3;
  *:1 (Mem + 4) = t0 | (t1 << 1) | (t2 << 2) | (t3 << 3) |
                   (t4 << 4) | (t5 << 5) | (t6 << 6) | (t7 << 7);
}

macro fxrstor_tag(Mem) {
  local tag:2 = zext(*:1 (Mem + 4));
  local e0:2 = zext((tag & 0x01) == 0) * 3;
  local e1:2 = zext((tag & 0x02) == 0) * 3;
  local e2:2 = zext((tag & 0x04) == 0) * 3;
  local e3:2 = zext((tag & 0x08) == 0) * 3;
  local e4:2 = zext((tag & 0x10) == 0) * 3;
  local e5:2 = zext((tag & 0x20) == 0) * 3;
  local e6:2 = zext((tag & 0x40) == 0) * 3;
  local e7:2 = zext((tag & 0x80) == 0) * 3;
  FPUTagWord = e0 | (e1 << 2) | (e2 << 4) | (e3 << 6) |
               (e4 << 8) | (e5 << 10) | (e6 << 12) | (e7 << 14);
}

# fxsave and fxrstor
macro _fxsave(Mem) {
  *:2  (Mem)      = FPUControlWord;
  *:2  (Mem +  2) = FPUStatusWord;
  fxsave_tag(Mem);
  # Byte 5 and each 16-byte ST/MM slot's tail are reserved. FXSAVE writes
  # them as zero rather than retaining the old memory contents.
  *:1  (Mem +  5) = 0:1;
  *:2  (Mem +  6) = FPULastInstructionOpcode;
  *:8  (Mem +  8) = FPUInstructionPointer;
  *:8  (Mem + 16) = FPUDataPointer;
  *:4  (Mem + 24) = MXCSR;
  # This model implements the architectural low sixteen MXCSR control/status
  # bits; report that supported-bit mask rather than retaining old memory.
  *:4  (Mem + 28) = 0xffff:4;

  # Save logical ST registers in 16-byte FXSAVE slots and clear their padding.
  *:10 (Mem +  32) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10);
  *:6  (Mem +  42) = 0:6;
  *:10 (Mem +  48) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10);
  *:6  (Mem +  58) = 0:6;
  *:10 (Mem +  64) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 2) & 7) * 10);
  *:6  (Mem +  74) = 0:6;
  *:10 (Mem +  80) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 3) & 7) * 10);
  *:6  (Mem +  90) = 0:6;
  *:10 (Mem +  96) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 4) & 7) * 10);
  *:6  (Mem + 106) = 0:6;
  *:10 (Mem + 112) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 5) & 7) * 10);
  *:6  (Mem + 122) = 0:6;
  *:10 (Mem + 128) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 6) & 7) * 10);
  *:6  (Mem + 138) = 0:6;
  *:10 (Mem + 144) = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 7) & 7) * 10);
  *:6  (Mem + 154) = 0:6;

  *:16 (Mem + 160) = XMM0;
  *:16 (Mem + 176) = XMM1;
  *:16 (Mem + 192) = XMM2;
  *:16 (Mem + 208) = XMM3;
  *:16 (Mem + 224) = XMM4;
  *:16 (Mem + 240) = XMM5;
  *:16 (Mem + 256) = XMM6;
  *:16 (Mem + 272) = XMM7;
@ifdef IA64
  *:16 (Mem + 288) = XMM8;
  *:16 (Mem + 304) = XMM9;
  *:16 (Mem + 320) = XMM10;
  *:16 (Mem + 336) = XMM11;
  *:16 (Mem + 352) = XMM12;
  *:16 (Mem + 368) = XMM13;
  *:16 (Mem + 384) = XMM14;
  *:16 (Mem + 400) = XMM15;
@endif
}

macro _fxrstor(Mem) {
  FPUControlWord           = *:2  (Mem);
  FPUStatusWord            = *:2  (Mem +  2);
  fxrstor_tag(Mem);
  FPULastInstructionOpcode = *:2  (Mem +  6);
  FPUInstructionPointer    = *:8  (Mem +  8);
  FPUDataPointer           = *:8  (Mem + 16);
  MXCSR                    = *:4  (Mem + 24);

  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = *:10 (Mem +  32);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10) = *:10 (Mem +  48);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 2) & 7) * 10) = *:10 (Mem +  64);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 3) & 7) * 10) = *:10 (Mem +  80);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 4) & 7) * 10) = *:10 (Mem +  96);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 5) & 7) * 10) = *:10 (Mem + 112);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 6) & 7) * 10) = *:10 (Mem + 128);
  *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 7) & 7) * 10) = *:10 (Mem + 144);

  XMM0 = *:16 (Mem + 160);
  XMM1 = *:16 (Mem + 176);
  XMM2 = *:16 (Mem + 192);
  XMM3 = *:16 (Mem + 208);
  XMM4 = *:16 (Mem + 224);
  XMM5 = *:16 (Mem + 240);
  XMM6 = *:16 (Mem + 256);
  XMM7 = *:16 (Mem + 272);
@ifdef IA64
  XMM8 = *:16 (Mem + 288);
  XMM9 = *:16 (Mem + 304);
  XMM10 = *:16 (Mem + 320);
  XMM11 = *:16 (Mem + 336);
  XMM12 = *:16 (Mem + 352);
  XMM13 = *:16 (Mem + 368);
  XMM14 = *:16 (Mem + 384);
  XMM15 = *:16 (Mem + 400);
@endif
}
@ifdef IA64
define pcodeop _fxsave64;
define pcodeop _fxrstor64;
@endif

# this saves the FPU state into 512 bytes of memory
:FXSAVE Mem    is $(LONGMODE_OFF) & vexMode=0 & byte=0x0F; byte=0xAE; ( mod != 0b11 & reg_opcode=0 ) ... & Mem
{
  _fxsave(Mem);
}

:FXRSTOR Mem   is $(LONGMODE_OFF) & vexMode=0 & byte=0x0F; byte=0xAE; ( mod != 0b11 & reg_opcode=1 ) ... & Mem
{
  _fxrstor(Mem);
}

@ifdef IA64
# this saves the FPU state into 512 bytes of memory similar to the 32-bit mode
:FXSAVE Mem    is $(LONGMODE_ON) & vexMode=0 & byte=0x0F; byte=0xAE; ( mod != 0b11 & reg_opcode=0 ) ... & Mem
{
  _fxsave(Mem);
}

:FXSAVE64 Mem    is $(LONGMODE_ON) & vexMode=0 & $(REX_W) & byte=0x0F; byte=0xAE; ( mod != 0b11 & reg_opcode=0 ) ... & Mem
{
  _fxsave(Mem);
}

:FXRSTOR Mem   is $(LONGMODE_ON) & vexMode=0 & byte=0x0F; byte=0xAE; ( mod != 0b11 & reg_opcode=1 ) ... & Mem
{
  _fxrstor(Mem);
}

:FXRSTOR64 Mem   is $(LONGMODE_ON) & vexMode=0 & $(REX_W) & byte=0x0F; byte=0xAE; ( mod != 0b11 & reg_opcode=1 ) ... & Mem
{
  _fxrstor(Mem);
}
@endif

define pcodeop extract_significand;
define pcodeop extract_exponent;
:FXTRACT        is vexMode=0 & byte=0xD9; byte=0xF4                 
{ 
    FPUInstructionPointer = inst_start;
    # A stack overflow aborts the extraction before it runs, so the
    # divide-by-zero a zero operand would raise never appears. Decide it
    # first: both the old and the new top hold the indefinite QNaN, and
    # fpushv reports IE, SF and C1.
    local top:2 = (FPUStatusWord >> 11) & 7;
    local shift:2 = (((top - 1) & 7)) * 2;
    local full:1 = ((FPUTagWord >> shift) & 3) != 3;
    if (full) goto <overflow>;
    # `extract_significand` and `extract_exponent` are the IEEE parts - a
    # logB and a scaleB in disguise. Classifying the operand is x87's: a
    # signalling NaN or an unnormal raises invalid and both results become
    # that NaN quieted or the indefinite, a zero raises divide-by-zero and a
    # denormal reports a denormal operand.
    local faulted:1;
    fpu_stack_underflow_out(0:2, faulted);
    local fault_mask:10 = 0 - zext(faulted);
    local qnan_indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    local source:10 = (*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) & ~fault_mask) | (qnan_indefinite & fault_mask);
    local significand:10 = extract_significand(source);
    local exponent:10 = extract_exponent(source);
    local unsupported:1 = (source[64,15] != 0) && (source[63,1] == 0);
    local signalling:1 = nan(source) && (source[62,1] == 0) && !unsupported;
    local is_zero:1 = (source[64,15] == 0) && (source[0,64] == 0);
    local denormal:1;
    fpu_is_denormal(source, denormal);
    fpu_signal_invalid_if(signalling || unsupported);
    fpu_signal_denormal_if(denormal);
    FPUStatusWord = FPUStatusWord | (zext(is_zero) << 2);
    fpu_refresh_error_summary();
    local indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    local quieted:10 = source | (zext(1:1) << 62);
    local replaced:10 = (quieted * zext(signalling)) | (indefinite * zext(unsupported));
    local replace:1 = signalling || unsupported;
    significand = (significand * zext(!replace)) | replaced;
    exponent = (exponent * zext(!replace)) | replaced;
    fpu_clear_c1();
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = exponent;
    fpu_underflow_indefinite(faulted, (((FPUStatusWord >> 11) & 7) * 10));
    fpushv(significand);
    goto <done>;
<overflow>
    local indefinite:10 = zext(0xc000000000000000:8);
    indefinite = indefinite | (zext(0xffff:2) << 64);
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10) = indefinite;
    fpushv(indefinite);
<done>
    fpu_record_opcode(0x1f4:2);
}

:FYL2X          is vexMode=0 & byte=0xD9; byte=0xF1                 
{ 
    FPUInstructionPointer = inst_start;
    local log_round:2 = (FPUControlWord >> 10) & 3;
    local log_flags:1 = float_log2_flags(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), log_round);
    local log2st0:10 = float_log2(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), log_round);
    # A negative operand has no logarithm: raise invalid here and hand the
    # multiplication the indefinite, which it then propagates.
    local log_invalid:1 = (log_flags & 1) != 0;
    local log_indefinite:10 = (zext(0xffff:2) << 64) | zext(0xc000000000000000:8);
    log2st0 = (log2st0 * zext(!log_invalid)) | (log_indefinite * zext(log_invalid));
    fpu_signal_invalid_if(log_invalid);
    local prior_denormal:2 = FPUStatusWord & 2;
    local arithmetic_result:10;
    local arithmetic_commit:1;
    fpu_ieee_mul_result(1:2, 1:2, *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10), log2st0, arithmetic_result, arithmetic_commit);
    # Invalid takes precedence over the logarithm's divide-by-zero: an
    # indeterminate product reports IE alone. An unmasked divide-by-zero that
    # does survive aborts the store and the pop.
    local invalid:1 = (FPUStatusWord & 1) != 0;
    # An infinite multiplier settles the result on its own, so the pole in the
    # logarithm goes unreported, just as an indeterminate product does.
    local multiplier:10 = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10);
    local multiplier_infinite:1 = (multiplier[64,15] == 0x7fff) && (multiplier[63,1] == 1) &&
                                  (multiplier[0,63] == 0);
    local zero_divide:1 = ((log_flags & 4) != 0) && !nan(arithmetic_result) &&
                          !multiplier_infinite;
    FPUStatusWord = FPUStatusWord | (zext(zero_divide) << 2);
    # A divide-by-zero decides the result on its own; the multiplication's
    # denormal operand goes unreported, exactly as for an invalid one.
    FPUStatusWord = (FPUStatusWord & ~(zext(zero_divide) * 2)) | prior_denormal;
    # A zero product is exact however inexact the logarithm was.
    local product_zero:1 = (arithmetic_result[64,15] == 0) &&
                           (arithmetic_result[0,64] == 0);
    FPUStatusWord = FPUStatusWord |
                    (zext(((log_flags & 0x20) != 0) && !product_zero) << 5);
    fpu_refresh_error_summary();
    arithmetic_commit = arithmetic_commit && !(zero_divide && ((FPUControlWord & 4) == 0));
    if (arithmetic_commit == 0) goto <arithmetic_done>;
    *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10) = arithmetic_result;
    fpop();
<arithmetic_done>
    fpu_record_opcode(0x1f1:2);
}
:FYL2XP1        is vexMode=0 & byte=0xD9; byte=0xF9                 
{ 
    FPUInstructionPointer = inst_start;
    one:4 = 1;
    tmp:10 = int2float(one);
    # The +1 is part of forming the operand, not an x87 arithmetic result:
    # take the value from the explicit IEEE operation and drop its facts.
    local incremented_flags:1;
    log2st0:10 = 0;
    local incremented:10 = 0;
    ieee_add(*[x87]:10 (((((FPUStatusWord >> 11) & 7) + 0) & 7) * 10), tmp, (FPUControlWord >> 10) & 3, incremented, incremented_flags);
