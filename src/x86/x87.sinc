    local divisor:10 = *[x87]:10 (((((FPUStatusWord >> 11) & 7) + 1) & 7) * 10);
    local result:10 = float_rem_partial(dividend, divisor, 0:1);
    local quotient:1 = float_rem_quotient(dividend, divisor, 0:1);
