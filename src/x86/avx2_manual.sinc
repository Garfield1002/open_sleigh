    local mhi:16 = vexVVVV_YmmReg_H;
    local xl:16 = XmmReg1;
    local xh:16 = YmmReg1_H;
    local rl:16 = vgatherqpd(xl, mlo);
    local rh:16 = vgatherqpd(xh, mhi);
    YmmReg1[0,64] = rl[0,64]; YmmReg1[64,64] = rl[64,64];
    YmmReg1[128,64] = rh[0,64]; YmmReg1[192,64] = rh[64,64];
    vexVVVV_YmmReg_L = 0; vexVVVV_YmmReg_H = 0;
}
@endif

