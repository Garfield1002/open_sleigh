#@family avx
# Hand-written AVX2 forms. The VSIB gathers keep an opaque user-op for the
# gathered lanes; everything else is generated into avx.sinc.

define pcodeop vgatherdpd ;
define pcodeop vgatherdps ;
define pcodeop vgatherqpd ;
define pcodeop vgatherqps ;
define pcodeop vpgatherdd ;
define pcodeop vpgatherdq ;
define pcodeop vpgatherqd ;
define pcodeop vpgatherqq ;

:VGATHERDPD XmmReg1, q_vm32x, vexVVVV_XmmReg is $(VEX_DDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W1) & vexVVVV_XmmReg; byte=0x92; (XmmReg1 & YmmReg1) ... & q_vm32x
{
    # VSIB gathers are not modelled: the result lanes come from a user-op
    # and the mask register is cleared, as the instruction does on completion.
    local x:16 = XmmReg1;
    local mk:16 = vexVVVV_XmmReg;
    local r:16 = vgatherdpd(x, mk);
    YmmReg1[0,64] = r[0,64]; YmmReg1[64,64] = r[64,64];
    avx_zero_upper(YmmReg1);
    vexVVVV_XmmReg = 0;
}

@ifdef IA64
:VGATHERQPD XmmReg1, q_vm64x, vexVVVV_XmmReg is $(LONGMODE_ON) & $(VEX_DDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W1) & vexVVVV_XmmReg; byte=0x93; (XmmReg1 & YmmReg1) ... & q_vm64x
{
    # VSIB gathers are not modelled: the result lanes come from a user-op
    # and the mask register is cleared, as the instruction does on completion.
    local x:16 = XmmReg1;
    local mk:16 = vexVVVV_XmmReg;
    local r:16 = vgatherqpd(x, mk);
    YmmReg1[0,64] = r[0,64]; YmmReg1[64,64] = r[64,64];
    avx_zero_upper(YmmReg1);
    vexVVVV_XmmReg = 0;
}
@endif

:VGATHERDPD YmmReg1, q_vm32x, vexVVVV_YmmReg is $(VEX_DDS) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W1) & vexVVVV_YmmReg & vexVVVV_YmmReg_L & vexVVVV_YmmReg_H; byte=0x92; (YmmReg1 & XmmReg1 & YmmReg1_H) ... & q_vm32x
{
    # VSIB gathers are not modelled: the result lanes come from a user-op
    # and the mask register is cleared, as the instruction does on completion.
    local mlo:16 = vexVVVV_YmmReg_L;
    local mhi:16 = vexVVVV_YmmReg_H;
    local xl:16 = XmmReg1;
    local xh:16 = YmmReg1_H;
    local rl:16 = vgatherdpd(xl, mlo);
    local rh:16 = vgatherdpd(xh, mhi);
    YmmReg1[0,64] = rl[0,64]; YmmReg1[64,64] = rl[64,64];
    YmmReg1[128,64] = rh[0,64]; YmmReg1[192,64] = rh[64,64];
    vexVVVV_YmmReg_L = 0; vexVVVV_YmmReg_H = 0;
}

@ifdef IA64
:VGATHERQPD YmmReg1, q_vm64y, vexVVVV_YmmReg is $(LONGMODE_ON) & $(VEX_DDS) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W1) & vexVVVV_YmmReg & vexVVVV_YmmReg_L & vexVVVV_YmmReg_H; byte=0x93; (YmmReg1 & XmmReg1 & YmmReg1_H) ... & q_vm64y
