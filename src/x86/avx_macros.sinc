# Sum of absolute byte differences into one qword.
macro avx_sadbw(dest, a, b) {
    local x:8 = a; local y:8 = b; local s:8 = 0;
    local gt0:1 = x[0,8] > y[0,8];
    local d0:1 = (x[0,8] - y[0,8]) * zext(gt0) + (y[0,8] - x[0,8]) * zext(!gt0);
    s = s + zext(d0);
    local gt1:1 = x[8,8] > y[8,8];
    local d1:1 = (x[8,8] - y[8,8]) * zext(gt1) + (y[8,8] - x[8,8]) * zext(!gt1);
    s = s + zext(d1);
    local gt2:1 = x[16,8] > y[16,8];
    local d2:1 = (x[16,8] - y[16,8]) * zext(gt2) + (y[16,8] - x[16,8]) * zext(!gt2);
    s = s + zext(d2);
    local gt3:1 = x[24,8] > y[24,8];
    local d3:1 = (x[24,8] - y[24,8]) * zext(gt3) + (y[24,8] - x[24,8]) * zext(!gt3);
    s = s + zext(d3);
    local gt4:1 = x[32,8] > y[32,8];
    local d4:1 = (x[32,8] - y[32,8]) * zext(gt4) + (y[32,8] - x[32,8]) * zext(!gt4);
    s = s + zext(d4);
    local gt5:1 = x[40,8] > y[40,8];
    local d5:1 = (x[40,8] - y[40,8]) * zext(gt5) + (y[40,8] - x[40,8]) * zext(!gt5);
    s = s + zext(d5);
    local gt6:1 = x[48,8] > y[48,8];
    local d6:1 = (x[48,8] - y[48,8]) * zext(gt6) + (y[48,8] - x[48,8]) * zext(!gt6);
    s = s + zext(d6);
    local gt7:1 = x[56,8] > y[56,8];
    local d7:1 = (x[56,8] - y[56,8]) * zext(gt7) + (y[56,8] - x[56,8]) * zext(!gt7);
    s = s + zext(d7);
    dest = s;
}

# Horizontal pairs within one qword: dest lanes = (a0+a1, a2+a3, ...).
macro avx_hpair_add16(dest, a) {
    local x:8 = a; local r:8;
    r[0,16] = x[0,16] + x[16,16];
    r[16,16] = x[32,16] + x[48,16];
    r[32,16] = 0;
    r[48,16] = 0;
    dest = r;
}
macro avx_hpair_add32(dest, a) {
    local x:8 = a; local r:8;
    r[0,32] = x[0,32] + x[32,32];
    r[32,32] = 0;
    dest = r;
}

# Shift every lane of a qword by one count; counts past the lane width
# clear the lane (or fill with the sign for arithmetic shifts).
macro avx_sll16(dest, a, count) {
    local x:8 = a; local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    local r:8;
    r[0,16] = x[0,16] << amount;
    r[16,16] = x[16,16] << amount;
    r[32,16] = x[32,16] << amount;
    r[48,16] = x[48,16] << amount;
    dest = r;
}
macro avx_srl16(dest, a, count) {
    local x:8 = a; local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    local r:8;
    r[0,16] = x[0,16] >> amount;
    r[16,16] = x[16,16] >> amount;
    r[32,16] = x[32,16] >> amount;
    r[48,16] = x[48,16] >> amount;
    dest = r;
}
macro avx_sra16(dest, a, count) {
    local x:8 = a; local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    local r:8;
    r[0,16] = x[0,16] s>> amount;
    r[16,16] = x[16,16] s>> amount;
    r[32,16] = x[32,16] s>> amount;
    r[48,16] = x[48,16] s>> amount;
    dest = r;
}
macro avx_sll32(dest, a, count) {
    local x:8 = a; local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    local r:8;
    r[0,32] = x[0,32] << amount;
    r[32,32] = x[32,32] << amount;
    dest = r;
}
macro avx_srl32(dest, a, count) {
    local x:8 = a; local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    local r:8;
    r[0,32] = x[0,32] >> amount;
    r[32,32] = x[32,32] >> amount;
    dest = r;
}
macro avx_sra32(dest, a, count) {
    local x:8 = a; local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    local r:8;
    r[0,32] = x[0,32] s>> amount;
    r[32,32] = x[32,32] s>> amount;
    dest = r;
}
macro avx_sll64(dest, a, count) {
    local x:8 = a; local n:8 = count;
    local over:8 = zext(n > 63);
    local amount:8 = (n & (over - 1)) | (over * 64);
    dest = x << amount;
}
macro avx_srl64(dest, a, count) {
    local x:8 = a; local n:8 = count;
    local over:8 = zext(n > 63);
    local amount:8 = (n & (over - 1)) | (over * 64);
    dest = x >> amount;
}
macro avx_sra64(dest, a, count) {
    local x:8 = a; local n:8 = count;
    local over:8 = zext(n > 63);
    local amount:8 = (n & (over - 1)) | (over * 64);
    dest = x s>> amount;
}

# Per-lane variable shifts (AVX2): each lane has its own count.
macro avx_sllv32(dest, a, b) {
    local x:8 = a; local c:8 = b; local r:8;
    local n0_:8 = zext(c[0,32]);
    local n32_:8 = zext(c[32,32]);
    local over0_:8 = zext(n0_ > 31);
    r[0,32] = x[0,32] << ((n0_ & (over0_ - 1)) | (over0_ * 32));
    local over32_:8 = zext(n32_ > 31);
    r[32,32] = x[32,32] << ((n32_ & (over32_ - 1)) | (over32_ * 32));
    dest = r;
}
macro avx_srlv32(dest, a, b) {
    local x:8 = a; local c:8 = b; local r:8;
    local n0_:8 = zext(c[0,32]);
    local n32_:8 = zext(c[32,32]);
    local over0_:8 = zext(n0_ > 31);
    r[0,32] = x[0,32] >> ((n0_ & (over0_ - 1)) | (over0_ * 32));
    local over32_:8 = zext(n32_ > 31);
    r[32,32] = x[32,32] >> ((n32_ & (over32_ - 1)) | (over32_ * 32));
    dest = r;
}
macro avx_srav32(dest, a, b) {
    local x:8 = a; local c:8 = b; local r:8;
    local n0_:8 = zext(c[0,32]);
    local n32_:8 = zext(c[32,32]);
    local over0_:8 = zext(n0_ > 31);
    r[0,32] = x[0,32] s>> ((n0_ & (over0_ - 1)) | (over0_ * 32));
    local over32_:8 = zext(n32_ > 31);
    r[32,32] = x[32,32] s>> ((n32_ & (over32_ - 1)) | (over32_ * 32));
    dest = r;
}
macro avx_sllv64(dest, a, b) {
    local x:8 = a; local c:8 = b; local r:8;
    local n0_:8 = zext(c[0,64]);
    local over0_:8 = zext(n0_ > 63);
    r[0,64] = x[0,64] << ((n0_ & (over0_ - 1)) | (over0_ * 64));
    dest = r;
}
macro avx_srlv64(dest, a, b) {
    local x:8 = a; local c:8 = b; local r:8;
    local n0_:8 = zext(c[0,64]);
    local over0_:8 = zext(n0_ > 63);
    r[0,64] = x[0,64] >> ((n0_ & (over0_ - 1)) | (over0_ * 64));
    dest = r;
}
macro avx_srav64(dest, a, b) {
    local x:8 = a; local c:8 = b; local r:8;
    local n0_:8 = zext(c[0,64]);
    local over0_:8 = zext(n0_ > 63);
    r[0,64] = x[0,64] s>> ((n0_ & (over0_ - 1)) | (over0_ * 64));
    dest = r;
}

# Interleave the low (or high) halves of two qwords: unpack.
macro avx_unpacklo8(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,8] = x[0,8];
    r[8,8] = y[0,8];
    r[16,8] = x[8,8];
    r[24,8] = y[8,8];
    r[32,8] = x[16,8];
    r[40,8] = y[16,8];
    r[48,8] = x[24,8];
    r[56,8] = y[24,8];
    dest = r;
}
macro avx_unpackhi8(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,8] = x[32,8];
    r[8,8] = y[32,8];
    r[16,8] = x[40,8];
    r[24,8] = y[40,8];
    r[32,8] = x[48,8];
    r[40,8] = y[48,8];
    r[48,8] = x[56,8];
    r[56,8] = y[56,8];
    dest = r;
}
macro avx_unpacklo16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,16] = x[0,16];
    r[16,16] = y[0,16];
    r[32,16] = x[16,16];
    r[48,16] = y[16,16];
    dest = r;
}
macro avx_unpackhi16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,16] = x[32,16];
    r[16,16] = y[32,16];
    r[32,16] = x[48,16];
    r[48,16] = y[48,16];
    dest = r;
}
macro avx_unpacklo32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,32] = x[0,32];
    r[32,32] = y[0,32];
    dest = r;
}
macro avx_unpackhi32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,32] = x[32,32];
    r[32,32] = y[32,32];
    dest = r;
}

# Saturating packs: a qword of 2w-bit lanes narrows to w-bit lanes.
macro avx_packss16(dest, a) {
    local x:8 = a; local r:4;
    local c0:2 = x[0,16];
    local h0:1 = c0 s> 127;
    local l0:1 = c0 s< -128;
    local s0:2 = (127 * zext(h0)) + (65408 * zext(l0)) + (c0 * zext(!h0 && !l0));
    r[0,8] = s0[0,8];
    local c1:2 = x[16,16];
    local h1:1 = c1 s> 127;
    local l1:1 = c1 s< -128;
    local s1:2 = (127 * zext(h1)) + (65408 * zext(l1)) + (c1 * zext(!h1 && !l1));
    r[8,8] = s1[0,8];
    local c2:2 = x[32,16];
    local h2:1 = c2 s> 127;
    local l2:1 = c2 s< -128;
    local s2:2 = (127 * zext(h2)) + (65408 * zext(l2)) + (c2 * zext(!h2 && !l2));
    r[16,8] = s2[0,8];
    local c3:2 = x[48,16];
    local h3:1 = c3 s> 127;
    local l3:1 = c3 s< -128;
    local s3:2 = (127 * zext(h3)) + (65408 * zext(l3)) + (c3 * zext(!h3 && !l3));
    r[24,8] = s3[0,8];
    dest = r;
}
macro avx_packus16(dest, a) {
    local x:8 = a; local r:4;
    local c0:2 = x[0,16];
    local h0:1 = c0 s> 255;
    local l0:1 = c0 s< 0;
    local s0:2 = (255 * zext(h0)) + (c0 * zext(!h0 && !l0));
    r[0,8] = s0[0,8];
    local c1:2 = x[16,16];
    local h1:1 = c1 s> 255;
    local l1:1 = c1 s< 0;
    local s1:2 = (255 * zext(h1)) + (c1 * zext(!h1 && !l1));
    r[8,8] = s1[0,8];
    local c2:2 = x[32,16];
    local h2:1 = c2 s> 255;
    local l2:1 = c2 s< 0;
    local s2:2 = (255 * zext(h2)) + (c2 * zext(!h2 && !l2));
    r[16,8] = s2[0,8];
    local c3:2 = x[48,16];
    local h3:1 = c3 s> 255;
    local l3:1 = c3 s< 0;
    local s3:2 = (255 * zext(h3)) + (c3 * zext(!h3 && !l3));
    r[24,8] = s3[0,8];
    dest = r;
}
macro avx_packss32(dest, a) {
    local x:8 = a; local r:4;
    local c0:4 = x[0,32];
    local h0:1 = c0 s> 32767;
    local l0:1 = c0 s< -32768;
    local s0:4 = (32767 * zext(h0)) + (4294934528 * zext(l0)) + (c0 * zext(!h0 && !l0));
    r[0,16] = s0[0,16];
    local c1:4 = x[32,32];
    local h1:1 = c1 s> 32767;
    local l1:1 = c1 s< -32768;
    local s1:4 = (32767 * zext(h1)) + (4294934528 * zext(l1)) + (c1 * zext(!h1 && !l1));
    r[16,16] = s1[0,16];
    dest = r;
}
macro avx_packus32(dest, a) {
    local x:8 = a; local r:4;
    local c0:4 = x[0,32];
    local h0:1 = c0 s> 65535;
    local l0:1 = c0 s< 0;
    local s0:4 = (65535 * zext(h0)) + (c0 * zext(!h0 && !l0));
    r[0,16] = s0[0,16];
    local c1:4 = x[32,32];
    local h1:1 = c1 s> 65535;
    local l1:1 = c1 s< 0;
    local s1:4 = (65535 * zext(h1)) + (c1 * zext(!h1 && !l1));
    r[16,16] = s1[0,16];
    dest = r;
}

# Widening moves: a half-qword of narrow lanes to a qword of wide ones.
# `signed` selects sext over zext.
macro avx_ext8to16(dest, a, signed) {
    local x:4 = a; local r:8; local s:1 = signed;
    r[0,16] = (sext(x[0,8]) * zext(s)) | (zext(x[0,8]) * zext(!s));
    r[16,16] = (sext(x[8,8]) * zext(s)) | (zext(x[8,8]) * zext(!s));
    r[32,16] = (sext(x[16,8]) * zext(s)) | (zext(x[16,8]) * zext(!s));
    r[48,16] = (sext(x[24,8]) * zext(s)) | (zext(x[24,8]) * zext(!s));
    dest = r;
}
macro avx_ext16to32(dest, a, signed) {
    local x:4 = a; local r:8; local s:1 = signed;
    r[0,32] = (sext(x[0,16]) * zext(s)) | (zext(x[0,16]) * zext(!s));
    r[32,32] = (sext(x[16,16]) * zext(s)) | (zext(x[16,16]) * zext(!s));
    dest = r;
}
macro avx_ext8to32(dest, a, signed) {
    local x:2 = a; local r:8; local s:1 = signed;
    r[0,32] = (sext(x[0,8]) * zext(s)) | (zext(x[0,8]) * zext(!s));
    r[32,32] = (sext(x[8,8]) * zext(s)) | (zext(x[8,8]) * zext(!s));
    dest = r;
}

# The eight sign bits of a qword's bytes, packed into one byte.
macro avx_bytemask(dest, a) {
    local x:8 = a;
    dest = (zext(x[7,1]) << 0) | (zext(x[15,1]) << 1) | (zext(x[23,1]) << 2) | (zext(x[31,1]) << 3) | (zext(x[39,1]) << 4) | (zext(x[47,1]) << 5) | (zext(x[55,1]) << 6) | (zext(x[63,1]) << 7);
}

# Blends: per lane, pick b where the selector bit (or the lane's sign
# bit, for the variable forms) is set, else a.
macro avx_blend16(dest, a, b, sel) {
    local x:8 = a; local y:8 = b; local s:1 = sel; local k:8;
    k[0,16] = 0 - zext(s[0,1]);
    k[16,16] = 0 - zext(s[1,1]);
    k[32,16] = 0 - zext(s[2,1]);
    k[48,16] = 0 - zext(s[3,1]);
    dest = (y & k) | (x & ~k);
}
macro avx_blend32(dest, a, b, sel) {
    local x:8 = a; local y:8 = b; local s:1 = sel; local k:8;
    k[0,32] = 0 - zext(s[0,1]);
    k[32,32] = 0 - zext(s[1,1]);
    dest = (y & k) | (x & ~k);
}
macro avx_blend64(dest, a, b, sel) {
    local x:8 = a; local y:8 = b; local s:1 = sel; local k:8;
    k[0,64] = 0 - zext(s[0,1]);
    dest = (y & k) | (x & ~k);
}
macro avx_blendv8(dest, a, b, mask) {
    local x:8 = a; local y:8 = b; local v:8 = mask; local k:8;
    k[0,8] = 0 - zext(v[0,8] s< 0);
    k[8,8] = 0 - zext(v[8,8] s< 0);
    k[16,8] = 0 - zext(v[16,8] s< 0);
    k[24,8] = 0 - zext(v[24,8] s< 0);
    k[32,8] = 0 - zext(v[32,8] s< 0);
    k[40,8] = 0 - zext(v[40,8] s< 0);
    k[48,8] = 0 - zext(v[48,8] s< 0);
    k[56,8] = 0 - zext(v[56,8] s< 0);
    dest = (y & k) | (x & ~k);
}
macro avx_blendv32(dest, a, b, mask) {
    local x:8 = a; local y:8 = b; local v:8 = mask; local k:8;
    k[0,32] = 0 - zext(v[0,32] s< 0);
    k[32,32] = 0 - zext(v[32,32] s< 0);
    dest = (y & k) | (x & ~k);
}
macro avx_blendv64(dest, a, b, mask) {
    local x:8 = a; local y:8 = b; local v:8 = mask; local k:8;
    k[0,64] = 0 - zext(v[0,64] s< 0);
    dest = (y & k) | (x & ~k);
}

# Masked loads and stores: a lane moves only when its mask sign bit is set.
macro avx_maskload32(dest, src, mask) {
    local v:8 = mask; local x:8 = src; local k:8;
    k[0,32] = 0 - zext(v[0,32] s< 0);
    k[32,32] = 0 - zext(v[32,32] s< 0);
    dest = x & k;
}
macro avx_maskstore32(dest, old, src, mask) {
    local v:8 = mask; local x:8 = src; local o:8 = old; local k:8;
    k[0,32] = 0 - zext(v[0,32] s< 0);
    k[32,32] = 0 - zext(v[32,32] s< 0);
    dest = (x & k) | (o & ~k);
}
macro avx_maskload64(dest, src, mask) {
    local v:8 = mask; local x:8 = src; local k:8;
    k[0,64] = 0 - zext(v[0,64] s< 0);
    dest = x & k;
}
macro avx_maskstore64(dest, old, src, mask) {
    local v:8 = mask; local x:8 = src; local o:8 = old; local k:8;
    k[0,64] = 0 - zext(v[0,64] s< 0);
    dest = (x & k) | (o & ~k);
}

# Duplicate the odd or even dword of each pair.
macro avx_dup_odd32(dest, a) { local x:8 = a; local r:8; r[0,32] = x[32,32]; r[32,32] = x[32,32]; dest = r; }
macro avx_dup_even32(dest, a) { local x:8 = a; local r:8; r[0,32] = x[0,32]; r[32,32] = x[0,32]; dest = r; }

# Broadcast one lane across a qword.
macro avx_bcast8(dest, a) {
    local x:1 = a; local r:8;
    r[0,8] = x;
    r[8,8] = x;
    r[16,8] = x;
    r[24,8] = x;
    r[32,8] = x;
    r[40,8] = x;
    r[48,8] = x;
    r[56,8] = x;
    dest = r;
}
macro avx_bcast16(dest, a) {
    local x:2 = a; local r:8;
    r[0,16] = x;
    r[16,16] = x;
    r[32,16] = x;
    r[48,16] = x;
    dest = r;
}
macro avx_bcast32(dest, a) {
    local x:4 = a; local r:8;
    r[0,32] = x;
    r[32,32] = x;
    dest = r;
}

# Lane selection by a 2-bit field: one dword from a 128-bit source
# (given as two qwords) or one qword from a 256-bit one (four qwords).
macro avx_sel_dword(dest, sel, s0, s1) {
    local i:8 = zext(sel) & 3;
    local lo:8 = s0; local hi:8 = s1;
    local src:8 = (lo * zext(i < 2)) | (hi * zext(i >= 2));
    local sh:8 = src >> ((i & 1) * 32);
    dest = sh[0,32];
}
macro avx_sel_qword(dest, sel, s0, s1, s2, s3) {
    local i:8 = zext(sel) & 3;
    local a:8 = s0; local b:8 = s1; local c:8 = s2; local d:8 = s3;
    dest = (a * zext(i == 0)) | (b * zext(i == 1)) | (c * zext(i == 2)) | (d * zext(i == 3));
}

# Shuffle the four words of a qword by a byte of 2-bit selectors.
macro avx_shufw(dest, a, sel) {
    local x:8 = a; local s:8 = zext(sel); local r:8;
    local w0:8 = x >> ((s & 3) * 16);
    local w1:8 = x >> (((s >> 2) & 3) * 16);
    local w2:8 = x >> (((s >> 4) & 3) * 16);
    local w3:8 = x >> (((s >> 6) & 3) * 16);
    r[0,16] = w0[0,16]; r[16,16] = w1[0,16]; r[32,16] = w2[0,16]; r[48,16] = w3[0,16];
    dest = r;
}

# Byte shuffle: each destination byte picks a byte of the 16-byte source by
# the low nibble of the selector, or zero when the selector's bit 7 is set.
macro avx_shufb(dest, s0, s1, sel) {
    local lo:8 = s0; local hi:8 = s1; local m:8 = sel; local r:8;
    local i0:8 = zext(m[0,4]);
    local src0:8 = (lo * zext(i0 < 8)) | (hi * zext(i0 >= 8));
    local b0:8 = src0 >> ((i0 & 7) * 8);
    r[0,8] = b0[0,8] * zext(!m[7,1]);
    local i1:8 = zext(m[8,4]);
    local src1:8 = (lo * zext(i1 < 8)) | (hi * zext(i1 >= 8));
    local b1:8 = src1 >> ((i1 & 7) * 8);
    r[8,8] = b1[0,8] * zext(!m[15,1]);
    local i2:8 = zext(m[16,4]);
    local src2:8 = (lo * zext(i2 < 8)) | (hi * zext(i2 >= 8));
    local b2:8 = src2 >> ((i2 & 7) * 8);
    r[16,8] = b2[0,8] * zext(!m[23,1]);
    local i3:8 = zext(m[24,4]);
    local src3:8 = (lo * zext(i3 < 8)) | (hi * zext(i3 >= 8));
    local b3:8 = src3 >> ((i3 & 7) * 8);
    r[24,8] = b3[0,8] * zext(!m[31,1]);
    local i4:8 = zext(m[32,4]);
    local src4:8 = (lo * zext(i4 < 8)) | (hi * zext(i4 >= 8));
    local b4:8 = src4 >> ((i4 & 7) * 8);
    r[32,8] = b4[0,8] * zext(!m[39,1]);
    local i5:8 = zext(m[40,4]);
    local src5:8 = (lo * zext(i5 < 8)) | (hi * zext(i5 >= 8));
    local b5:8 = src5 >> ((i5 & 7) * 8);
    r[40,8] = b5[0,8] * zext(!m[47,1]);
    local i6:8 = zext(m[48,4]);
    local src6:8 = (lo * zext(i6 < 8)) | (hi * zext(i6 >= 8));
    local b6:8 = src6 >> ((i6 & 7) * 8);
    r[48,8] = b6[0,8] * zext(!m[55,1]);
    local i7:8 = zext(m[56,4]);
    local src7:8 = (lo * zext(i7 < 8)) | (hi * zext(i7 >= 8));
    local b7:8 = src7 >> ((i7 & 7) * 8);
    r[56,8] = b7[0,8] * zext(!m[63,1]);
    dest = r;
}

# One qword of a 32-byte concatenation (hi:lo) shifted right by n bytes:
# the PALIGNR building block. `q0..q3` are the four qwords low to high.
macro avx_byteshift_q(dest, n, q0, q1, q2, q3) {
    local sh:8 = n;
    local a:8 = q0; local b:8 = q1; local c:8 = q2; local d:8 = q3;
    local qi:8 = sh >> 3;
    local bi:8 = (sh & 7) * 8;
    local lo:8 = (a * zext(qi == 0)) | (b * zext(qi == 1)) | (c * zext(qi == 2)) | (d * zext(qi == 3));
    local hi:8 = (b * zext(qi == 0)) | (c * zext(qi == 1)) | (d * zext(qi == 2));
    local up:8 = (hi << (64 - bi)) * zext(bi != 0);
    dest = ((lo >> bi) | up) * zext(sh < 32);
}

# Saturating horizontal pairs and the unsigned-byte times signed-byte
# multiply-add, through the SSE user-ops on a qword.
macro avx_hadds16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8; local wide:4; local lane:2;
    wide = sext(x[0,16]) + sext(x[16,16]);
    ssdsw(wide, lane);
    r[0,16] = lane;
    wide = sext(x[32,16]) + sext(x[48,16]);
    ssdsw(wide, lane);
    r[16,16] = lane;
    wide = sext(y[0,16]) + sext(y[16,16]);
    ssdsw(wide, lane);
    r[32,16] = lane;
    wide = sext(y[32,16]) + sext(y[48,16]);
    ssdsw(wide, lane);
    r[48,16] = lane;
    dest = r;
}
macro avx_hsubs16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8; local wide:4; local lane:2;
    wide = sext(x[0,16]) - sext(x[16,16]);
    ssdsw(wide, lane);
    r[0,16] = lane;
    wide = sext(x[32,16]) - sext(x[48,16]);
    ssdsw(wide, lane);
    r[16,16] = lane;
    wide = sext(y[0,16]) - sext(y[16,16]);
    ssdsw(wide, lane);
    r[32,16] = lane;
    wide = sext(y[32,16]) - sext(y[48,16]);
    ssdsw(wide, lane);
    r[48,16] = lane;
    dest = r;
}
macro avx_maddubs(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8; local sum:4; local lane:2;
    sum = zext(x[0,8]) * sext(y[0,8]) + zext(x[8,8]) * sext(y[8,8]);
    ssdsw(sum, lane);
    r[0,16] = lane;
    sum = zext(x[16,8]) * sext(y[16,8]) + zext(x[24,8]) * sext(y[24,8]);
    ssdsw(sum, lane);
    r[16,16] = lane;
    sum = zext(x[32,8]) * sext(y[32,8]) + zext(x[40,8]) * sext(y[40,8]);
    ssdsw(sum, lane);
    r[32,16] = lane;
    sum = zext(x[48,8]) * sext(y[48,8]) + zext(x[56,8]) * sext(y[56,8]);
    ssdsw(sum, lane);
    r[48,16] = lane;
    dest = r;
}
macro avx_hsub16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,16] = x[0,16] - x[16,16];
    r[16,16] = x[32,16] - x[48,16];
    r[32,16] = y[0,16] - y[16,16];
    r[48,16] = y[32,16] - y[48,16];
    dest = r;
}
macro avx_hsub32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,32] = x[0,32] - x[32,32];
    r[32,32] = y[0,32] - y[32,32];
    dest = r;
}

# VPERMD: each dword of the destination qword picks any of the eight
# source dwords by the low 3 bits of its index dword.
macro avx_permd(dest, idx, s0, s1, s2, s3) {
    local ix:8 = idx; local r:8;
    local i0:8 = zext(ix[0,3]); local i1:8 = zext(ix[32,3]);
    local a:8 = s0; local b:8 = s1; local c:8 = s2; local d:8 = s3;
    local q0:8 = (a * zext(i0 < 2)) | (b * zext((i0 >= 2) && (i0 < 4))) | (c * zext((i0 >= 4) && (i0 < 6))) | (d * zext(i0 >= 6));
    local q1:8 = (a * zext(i1 < 2)) | (b * zext((i1 >= 2) && (i1 < 4))) | (c * zext((i1 >= 4) && (i1 < 6))) | (d * zext(i1 >= 6));
    local v0:8 = q0 >> ((i0 & 1) * 32);
    local v1:8 = q1 >> ((i1 & 1) * 32);
    r[0,32] = v0[0,32]; r[32,32] = v1[0,32];
    dest = r;
}

# Insert one lane at index i (relative to this qword; out of range leaves
# the qword unchanged) and extract one lane from a 16-byte value.
macro avx_insert8(dest, a, val, i) {
    local x:8 = a; local v:1 = val; local ix:8 = i; local r:8;
    r[0,8] = (v * zext(ix == 0)) | (x[0,8] * zext(ix != 0));
    r[8,8] = (v * zext(ix == 1)) | (x[8,8] * zext(ix != 1));
    r[16,8] = (v * zext(ix == 2)) | (x[16,8] * zext(ix != 2));
    r[24,8] = (v * zext(ix == 3)) | (x[24,8] * zext(ix != 3));
    r[32,8] = (v * zext(ix == 4)) | (x[32,8] * zext(ix != 4));
    r[40,8] = (v * zext(ix == 5)) | (x[40,8] * zext(ix != 5));
    r[48,8] = (v * zext(ix == 6)) | (x[48,8] * zext(ix != 6));
    r[56,8] = (v * zext(ix == 7)) | (x[56,8] * zext(ix != 7));
    dest = r;
}
macro avx_insert16(dest, a, val, i) {
    local x:8 = a; local v:2 = val; local ix:8 = i; local r:8;
    r[0,16] = (v * zext(ix == 0)) | (x[0,16] * zext(ix != 0));
    r[16,16] = (v * zext(ix == 1)) | (x[16,16] * zext(ix != 1));
    r[32,16] = (v * zext(ix == 2)) | (x[32,16] * zext(ix != 2));
    r[48,16] = (v * zext(ix == 3)) | (x[48,16] * zext(ix != 3));
    dest = r;
}
macro avx_insert32(dest, a, val, i) {
    local x:8 = a; local v:4 = val; local ix:8 = i; local r:8;
    r[0,32] = (v * zext(ix == 0)) | (x[0,32] * zext(ix != 0));
    r[32,32] = (v * zext(ix == 1)) | (x[32,32] * zext(ix != 1));
    dest = r;
}
macro avx_extract8(dest, s0, s1, i) {
    local ix:8 = zext(i) & 15;
    local lo:8 = s0; local hi:8 = s1;
    local src:8 = (lo * zext(ix < 8)) | (hi * zext(ix >= 8));
    local sh:8 = src >> ((ix & 7) * 8);
    dest = sh[0,8];
}
macro avx_extract16(dest, s0, s1, i) {
    local ix:8 = zext(i) & 7;
    local lo:8 = s0; local hi:8 = s1;
    local src:8 = (lo * zext(ix < 4)) | (hi * zext(ix >= 4));
    local sh:8 = src >> ((ix & 3) * 16);
    dest = sh[0,16];
}

# IEEE lanes, through the MXCSR-aware SSE scalar macros.
macro avx_fadd32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_add32(r[0,32], x[0,32], y[0,32]);
    sse_add32(r[32,32], x[32,32], y[32,32]);
    dest = r;
}
macro avx_fsub32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_sub32(r[0,32], x[0,32], y[0,32]);
    sse_sub32(r[32,32], x[32,32], y[32,32]);
    dest = r;
}
macro avx_fmul32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_mul32(r[0,32], x[0,32], y[0,32]);
    sse_mul32(r[32,32], x[32,32], y[32,32]);
    dest = r;
}
macro avx_fdiv32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_div32(r[0,32], x[0,32], y[0,32]);
    sse_div32(r[32,32], x[32,32], y[32,32]);
    dest = r;
}
macro avx_fmin32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_min32(r[0,32], x[0,32], y[0,32]);
    sse_min32(r[32,32], x[32,32], y[32,32]);
    dest = r;
}
macro avx_fmax32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_max32(r[0,32], x[0,32], y[0,32]);
    sse_max32(r[32,32], x[32,32], y[32,32]);
    dest = r;
}
macro avx_fsqrt32(dest, a) {
    local x:8 = a; local r:8;
    sse_sqrt32(r[0,32], x[0,32]);
    sse_sqrt32(r[32,32], x[32,32]);
    dest = r;
}
macro avx_fadd64(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_add64(r[0,64], x[0,64], y[0,64]);
    dest = r;
}
macro avx_fsub64(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_sub64(r[0,64], x[0,64], y[0,64]);
    dest = r;
}
macro avx_fmul64(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_mul64(r[0,64], x[0,64], y[0,64]);
    dest = r;
}
macro avx_fdiv64(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_div64(r[0,64], x[0,64], y[0,64]);
    dest = r;
}
macro avx_fmin64(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_min64(r[0,64], x[0,64], y[0,64]);
    dest = r;
}
macro avx_fmax64(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    sse_max64(r[0,64], x[0,64], y[0,64]);
    dest = r;
}
macro avx_fsqrt64(dest, a) {
    local x:8 = a; local r:8;
    sse_sqrt64(r[0,64], x[0,64]);
    dest = r;
}
