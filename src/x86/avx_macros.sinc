# Unsigned 32x32->64 and signed 32x32->64 products of the even lanes.
macro avx_muludq(dest, a, b) { local x:8 = a; local y:8 = b; dest = zext(x[0,32]) * zext(y[0,32]); }
macro avx_muldq(dest, a, b) { local x:8 = a; local y:8 = b; dest = sext(x[0,32]) * sext(y[0,32]); }

# Rounded, scaled signed 16-bit product: (a*b + 0x4000) >> 15.
macro avx_mulhrs16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    local p0:4 = ((sext(x[0,16]) * sext(y[0,16])) + 0x4000) s>> 15;
    r[0,16] = p0[0,16];
    local p1:4 = ((sext(x[16,16]) * sext(y[16,16])) + 0x4000) s>> 15;
    r[16,16] = p1[0,16];
    local p2:4 = ((sext(x[32,16]) * sext(y[32,16])) + 0x4000) s>> 15;
    r[32,16] = p2[0,16];
    local p3:4 = ((sext(x[48,16]) * sext(y[48,16])) + 0x4000) s>> 15;
    r[48,16] = p3[0,16];
    dest = r;
}

# Absolute value and sign transfer.
macro avx_abs8(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,8] = (x[0,8] ^ (x[0,8] s>> 7)) - (x[0,8] s>> 7);
    r[8,8] = (x[8,8] ^ (x[8,8] s>> 7)) - (x[8,8] s>> 7);
    r[16,8] = (x[16,8] ^ (x[16,8] s>> 7)) - (x[16,8] s>> 7);
    r[24,8] = (x[24,8] ^ (x[24,8] s>> 7)) - (x[24,8] s>> 7);
    r[32,8] = (x[32,8] ^ (x[32,8] s>> 7)) - (x[32,8] s>> 7);
    r[40,8] = (x[40,8] ^ (x[40,8] s>> 7)) - (x[40,8] s>> 7);
    r[48,8] = (x[48,8] ^ (x[48,8] s>> 7)) - (x[48,8] s>> 7);
    r[56,8] = (x[56,8] ^ (x[56,8] s>> 7)) - (x[56,8] s>> 7);
    dest = r;
}
macro avx_sign8(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,8] = ((x[0,8] ^ (y[0,8] s>> 7)) - (y[0,8] s>> 7)) * zext(y[0,8] != 0);
    r[8,8] = ((x[8,8] ^ (y[8,8] s>> 7)) - (y[8,8] s>> 7)) * zext(y[8,8] != 0);
    r[16,8] = ((x[16,8] ^ (y[16,8] s>> 7)) - (y[16,8] s>> 7)) * zext(y[16,8] != 0);
    r[24,8] = ((x[24,8] ^ (y[24,8] s>> 7)) - (y[24,8] s>> 7)) * zext(y[24,8] != 0);
    r[32,8] = ((x[32,8] ^ (y[32,8] s>> 7)) - (y[32,8] s>> 7)) * zext(y[32,8] != 0);
    r[40,8] = ((x[40,8] ^ (y[40,8] s>> 7)) - (y[40,8] s>> 7)) * zext(y[40,8] != 0);
    r[48,8] = ((x[48,8] ^ (y[48,8] s>> 7)) - (y[48,8] s>> 7)) * zext(y[48,8] != 0);
    r[56,8] = ((x[56,8] ^ (y[56,8] s>> 7)) - (y[56,8] s>> 7)) * zext(y[56,8] != 0);
    dest = r;
}
macro avx_abs16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,16] = (x[0,16] ^ (x[0,16] s>> 15)) - (x[0,16] s>> 15);
    r[16,16] = (x[16,16] ^ (x[16,16] s>> 15)) - (x[16,16] s>> 15);
    r[32,16] = (x[32,16] ^ (x[32,16] s>> 15)) - (x[32,16] s>> 15);
    r[48,16] = (x[48,16] ^ (x[48,16] s>> 15)) - (x[48,16] s>> 15);
    dest = r;
}
macro avx_sign16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,16] = ((x[0,16] ^ (y[0,16] s>> 15)) - (y[0,16] s>> 15)) * zext(y[0,16] != 0);
    r[16,16] = ((x[16,16] ^ (y[16,16] s>> 15)) - (y[16,16] s>> 15)) * zext(y[16,16] != 0);
    r[32,16] = ((x[32,16] ^ (y[32,16] s>> 15)) - (y[32,16] s>> 15)) * zext(y[32,16] != 0);
    r[48,16] = ((x[48,16] ^ (y[48,16] s>> 15)) - (y[48,16] s>> 15)) * zext(y[48,16] != 0);
    dest = r;
}
macro avx_abs32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,32] = (x[0,32] ^ (x[0,32] s>> 31)) - (x[0,32] s>> 31);
    r[32,32] = (x[32,32] ^ (x[32,32] s>> 31)) - (x[32,32] s>> 31);
    dest = r;
}
macro avx_sign32(dest, a, b) {
