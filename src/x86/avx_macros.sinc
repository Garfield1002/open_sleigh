# The AVX lane library. Generated by scripts/avx_gen.py; do not edit.
#
# Every VEX-encoded constructor is written in terms of 64-bit lanes: an
# XMM operand is two qwords, a YMM operand is four, and no temporary is
# ever wider than the 16 bytes a memory source is loaded as. That keeps
# the lifted code inside the emulator's native width while still
# expressing the full 256-bit semantics.
#
# avx_<op><w>(dest, a, b) maps one qword of packed <w>-bit lanes.
# avx_zero_upper(reg) clears bits 128-255 of a YMM after a VEX.128 form
# wrote its low half. The ZMM upper 256 bits are architecturally zeroed
# by every VEX instruction too; they are left untouched because no VEX
# form can observe them and the register file names lanes only up to the
# YMM width.

macro avx_zero_upper(reg) {
    reg[128,64] = 0:8;
    reg[192,64] = 0:8;
}

# Bitwise, width-agnostic.
macro avx_and(dest, a, b)  { dest = a & b; }
macro avx_andn(dest, a, b) { dest = ~a & b; }
macro avx_or(dest, a, b)   { dest = a | b; }
macro avx_xor(dest, a, b)  { dest = a ^ b; }

# Wrapping integer add and subtract.
macro avx_add8(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,8] = x[0,8] + y[0,8];
    r[8,8] = x[8,8] + y[8,8];
    r[16,8] = x[16,8] + y[16,8];
    r[24,8] = x[24,8] + y[24,8];
    r[32,8] = x[32,8] + y[32,8];
    r[40,8] = x[40,8] + y[40,8];
    r[48,8] = x[48,8] + y[48,8];
    r[56,8] = x[56,8] + y[56,8];
    dest = r;
}
macro avx_sub8(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,8] = x[0,8] - y[0,8];
    r[8,8] = x[8,8] - y[8,8];
    r[16,8] = x[16,8] - y[16,8];
    r[24,8] = x[24,8] - y[24,8];
    r[32,8] = x[32,8] - y[32,8];
    r[40,8] = x[40,8] - y[40,8];
    r[48,8] = x[48,8] - y[48,8];
    r[56,8] = x[56,8] - y[56,8];
    dest = r;
}
macro avx_add16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,16] = x[0,16] + y[0,16];
    r[16,16] = x[16,16] + y[16,16];
    r[32,16] = x[32,16] + y[32,16];
    r[48,16] = x[48,16] + y[48,16];
    dest = r;
}
macro avx_sub16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,16] = x[0,16] - y[0,16];
    r[16,16] = x[16,16] - y[16,16];
    r[32,16] = x[32,16] - y[32,16];
    r[48,16] = x[48,16] - y[48,16];
    dest = r;
}
macro avx_add32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,32] = x[0,32] + y[0,32];
    r[32,32] = x[32,32] + y[32,32];
    dest = r;
}
macro avx_sub32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,32] = x[0,32] - y[0,32];
    r[32,32] = x[32,32] - y[32,32];
    dest = r;
}
macro avx_add64(dest, a, b) {
    dest = a + b;
}
macro avx_sub64(dest, a, b) {
    dest = a - b;
}

# Low half of the lane product.
macro avx_mullo16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,16] = x[0,16] * y[0,16];
    r[16,16] = x[16,16] * y[16,16];
    r[32,16] = x[32,16] * y[32,16];
    r[48,16] = x[48,16] * y[48,16];
    dest = r;
}
macro avx_mullo32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,32] = x[0,32] * y[0,32];
    r[32,32] = x[32,32] * y[32,32];
    dest = r;
}

# Saturating arithmetic and averages, through the SSE user-ops.
macro avx_adds8(dest, a, b) { local x:8 = a; local y:8 = b; dest = paddsb(x, y); }
macro avx_adds16(dest, a, b) { local x:8 = a; local y:8 = b; dest = paddsw(x, y); }
macro avx_addus8(dest, a, b) { local x:8 = a; local y:8 = b; dest = paddusb(x, y); }
macro avx_addus16(dest, a, b) { local x:8 = a; local y:8 = b; dest = paddusw(x, y); }
macro avx_subs8(dest, a, b) { local x:8 = a; local y:8 = b; dest = psubsb(x, y); }
macro avx_subs16(dest, a, b) { local x:8 = a; local y:8 = b; dest = psubsw(x, y); }
macro avx_subus8(dest, a, b) { local x:8 = a; local y:8 = b; dest = psubusb(x, y); }
macro avx_subus16(dest, a, b) { local x:8 = a; local y:8 = b; dest = psubusw(x, y); }
macro avx_avg8(dest, a, b) { local x:8 = a; local y:8 = b; dest = pavgb(x, y); }
macro avx_avg16(dest, a, b) { local x:8 = a; local y:8 = b; dest = pavgw(x, y); }
macro avx_mulhu16(dest, a, b) { local x:8 = a; local y:8 = b; dest = pmulhuw(x, y); }
macro avx_madd16(dest, a, b) { local x:8 = a; local y:8 = b; dest = pmaddwd(x, y); }

# Signed high half of the 16-bit product.
macro avx_mulhs16(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    local p0:4 = sext(x[0,16]) * sext(y[0,16]);
    r[0,16] = p0[16,16];
    local p1:4 = sext(x[16,16]) * sext(y[16,16]);
    r[16,16] = p1[16,16];
    local p2:4 = sext(x[32,16]) * sext(y[32,16]);
    r[32,16] = p2[16,16];
    local p3:4 = sext(x[48,16]) * sext(y[48,16]);
    r[48,16] = p3[16,16];
    dest = r;
}

# Compares: all-ones where the predicate holds.
macro avx_cmpeq8(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,8] = 0 - zext(x[0,8] == y[0,8]);
    r[8,8] = 0 - zext(x[8,8] == y[8,8]);
    r[16,8] = 0 - zext(x[16,8] == y[16,8]);
    r[24,8] = 0 - zext(x[24,8] == y[24,8]);
    r[32,8] = 0 - zext(x[32,8] == y[32,8]);
    r[40,8] = 0 - zext(x[40,8] == y[40,8]);
    r[48,8] = 0 - zext(x[48,8] == y[48,8]);
    r[56,8] = 0 - zext(x[56,8] == y[56,8]);
    dest = r;
}
macro avx_cmpgt8(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,8] = 0 - zext(x[0,8] s> y[0,8]);
    r[8,8] = 0 - zext(x[8,8] s> y[8,8]);
    r[16,8] = 0 - zext(x[16,8] s> y[16,8]);
    r[24,8] = 0 - zext(x[24,8] s> y[24,8]);
    r[32,8] = 0 - zext(x[32,8] s> y[32,8]);
    r[40,8] = 0 - zext(x[40,8] s> y[40,8]);
    r[48,8] = 0 - zext(x[48,8] s> y[48,8]);
    r[56,8] = 0 - zext(x[56,8] s> y[56,8]);
    dest = r;
}
