}
macro avx_cmpgt32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,32] = 0 - zext(x[0,32] s> y[0,32]);
    r[32,32] = 0 - zext(x[32,32] s> y[32,32]);
    dest = r;
}
macro avx_cmpeq64(dest, a, b) {
    dest = 0 - zext(a == b);
}
macro avx_cmpgt64(dest, a, b) {
    dest = 0 - zext(a s> b);
}

# Min and max, signed and unsigned.
macro avx_mins8(dest, a, b) {
    local x:8 = a; local y:8 = b; local k:8;
    k[0,8] = 0 - zext(x[0,8] s< y[0,8]);
    k[8,8] = 0 - zext(x[8,8] s< y[8,8]);
    k[16,8] = 0 - zext(x[16,8] s< y[16,8]);
    k[24,8] = 0 - zext(x[24,8] s< y[24,8]);
    k[32,8] = 0 - zext(x[32,8] s< y[32,8]);
    k[40,8] = 0 - zext(x[40,8] s< y[40,8]);
    k[48,8] = 0 - zext(x[48,8] s< y[48,8]);
    k[56,8] = 0 - zext(x[56,8] s< y[56,8]);
    dest = (x & k) | (y & ~k);
}
