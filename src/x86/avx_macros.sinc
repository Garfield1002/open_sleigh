macro avx_cmpeq32(dest, a, b) {
    local x:8 = a; local y:8 = b; local r:8;
    r[0,32] = 0 - zext(x[0,32] == y[0,32]);
    r[32,32] = 0 - zext(x[32,32] == y[32,32]);
