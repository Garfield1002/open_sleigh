:PEXTRW        Reg32, XmmReg2, imm8 is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xC5; xmmmod = 3 & Reg32 & XmmReg2 & check_Reg32_dest; imm8
{
    local shift:1 = (imm8 & 0x7) * 16:1;
    local low:1 = shift < 64:1;
    local temp:8;
    conditionalAssign(temp,low,XmmReg2[0,64] >> shift, XmmReg2[64,64] >> (shift-64));
    Reg32 = zext(temp:2);
    build check_Reg32_dest;
}

#break PEXTRW with reg/mem dest into two constructors to handle zext in register case
:PEXTRW        Rmr32, XmmReg1, imm8 is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x3A; byte=0x15; (mod = 3 & Rmr32 & check_Rmr32_dest) & XmmReg1 ; imm8
{
    local shift:1 = (imm8 & 0x7) * 16:1;
    local low:1 = shift < 64:1;
    local temp:8;
    conditionalAssign(temp,low,XmmReg1[0,64] >> shift,XmmReg1[64,64] >> (shift - 64));
    Rmr32 = zext(temp:2);
    build check_Rmr32_dest;
}

:PEXTRW        m16, XmmReg1, imm8 is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x3A; byte=0x15; XmmReg1 ... & m16; imm8
{
   local shift:1 = (imm8 & 0x7) * 16:1;
   local low:1 = shift < 64:1;
   local temp:8;
   conditionalAssign(temp,low,XmmReg1[0,64] >> shift,XmmReg1[64,64] >> (shift - 64));
   m16 = temp:2; 
}

:PHADDD            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x02; XmmReg1 ... & XmmReg2_m128
{
    local hsrc:16 = XmmReg2_m128;
    local hdst:16 = XmmReg1;
    XmmReg1[0,32] = hdst[0,32] + hdst[32,32];
    XmmReg1[32,32] = hdst[64,32] + hdst[96,32];
    XmmReg1[64,32] = hsrc[0,32] + hsrc[32,32];
    XmmReg1[96,32] = hsrc[64,32] + hsrc[96,32];
}

:PHADDW            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x01; XmmReg1 ... & XmmReg2_m128
{
    local hsrc:16 = XmmReg2_m128;
    local hdst:16 = XmmReg1;
    XmmReg1[0,16] = hdst[0,16] + hdst[16,16];
    XmmReg1[16,16] = hdst[32,16] + hdst[48,16];
    XmmReg1[32,16] = hdst[64,16] + hdst[80,16];
    XmmReg1[48,16] = hdst[96,16] + hdst[112,16];
    XmmReg1[64,16] = hsrc[0,16] + hsrc[16,16];
    XmmReg1[80,16] = hsrc[32,16] + hsrc[48,16];
    XmmReg1[96,16] = hsrc[64,16] + hsrc[80,16];
    XmmReg1[112,16] = hsrc[96,16] + hsrc[112,16];
}

:PHADDSW           XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x03; XmmReg1 ... & XmmReg2_m128
{
    local hsrc:16 = XmmReg2_m128;
    local hdst:16 = XmmReg1;
    local wide:4;
    local lane:2;
    wide = sext(hdst[0,16]) + sext(hdst[16,16]);
    ssdsw(wide, lane);
    XmmReg1[0,16] = lane;
    wide = sext(hdst[32,16]) + sext(hdst[48,16]);
    ssdsw(wide, lane);
    XmmReg1[16,16] = lane;
    wide = sext(hdst[64,16]) + sext(hdst[80,16]);
    ssdsw(wide, lane);
    XmmReg1[32,16] = lane;
    wide = sext(hdst[96,16]) + sext(hdst[112,16]);
    ssdsw(wide, lane);
    XmmReg1[48,16] = lane;
    wide = sext(hsrc[0,16]) + sext(hsrc[16,16]);
    ssdsw(wide, lane);
    XmmReg1[64,16] = lane;
    wide = sext(hsrc[32,16]) + sext(hsrc[48,16]);
    ssdsw(wide, lane);
    XmmReg1[80,16] = lane;
    wide = sext(hsrc[64,16]) + sext(hsrc[80,16]);
    ssdsw(wide, lane);
    XmmReg1[96,16] = lane;
    wide = sext(hsrc[96,16]) + sext(hsrc[112,16]);
    ssdsw(wide, lane);
    XmmReg1[112,16] = lane;
}

:PHSUBD            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x06; XmmReg1 ... & XmmReg2_m128
{
    local hsrc:16 = XmmReg2_m128;
    local hdst:16 = XmmReg1;
    XmmReg1[0,32] = hdst[0,32] - hdst[32,32];
    XmmReg1[32,32] = hdst[64,32] - hdst[96,32];
    XmmReg1[64,32] = hsrc[0,32] - hsrc[32,32];
    XmmReg1[96,32] = hsrc[64,32] - hsrc[96,32];
}

:PHSUBW            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x05; XmmReg1 ... & XmmReg2_m128
{
    local hsrc:16 = XmmReg2_m128;
    local hdst:16 = XmmReg1;
    XmmReg1[0,16] = hdst[0,16] - hdst[16,16];
    XmmReg1[16,16] = hdst[32,16] - hdst[48,16];
    XmmReg1[32,16] = hdst[64,16] - hdst[80,16];
    XmmReg1[48,16] = hdst[96,16] - hdst[112,16];
    XmmReg1[64,16] = hsrc[0,16] - hsrc[16,16];
    XmmReg1[80,16] = hsrc[32,16] - hsrc[48,16];
    XmmReg1[96,16] = hsrc[64,16] - hsrc[80,16];
    XmmReg1[112,16] = hsrc[96,16] - hsrc[112,16];
}

:PHSUBSW           XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x07; XmmReg1 ... & XmmReg2_m128
{
    local hsrc:16 = XmmReg2_m128;
    local hdst:16 = XmmReg1;
    local wide:4;
    local lane:2;
    wide = sext(hdst[0,16]) - sext(hdst[16,16]);
    ssdsw(wide, lane);
    XmmReg1[0,16] = lane;
    wide = sext(hdst[32,16]) - sext(hdst[48,16]);
    ssdsw(wide, lane);
    XmmReg1[16,16] = lane;
    wide = sext(hdst[64,16]) - sext(hdst[80,16]);
    ssdsw(wide, lane);
    XmmReg1[32,16] = lane;
    wide = sext(hdst[96,16]) - sext(hdst[112,16]);
    ssdsw(wide, lane);
    XmmReg1[48,16] = lane;
    wide = sext(hsrc[0,16]) - sext(hsrc[16,16]);
    ssdsw(wide, lane);
    XmmReg1[64,16] = lane;
    wide = sext(hsrc[32,16]) - sext(hsrc[48,16]);
    ssdsw(wide, lane);
    XmmReg1[80,16] = lane;
    wide = sext(hsrc[64,16]) - sext(hsrc[80,16]);
    ssdsw(wide, lane);
    XmmReg1[96,16] = lane;
    wide = sext(hsrc[96,16]) - sext(hsrc[112,16]);
    ssdsw(wide, lane);
    XmmReg1[112,16] = lane;
}

:PINSRW        XmmReg, Rmr32, imm8 is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xC4; xmmmod=3 & Rmr32 & XmmReg; imm8 
{ 
    local destIndex:1 = (imm8 & 0x7) * 16:1;
    local useLow:1 = destIndex < 64:1;
    local newLow:8 = zext(Rmr32:2) << destIndex;
    newLow = (XmmReg[0,64] & ~(0xffff:8 << destIndex)) |  newLow;
    local newHigh:8 = zext(Rmr32:2) << (destIndex-64:1);
    newHigh = (XmmReg[64,64] & ~(0xffff:8 << (destIndex - 64:1))) | newHigh;
    conditionalAssign(XmmReg[0,64],useLow,newLow,XmmReg[0,64]);
    conditionalAssign(XmmReg[64,64],!useLow,newHigh,XmmReg[64,64]);
}

:PINSRW        XmmReg, m16, imm8 is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xC4; m16 & XmmReg ...; imm8 
{ 
    local destIndex:1 = (imm8 & 0x7) * 16:1;
    local useLow:1 = destIndex < 64:1;
    local newLow:8 = zext(m16) << destIndex;
    newLow = (XmmReg[0,64] & ~(0xffff:8 << destIndex)) |  newLow;
    local newHigh:8 = zext(m16) << (destIndex-64:1);
    newHigh = (XmmReg[64,64] & ~(0xffff:8 << (destIndex - 64:1))) | newHigh;
    conditionalAssign(XmmReg[0,64],useLow,newLow,XmmReg[0,64]);
    conditionalAssign(XmmReg[64,64],!useLow,newHigh,XmmReg[64,64]);
}

:PMADDUBSW         XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x04; XmmReg1 ... & XmmReg2_m128
{
    local msrc:16 = XmmReg2_m128;
    local mdst:16 = XmmReg1;
    local lo:4;
    local hi:4;
    local sum:4;
    local lane:2;
    lo = zext(mdst[0,8]) * sext(msrc[0,8]);
    hi = zext(mdst[8,8]) * sext(msrc[8,8]);
    sum = lo + hi;
    ssdsw(sum, lane);
    XmmReg1[0,16] = lane;
    lo = zext(mdst[16,8]) * sext(msrc[16,8]);
    hi = zext(mdst[24,8]) * sext(msrc[24,8]);
    sum = lo + hi;
    ssdsw(sum, lane);
    XmmReg1[16,16] = lane;
    lo = zext(mdst[32,8]) * sext(msrc[32,8]);
    hi = zext(mdst[40,8]) * sext(msrc[40,8]);
    sum = lo + hi;
    ssdsw(sum, lane);
    XmmReg1[32,16] = lane;
    lo = zext(mdst[48,8]) * sext(msrc[48,8]);
    hi = zext(mdst[56,8]) * sext(msrc[56,8]);
    sum = lo + hi;
    ssdsw(sum, lane);
    XmmReg1[48,16] = lane;
    lo = zext(mdst[64,8]) * sext(msrc[64,8]);
    hi = zext(mdst[72,8]) * sext(msrc[72,8]);
