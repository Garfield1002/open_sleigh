	XmmReg2 = val;
}

:EXTRQ XmmReg1, XmmReg2 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x79; XmmReg1 & XmmReg2 {
	local len = XmmReg2[0,6];
