:PTEST     XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x38; byte=0x17; XmmReg1 ... & XmmReg2_m128
{
    local temp_m128:16 = XmmReg2_m128;
    local tmp = temp_m128 & XmmReg1;
    ZF = tmp == 0;
    local tmp2 = temp_m128 & ~XmmReg1;
    CF = tmp2 == 0;
    AF = 0;
    OF = 0;
    PF = 0;
    SF = 0;
}

:PCMPEQQ     XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x38; byte=0x29; XmmReg1 ... & XmmReg2_m128
{ 
	local temp_m128:16 = XmmReg2_m128;
	XmmReg1[0,64] = zext(XmmReg1[0,64] == temp_m128[0,64]) * 0xffffffffffffffff:8;
	XmmReg1[64,64] = zext(XmmReg1[64,64] == temp_m128[64,64]) * 0xffffffffffffffff:8;
}

:PACKUSDW     XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x38; byte=0x2B; XmmReg1 ... & XmmReg2_m128
{
    local a:16 = XmmReg1;
    local b:16 = XmmReg2_m128;
    local lane:2;
    ssduw(a[0,32], lane); XmmReg1[0,16] = lane;
    ssduw(a[32,32], lane); XmmReg1[16,16] = lane;
    ssduw(a[64,32], lane); XmmReg1[32,16] = lane;
    ssduw(a[96,32], lane); XmmReg1[48,16] = lane;
    ssduw(b[0,32], lane); XmmReg1[64,16] = lane;
    ssduw(b[32,32], lane); XmmReg1[80,16] = lane;
    ssduw(b[64,32], lane); XmmReg1[96,16] = lane;
