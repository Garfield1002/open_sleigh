    sse_add64(XmmReg1[0,64], XmmReg1[0,64], XmmReg1[64,64]);
    sse_add64(XmmReg1[64,64], m[0,64], m[64,64]);
}

:HADDPS               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0x7C; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    sse_add32(XmmReg1[0,32], XmmReg1[0,32], XmmReg1[32,32]);
    sse_add32(XmmReg1[32,32], XmmReg1[64,32], XmmReg1[96,32]);
    sse_add32(XmmReg1[64,32], m[0,32], m[32,32]);
    sse_add32(XmmReg1[96,32], m[64,32], m[96,32]);
}

:HSUBPD               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x7D; XmmReg1 ... & XmmReg2_m128
