# The SSE unit through SSE4.2 and the AES/PCLMUL-era crypto forms: every
# constructor with an XMM operand, the user-ops and macros only they use, and
# MXCSR. The XMM register file, the XmmReg operand subtables and the lane
# macros the MMX forms share are defined in ia.sinc, which must be included
# first; the AVX files reuse the same operands and come after.

define pcodeop movdq2q;

define pcodeop movmskpd;

define pcodeop movmskps;

define pcodeop paddusw;

define pcodeop rcpps;

define pcodeop rcpss;

define pcodeop rsqrtps;

define pcodeop rsqrtss;

define pcodeop mpsadbw;

define pcodeop dpps;

define pcodeop dppd;

define pcodeop blendps;

define pcodeop blendpd;

define pcodeop pblendw;

define pcodeop roundps;

define pcodeop roundss;

define pcodeop roundpd;

define pcodeop roundsd;

define pcodeop insertps;

define pcodeop extractps;

define pcodeop aesdec;

define pcodeop aesdeclast;

define pcodeop aesenc;

define pcodeop aesenclast;

define pcodeop aesimc;

define pcodeop aeskeygenassist;

# floating point NaN comparison into EFLAGS
macro fucompe(val1, val2) {
    PF = nan(val1) || nan(val2 );
    ZF = PF | ( val1 f== val2 );
    CF = PF | ( val1 f< val2 );    
 
    OF = 0;
    AF = 0;
    SF = 0;
}

# --- MXCSR exception reporting ---------------------------------------------
# SSE keeps its whole floating policy here: the generic IEEE operations report
# only IEEE facts, and these macros map them onto MXCSR, apply MXCSR's
# rounding control, denormals-are-zero and flush-to-zero, and choose the
# result an invalid operation delivers. Every corpus mode is masked, so the
# flags only accumulate; #XM delivery is not modelled.

# The MXCSR rounding-control field uses exactly the encoding the generic IEEE
# operations take, so it passes straight through.
macro sse_rc(rc) {
    local field:4 = (MXCSR >> 13) & 3;
    rc = field:1;
}

# IE, ZE, OE, UE and PE sit in MXCSR at the bit positions the generic flags
# byte already uses; DE is determined from the source operands.
# Invalid and divide-by-zero take precedence over the denormal report, and so
# does a NaN operand: hardware raises neither DE nor anything else for a
# denormal paired with a NaN.
macro sse_report(flags, de) {
    local suppressed:1 = (flags & 5) != 0;
    MXCSR = MXCSR | (zext(flags) & 0x3d) | (zext(de && !suppressed) * 2);
}

# A denormal source operand raises DE, unless MXCSR.DAZ is set, in which case
# it is replaced by a zero of its own sign before the operation sees it and
# nothing is reported.
macro sse_daz32(value, de) {
    local denormal:1 = (value[23,8] == 0) && (value[0,23] != 0);
    local daz:1 = ((MXCSR >> 6) & 1) != 0;
    local flush:1 = denormal && daz;
    local keep:4 = 0 - zext(!flush);
    value = (value & keep) | (value & 0x80000000 & ~keep);
    de = denormal && !daz;
}

# MXCSR.FTZ replaces a masked tiny result by a zero of its own sign and reports
# both underflow and precision. Tininess alone triggers it: an exact denormal
# result is flushed and reported just as a rounded one is, so the test is the
# result's own encoding rather than the generic underflow fact.
macro sse_ftz32(result, flags) {
    local ftz:1 = ((MXCSR >> 15) & 1) != 0;
    local masked:1 = ((MXCSR >> 11) & 1) != 0;
    local tiny:1 = (result[23,8] == 0) && (result[0,23] != 0);
    local flush:1 = ftz && masked && tiny;
    local keep:4 = 0 - zext(!flush);
    result = (result & keep) | (result & 0x80000000 & ~keep);
    flags = flags | (flush * 0x30);
}

# x86 chooses what an invalid operation delivers, and how a NaN operand
# propagates, rather than taking the generic operation's own NaN: a NaN first
# operand wins, quieted, then a NaN second operand, and any other invalid
# yields the QNaN indefinite. A one-operand form passes its operand twice.
macro sse_invalid32(a, b, flags, result) {
    local a_nan:1 = (a[23,8] == 0xff) && (a[0,23] != 0);
    local b_nan:1 = (b[23,8] == 0xff) && (b[0,23] != 0);
    local pick_a:4 = 0 - zext(a_nan);
    local propagated:4 = ((a | 0x00400000) & pick_a) | ((b | 0x00400000) & ~pick_a);
    local any_nan:1 = a_nan || b_nan;
    local nan_mask:4 = 0 - zext(any_nan);
    local indefinite_mask:4 = 0 - zext(((flags & 1) != 0) && !any_nan);
    local substituted:4 = nan_mask | indefinite_mask;
    result = (propagated & nan_mask) | (0xffc00000 & indefinite_mask) |
             (result & ~substituted);
}

macro sse_add32(dest, lhs, rhs) {
    local a:4 = lhs;
    local b:4 = rhs;
    local de_a:1; sse_daz32(a, de_a);
    local de_b:1; sse_daz32(b, de_b);
    local rc:1; sse_rc(rc);
    local result:4 = float_add(a, b, rc);
    local flags:1 = float_add_flags(a, b, rc);
    sse_invalid32(a, b, flags, result);
    sse_ftz32(result, flags);
    local nan_operand:1 = ((a[23,8] == 0xff) && (a[0,23] != 0)) ||
                          ((b[23,8] == 0xff) && (b[0,23] != 0));
    sse_report(flags, (de_a || de_b) && !nan_operand);
    dest = result;
}

macro sse_sub32(dest, lhs, rhs) {
    local a:4 = lhs;
    local b:4 = rhs;
    local de_a:1; sse_daz32(a, de_a);
    local de_b:1; sse_daz32(b, de_b);
    local rc:1; sse_rc(rc);
    local result:4 = float_sub(a, b, rc);
    local flags:1 = float_sub_flags(a, b, rc);
    sse_invalid32(a, b, flags, result);
    sse_ftz32(result, flags);
    local nan_operand:1 = ((a[23,8] == 0xff) && (a[0,23] != 0)) ||
                          ((b[23,8] == 0xff) && (b[0,23] != 0));
    sse_report(flags, (de_a || de_b) && !nan_operand);
    dest = result;
}

macro sse_mul32(dest, lhs, rhs) {
    local a:4 = lhs;
    local b:4 = rhs;
    local de_a:1; sse_daz32(a, de_a);
    local de_b:1; sse_daz32(b, de_b);
    local rc:1; sse_rc(rc);
    local result:4 = float_mul(a, b, rc);
    local flags:1 = float_mul_flags(a, b, rc);
    sse_invalid32(a, b, flags, result);
    sse_ftz32(result, flags);
    local nan_operand:1 = ((a[23,8] == 0xff) && (a[0,23] != 0)) ||
                          ((b[23,8] == 0xff) && (b[0,23] != 0));
    sse_report(flags, (de_a || de_b) && !nan_operand);
    dest = result;
}

macro sse_div32(dest, lhs, rhs) {
    local a:4 = lhs;
    local b:4 = rhs;
    local de_a:1; sse_daz32(a, de_a);
    local de_b:1; sse_daz32(b, de_b);
    local rc:1; sse_rc(rc);
    local result:4 = float_div(a, b, rc);
    local flags:1 = float_div_flags(a, b, rc);
    sse_invalid32(a, b, flags, result);
    sse_ftz32(result, flags);
    local nan_operand:1 = ((a[23,8] == 0xff) && (a[0,23] != 0)) ||
                          ((b[23,8] == 0xff) && (b[0,23] != 0));
    sse_report(flags, (de_a || de_b) && !nan_operand);
    dest = result;
}

macro sse_sqrt32(dest, source) {
    local a:4 = source;
    local de_a:1; sse_daz32(a, de_a);
    local rc:1; sse_rc(rc);
    local result:4 = float_sqrt(a, rc);
    local flags:1 = float_sqrt_flags(a, rc);
    sse_invalid32(a, a, flags, result);
    sse_ftz32(result, flags);
    local nan_operand:1 = (a[23,8] == 0xff) && (a[0,23] != 0);
    sse_report(flags, de_a && !nan_operand);
    dest = result;
}

# A denormal source operand raises DE, unless MXCSR.DAZ is set, in which case
# it is replaced by a zero of its own sign before the operation sees it and
# nothing is reported.
macro sse_daz64(value, de) {
    local denormal:1 = (value[52,11] == 0) && (value[0,52] != 0);
    local daz:1 = ((MXCSR >> 6) & 1) != 0;
    local flush:1 = denormal && daz;
    local keep:8 = 0 - zext(!flush);
    value = (value & keep) | (value & 0x8000000000000000 & ~keep);
    de = denormal && !daz;
}

# MXCSR.FTZ replaces a masked tiny result by a zero of its own sign and reports
# both underflow and precision. Tininess alone triggers it: an exact denormal
# result is flushed and reported just as a rounded one is, so the test is the
# result's own encoding rather than the generic underflow fact.
macro sse_ftz64(result, flags) {
    local ftz:1 = ((MXCSR >> 15) & 1) != 0;
    local masked:1 = ((MXCSR >> 11) & 1) != 0;
    local tiny:1 = (result[52,11] == 0) && (result[0,52] != 0);
    local flush:1 = ftz && masked && tiny;
    local keep:8 = 0 - zext(!flush);
    result = (result & keep) | (result & 0x8000000000000000 & ~keep);
    flags = flags | (flush * 0x30);
}

# x86 chooses what an invalid operation delivers, and how a NaN operand
# propagates, rather than taking the generic operation's own NaN: a NaN first
# operand wins, quieted, then a NaN second operand, and any other invalid
# yields the QNaN indefinite. A one-operand form passes its operand twice.
macro sse_invalid64(a, b, flags, result) {
    local a_nan:1 = (a[52,11] == 0x7ff) && (a[0,52] != 0);
    local b_nan:1 = (b[52,11] == 0x7ff) && (b[0,52] != 0);
    local pick_a:8 = 0 - zext(a_nan);
    local propagated:8 = ((a | 0x0008000000000000) & pick_a) | ((b | 0x0008000000000000) & ~pick_a);
    local any_nan:1 = a_nan || b_nan;
    local nan_mask:8 = 0 - zext(any_nan);
    local indefinite_mask:8 = 0 - zext(((flags & 1) != 0) && !any_nan);
    local substituted:8 = nan_mask | indefinite_mask;
    result = (propagated & nan_mask) | (0xfff8000000000000 & indefinite_mask) |
             (result & ~substituted);
}

macro sse_add64(dest, lhs, rhs) {
    local a:8 = lhs;
    local b:8 = rhs;
    local de_a:1; sse_daz64(a, de_a);
    local de_b:1; sse_daz64(b, de_b);
    local rc:1; sse_rc(rc);
    local result:8 = float_add(a, b, rc);
    local flags:1 = float_add_flags(a, b, rc);
    sse_invalid64(a, b, flags, result);
    sse_ftz64(result, flags);
    local nan_operand:1 = ((a[52,11] == 0x7ff) && (a[0,52] != 0)) ||
                          ((b[52,11] == 0x7ff) && (b[0,52] != 0));
    sse_report(flags, (de_a || de_b) && !nan_operand);
    dest = result;
}

macro sse_sub64(dest, lhs, rhs) {
    local a:8 = lhs;
    local b:8 = rhs;
    local de_a:1; sse_daz64(a, de_a);
    local de_b:1; sse_daz64(b, de_b);
    local rc:1; sse_rc(rc);
    local result:8 = float_sub(a, b, rc);
    local flags:1 = float_sub_flags(a, b, rc);
    sse_invalid64(a, b, flags, result);
    sse_ftz64(result, flags);
    local nan_operand:1 = ((a[52,11] == 0x7ff) && (a[0,52] != 0)) ||
                          ((b[52,11] == 0x7ff) && (b[0,52] != 0));
    sse_report(flags, (de_a || de_b) && !nan_operand);
    dest = result;
}

macro sse_mul64(dest, lhs, rhs) {
    local a:8 = lhs;
    local b:8 = rhs;
    local de_a:1; sse_daz64(a, de_a);
    local de_b:1; sse_daz64(b, de_b);
    local rc:1; sse_rc(rc);
    local result:8 = float_mul(a, b, rc);
    local flags:1 = float_mul_flags(a, b, rc);
    sse_invalid64(a, b, flags, result);
    sse_ftz64(result, flags);
