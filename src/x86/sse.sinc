# The SSE unit through SSE4.2 and the AES/PCLMUL-era crypto forms: every
# constructor with an XMM operand, the user-ops and macros only they use, and
# MXCSR. The XMM register file, the XmmReg operand subtables and the lane
# macros the MMX forms share are defined in ia.sinc, which must be included
# first; the AVX files reuse the same operands and come after.

define pcodeop lddqu;

define pcodeop movdq2q;

define pcodeop movmskpd;

define pcodeop movmskps;

define pcodeop pabsb;

define pcodeop pabsw;

define pcodeop pabsd;

define pcodeop paddusw;

define pcodeop phaddd;

define pcodeop phaddw;

define pcodeop phaddsw;

define pcodeop phsubd;

define pcodeop phsubw;

define pcodeop phsubsw;

define pcodeop pmaddubsw;

define pcodeop pmulhrsw;

define pcodeop pshufb;

define pcodeop psignb;

define pcodeop psignw;

define pcodeop psignd;

define pcodeop rcpps;

define pcodeop rcpss;

define pcodeop rsqrtps;

define pcodeop rsqrtss;

define pcodeop mpsadbw;

define pcodeop phminposuw;

define pcodeop pmuldq;

define pcodeop pmulld;

define pcodeop dpps;

define pcodeop dppd;

define pcodeop blendps;

define pcodeop blendpd;

define pcodeop blendvps;

define pcodeop blendvpd;

define pcodeop pblendvb;

define pcodeop pblendw;

define pcodeop roundps;

define pcodeop roundss;

define pcodeop roundpd;

define pcodeop roundsd;

define pcodeop insertps;

define pcodeop extractps;

define pcodeop pmovsxbw;

define pcodeop pmovsxbd;

define pcodeop pmovsxbq;

define pcodeop pmovsxwd;

define pcodeop pmovsxwq;

define pcodeop pmovsxdq;

define pcodeop pmovzxbw;

define pcodeop pmovzxbd;

define pcodeop pmovzxbq;

define pcodeop pmovzxwd;

define pcodeop pmovzxwq;

define pcodeop pmovzxdq;

define pcodeop packusdw;

define pcodeop movntdqa;

define pcodeop pcmpestri;

define pcodeop pcmpestrm;

define pcodeop pcmpistri;

define pcodeop pcmpistrm;

define pcodeop aesdec;

define pcodeop aesdeclast;

define pcodeop aesenc;

define pcodeop aesenclast;

define pcodeop aesimc;

define pcodeop aeskeygenassist;


# floating point NaN comparison into EFLAGS
macro fucompe(val1, val2) {
    PF = nan(val1) || nan(val2 );
    ZF = PF | ( val1 f== val2 );
    CF = PF | ( val1 f< val2 );    
 
    OF = 0;
    AF = 0;
    SF = 0;
}

# The packed float operations are lifted lane by lane in p-code. MXCSR
# rounding and exception flags are deliberately not modelled.
macro divpd128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    dst[  0,64] = a[  0,64] f/ b[  0,64];
    dst[ 64,64] = a[ 64,64] f/ b[ 64,64];
}

macro divps128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    dst[  0,32] = a[  0,32] f/ b[  0,32];
    dst[ 32,32] = a[ 32,32] f/ b[ 32,32];
    dst[ 64,32] = a[ 64,32] f/ b[ 64,32];
    dst[ 96,32] = a[ 96,32] f/ b[ 96,32];
}

# SSE MIN returns its second operand whenever either operand is a NaN or both
# operands are zero of either sign, and the smaller operand otherwise; MAX is
# symmetric. An ordered `f<` is false in exactly the return-the-second-operand
# cases, so one comparison per lane selects the source, and the lane is moved
# bit-for-bit so that a NaN payload survives unchanged.
macro maxpd128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    local pick0:8 = 0 - zext(b[  0,64] f< a[  0,64]);
    dst[  0,64] = (a[  0,64] & pick0) | (b[  0,64] & (~pick0));
    local pick1:8 = 0 - zext(b[ 64,64] f< a[ 64,64]);
    dst[ 64,64] = (a[ 64,64] & pick1) | (b[ 64,64] & (~pick1));
}

macro maxps128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    local pick0:4 = 0 - zext(b[  0,32] f< a[  0,32]);
    dst[  0,32] = (a[  0,32] & pick0) | (b[  0,32] & (~pick0));
    local pick1:4 = 0 - zext(b[ 32,32] f< a[ 32,32]);
    dst[ 32,32] = (a[ 32,32] & pick1) | (b[ 32,32] & (~pick1));
    local pick2:4 = 0 - zext(b[ 64,32] f< a[ 64,32]);
    dst[ 64,32] = (a[ 64,32] & pick2) | (b[ 64,32] & (~pick2));
    local pick3:4 = 0 - zext(b[ 96,32] f< a[ 96,32]);
    dst[ 96,32] = (a[ 96,32] & pick3) | (b[ 96,32] & (~pick3));
}

macro minpd128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    local pick0:8 = 0 - zext(a[  0,64] f< b[  0,64]);
    dst[  0,64] = (a[  0,64] & pick0) | (b[  0,64] & (~pick0));
    local pick1:8 = 0 - zext(a[ 64,64] f< b[ 64,64]);
    dst[ 64,64] = (a[ 64,64] & pick1) | (b[ 64,64] & (~pick1));
}

macro minps128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    local pick0:4 = 0 - zext(a[  0,32] f< b[  0,32]);
    dst[  0,32] = (a[  0,32] & pick0) | (b[  0,32] & (~pick0));
    local pick1:4 = 0 - zext(a[ 32,32] f< b[ 32,32]);
    dst[ 32,32] = (a[ 32,32] & pick1) | (b[ 32,32] & (~pick1));
    local pick2:4 = 0 - zext(a[ 64,32] f< b[ 64,32]);
    dst[ 64,32] = (a[ 64,32] & pick2) | (b[ 64,32] & (~pick2));
    local pick3:4 = 0 - zext(a[ 96,32] f< b[ 96,32]);
    dst[ 96,32] = (a[ 96,32] & pick3) | (b[ 96,32] & (~pick3));
}

macro packsswb_xmm(dst, src) {
	# A bit range passed as a macro output parameter is an rvalue, so the
	# assignment inside the saturating macro lands on a discarded
	# temporary and the lane is never written. Saturate into a local.
	local a:16 = dst;
	local lane:1;
	local b:16 = src;

	sswsb(a[  0,16], lane);	dst[0,8] = lane;
	sswsb(a[ 16,16], lane);	dst[8,8] = lane;
	sswsb(a[ 32,16], lane);	dst[16,8] = lane;
	sswsb(a[ 48,16], lane);	dst[24,8] = lane;
	sswsb(a[ 64,16], lane);	dst[32,8] = lane;
	sswsb(a[ 80,16], lane);	dst[40,8] = lane;
	sswsb(a[ 96,16], lane);	dst[48,8] = lane;
	sswsb(a[112,16], lane);	dst[56,8] = lane;

	sswsb(b[  0,16], lane);	dst[64,8] = lane;
	sswsb(b[ 16,16], lane);	dst[72,8] = lane;
	sswsb(b[ 32,16], lane);	dst[80,8] = lane;
	sswsb(b[ 48,16], lane);	dst[88,8] = lane;
	sswsb(b[ 64,16], lane);	dst[96,8] = lane;
	sswsb(b[ 80,16], lane);	dst[104,8] = lane;
	sswsb(b[ 96,16], lane);	dst[112,8] = lane;
	sswsb(b[112,16], lane);	dst[120,8] = lane;
}

macro packssdw_xmm(dst, src) {
	# A bit range passed as a macro output parameter is an rvalue, so the
	# assignment inside the saturating macro lands on a discarded
	# temporary and the lane is never written. Saturate into a local.
	local a:16 = dst;
	local lane:2;
	local b:16 = src;

	ssdsw(a[ 0,32], lane);	dst[0,16] = lane;
	ssdsw(a[32,32], lane);	dst[16,16] = lane;
	ssdsw(a[64,32], lane);	dst[32,16] = lane;
	ssdsw(a[96,32], lane);	dst[48,16] = lane;

	ssdsw(b[ 0,32], lane);	dst[64,16] = lane;
	ssdsw(b[32,32], lane);	dst[80,16] = lane;
	ssdsw(b[64,32], lane);	dst[96,16] = lane;
	ssdsw(b[96,32], lane);	dst[112,16] = lane;
}

macro pmulhw128(xmm1, xmm2) {
	local tmp0:8 = sext(xmm1[  0,16]) * sext(xmm2[  0,16]);
    xmm1[  0,16] = tmp0[16,16];
	local tmp1:8 = sext(xmm1[ 16,16]) * sext(xmm2[ 16,16]);
    xmm1[ 16,16] = tmp1[16,16];
	local tmp2:8 = sext(xmm1[ 32,16]) * sext(xmm2[ 32,16]);
    xmm1[ 32,16] = tmp2[16,16];
	local tmp3:8 = sext(xmm1[ 48,16]) * sext(xmm2[ 48,16]);
    xmm1[ 48,16] = tmp3[16,16];
	local tmp4:8 = sext(xmm1[ 64,16]) * sext(xmm2[ 64,16]);
    xmm1[ 64,16] = tmp4[16,16];
	local tmp5:8 = sext(xmm1[ 80,16]) * sext(xmm2[ 80,16]);
    xmm1[ 80,16] = tmp5[16,16];
	local tmp6:8 = sext(xmm1[ 96,16]) * sext(xmm2[ 96,16]);
    xmm1[ 96,16] = tmp6[16,16];
	local tmp7:8 = sext(xmm1[112,16]) * sext(xmm2[112,16]);
    xmm1[112,16] = tmp7[16,16];
}

# The XMM form is two independent MMX-shaped halves: each 64-bit half becomes
# the 16-bit sum of its eight absolute byte differences, zero extended.
macro psadbw_xmm(dst, src) {
    local left:16 = dst;
    local right:16 = src;
    local lo:8 = left[0,64];
    local rlo:8 = right[0,64];
    psadbw_mmx(lo, rlo);
    local hi:8 = left[64,64];
    local rhi:8 = right[64,64];
    psadbw_mmx(hi, rhi);
    dst[0,64] = lo;
    dst[64,64] = hi;
}

macro shuffle_4(dest,ord,c0,c1,c2,c3){
    dest = zext(ord == 0) * c0 + zext(ord == 1) * c1 + zext(ord == 2) * c2 + zext(ord == 3) * c3;
}

# The SSE shift-by-count forms take a single 64-bit count from the low quadword
# of the source operand -- it is not a per-lane count -- and a count at or
# beyond the lane width produces an all-zero lane (an all-sign-bits lane for an
# arithmetic shift). Clamp the count to the lane width the way the MMX macros
# above do, so that SLEIGH's narrowing of the count to the lane width cannot
# silently wrap an oversized count.
macro psllw128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    xmm[  0,16] = xmm[  0,16] << amount;
    xmm[ 16,16] = xmm[ 16,16] << amount;
    xmm[ 32,16] = xmm[ 32,16] << amount;
    xmm[ 48,16] = xmm[ 48,16] << amount;
    xmm[ 64,16] = xmm[ 64,16] << amount;
    xmm[ 80,16] = xmm[ 80,16] << amount;
    xmm[ 96,16] = xmm[ 96,16] << amount;
    xmm[112,16] = xmm[112,16] << amount;
}

macro pslld128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    xmm[  0,32] = xmm[  0,32] << amount;
    xmm[ 32,32] = xmm[ 32,32] << amount;
    xmm[ 64,32] = xmm[ 64,32] << amount;
    xmm[ 96,32] = xmm[ 96,32] << amount;
}

macro psllq128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 63);
    local amount:8 = (n & (over - 1)) | (over * 64);
    xmm[  0,64] = xmm[  0,64] << amount;
    xmm[ 64,64] = xmm[ 64,64] << amount;
}

macro psrlw128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    xmm[  0,16] = xmm[  0,16] >> amount;
    xmm[ 16,16] = xmm[ 16,16] >> amount;
    xmm[ 32,16] = xmm[ 32,16] >> amount;
    xmm[ 48,16] = xmm[ 48,16] >> amount;
    xmm[ 64,16] = xmm[ 64,16] >> amount;
    xmm[ 80,16] = xmm[ 80,16] >> amount;
    xmm[ 96,16] = xmm[ 96,16] >> amount;
    xmm[112,16] = xmm[112,16] >> amount;
}

macro psrld128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    xmm[  0,32] = xmm[  0,32] >> amount;
    xmm[ 32,32] = xmm[ 32,32] >> amount;
    xmm[ 64,32] = xmm[ 64,32] >> amount;
    xmm[ 96,32] = xmm[ 96,32] >> amount;
}

macro psrlq128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 63);
    local amount:8 = (n & (over - 1)) | (over * 64);
    xmm[  0,64] = xmm[  0,64] >> amount;
    xmm[ 64,64] = xmm[ 64,64] >> amount;
}

macro psraw128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    xmm[  0,16] = xmm[  0,16] s>> amount;
    xmm[ 16,16] = xmm[ 16,16] s>> amount;
    xmm[ 32,16] = xmm[ 32,16] s>> amount;
    xmm[ 48,16] = xmm[ 48,16] s>> amount;
    xmm[ 64,16] = xmm[ 64,16] s>> amount;
    xmm[ 80,16] = xmm[ 80,16] s>> amount;
    xmm[ 96,16] = xmm[ 96,16] s>> amount;
    xmm[112,16] = xmm[112,16] s>> amount;
}

macro psrad128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    xmm[  0,32] = xmm[  0,32] s>> amount;
    xmm[ 32,32] = xmm[ 32,32] s>> amount;
    xmm[ 64,32] = xmm[ 64,32] s>> amount;
    xmm[ 96,32] = xmm[ 96,32] s>> amount;
}

macro sqrtpd128(dst, src) {
    local b:16 = src;
    dst[  0,64] = sqrt(b[  0,64]);
    dst[ 64,64] = sqrt(b[ 64,64]);
}

macro sqrtps128(dst, src) {
    local b:16 = src;
    dst[  0,32] = sqrt(b[  0,32]);
    dst[ 32,32] = sqrt(b[ 32,32]);
    dst[ 64,32] = sqrt(b[ 64,32]);
    dst[ 96,32] = sqrt(b[ 96,32]);
}

# --- SSE4.1 immediate-controlled lanes -------------------------------------
# The immediate is an 8-bit token: widening it to an eight-byte cast is an
# invalid bit range and hands the consumer garbage. Every macro below takes the
# control byte as a one-byte value and selects lanes from its bits.

macro blendps128(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    conditionalAssign(dst[  0,32], c[0,1], b[  0,32], dst[  0,32]);
    conditionalAssign(dst[ 32,32], c[1,1], b[ 32,32], dst[ 32,32]);
    conditionalAssign(dst[ 64,32], c[2,1], b[ 64,32], dst[ 64,32]);
    conditionalAssign(dst[ 96,32], c[3,1], b[ 96,32], dst[ 96,32]);
}

macro blendpd128(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    conditionalAssign(dst[  0,64], c[0,1], b[  0,64], dst[  0,64]);
    conditionalAssign(dst[ 64,64], c[1,1], b[ 64,64], dst[ 64,64]);
}

macro pblendw128(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    conditionalAssign(dst[  0,16], c[0,1], b[  0,16], dst[  0,16]);
    conditionalAssign(dst[ 16,16], c[1,1], b[ 16,16], dst[ 16,16]);
    conditionalAssign(dst[ 32,16], c[2,1], b[ 32,16], dst[ 32,16]);
    conditionalAssign(dst[ 48,16], c[3,1], b[ 48,16], dst[ 48,16]);
    conditionalAssign(dst[ 64,16], c[4,1], b[ 64,16], dst[ 64,16]);
    conditionalAssign(dst[ 80,16], c[5,1], b[ 80,16], dst[ 80,16]);
    conditionalAssign(dst[ 96,16], c[6,1], b[ 96,16], dst[ 96,16]);
    conditionalAssign(dst[112,16], c[7,1], b[112,16], dst[112,16]);
}

# DPPS/DPPD: the high nibble of the control byte masks the products, the low
# nibble masks which lanes receive the sum. Intel sums as (p0+p1)+(p2+p3).
macro dpps128(dst, src, ctl) {
    local a:16 = dst;
    local b:16 = src;
    local c:1 = ctl;
    local p0:4 = a[  0,32] f* b[  0,32];
    local p1:4 = a[ 32,32] f* b[ 32,32];
    local p2:4 = a[ 64,32] f* b[ 64,32];
    local p3:4 = a[ 96,32] f* b[ 96,32];
    conditionalAssign(p0, c[4,1], p0, 0:4);
    conditionalAssign(p1, c[5,1], p1, 0:4);
    conditionalAssign(p2, c[6,1], p2, 0:4);
    conditionalAssign(p3, c[7,1], p3, 0:4);
    local sum:4 = (p0 f+ p1) f+ (p2 f+ p3);
    conditionalAssign(dst[  0,32], c[0,1], sum, 0:4);
    conditionalAssign(dst[ 32,32], c[1,1], sum, 0:4);
    conditionalAssign(dst[ 64,32], c[2,1], sum, 0:4);
    conditionalAssign(dst[ 96,32], c[3,1], sum, 0:4);
}

macro dppd128(dst, src, ctl) {
    local a:16 = dst;
    local b:16 = src;
    local c:1 = ctl;
    local p0:8 = a[  0,64] f* b[  0,64];
    local p1:8 = a[ 64,64] f* b[ 64,64];
    conditionalAssign(p0, c[4,1], p0, 0:8);
    conditionalAssign(p1, c[5,1], p1, 0:8);
    local sum:8 = p0 f+ p1;
    conditionalAssign(dst[  0,64], c[0,1], sum, 0:8);
    conditionalAssign(dst[ 64,64], c[1,1], sum, 0:8);
}

# ROUND*: bits 0-1 of the control byte select nearest/down/up/toward-zero, and
# bit 2 replaces that choice with MXCSR's RC field (bits 13-14).
macro sse_round_mode(mode, ctl) {
    local c:1 = ctl;
    local mxcsr:4 = MXCSR;
    local fromMxcsr:1 = zext(mxcsr[13,2]);
    local fromImm:1 = zext(c[0,2]);
    conditionalAssign(mode, c[2,1], fromMxcsr, fromImm);
}

macro round_f4(dst, src, mode) {
    local s:4 = src;
    local down:4 = floor(s);
    local up:4 = ceil(s);
    local nearest:4 = round(s);
    local toZero:4;
    conditionalAssign(toZero, s f< 0:4, up, down);
    shuffle_4(dst, mode, nearest, down, up, toZero);
}

macro round_f8(dst, src, mode) {
    local s:8 = src;
    local down:8 = floor(s);
    local up:8 = ceil(s);
    local nearest:8 = round(s);
    local toZero:8;
    conditionalAssign(toZero, s f< 0:8, up, down);
    shuffle_4(dst, mode, nearest, down, up, toZero);
}

macro roundps128(dst, src, ctl) {
    local b:16 = src;
    local mode:1;
    sse_round_mode(mode, ctl);
    round_f4(dst[  0,32], b[  0,32], mode);
    round_f4(dst[ 32,32], b[ 32,32], mode);
    round_f4(dst[ 64,32], b[ 64,32], mode);
    round_f4(dst[ 96,32], b[ 96,32], mode);
}

macro roundpd128(dst, src, ctl) {
    local b:16 = src;
    local mode:1;
    sse_round_mode(mode, ctl);
    round_f8(dst[  0,64], b[  0,64], mode);
    round_f8(dst[ 64,64], b[ 64,64], mode);
}

macro roundss128(dst, src, ctl) {
    local b:4 = src;
    local mode:1;
    sse_round_mode(mode, ctl);
    round_f4(dst[0,32], b, mode);
}

macro roundsd128(dst, src, ctl) {
    local b:8 = src;
    local mode:1;
    sse_round_mode(mode, ctl);
    round_f8(dst[0,64], b, mode);
}

# INSERTPS: bits 6-7 pick the source lane (register form only), bits 4-5 the
# destination lane, bits 0-3 zero the lanes they name -- after the insert.
macro insertps_lane(dst, lane, ctl) {
    local c:1 = ctl;
    local sel:4 = lane;
    local to:1 = zext(c[4,2]);
    conditionalAssign(dst[  0,32], to == 0, sel, dst[  0,32]);
    conditionalAssign(dst[ 32,32], to == 1, sel, dst[ 32,32]);
    conditionalAssign(dst[ 64,32], to == 2, sel, dst[ 64,32]);
    conditionalAssign(dst[ 96,32], to == 3, sel, dst[ 96,32]);
    conditionalAssign(dst[  0,32], c[0,1], 0:4, dst[  0,32]);
    conditionalAssign(dst[ 32,32], c[1,1], 0:4, dst[ 32,32]);
    conditionalAssign(dst[ 64,32], c[2,1], 0:4, dst[ 64,32]);
    conditionalAssign(dst[ 96,32], c[3,1], 0:4, dst[ 96,32]);
}

macro insertps128(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    local sel:4;
    shuffle_4(sel, c[6,2], b[0,32], b[32,32], b[64,32], b[96,32]);
    insertps_lane(dst, sel, ctl);
}

macro extractps32(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    shuffle_4(dst, c[0,2], b[0,32], b[32,32], b[64,32], b[96,32]);
}

# MPSADBW: bits 0-1 pick a four-byte block of the source, bit 2 a four-byte
# offset into the destination; each result word is the sum of four absolute
# byte differences over a sliding window. Fully unrolled: a SLEIGH bit range
# needs literal bounds, so the window offsets cannot be macro parameters.
macro mpsadbw128(dst, src, ctl) {
    local a:16 = dst;
    local b:16 = src;
    local c:1 = ctl;
    local blk:4;
    shuffle_4(blk, c[0,2], b[0,32], b[32,32], b[64,32], b[96,32]);
    local win:16;
    conditionalAssign(win, c[2,1], a >> 32, a);
    local sum0:2 = 0;
    psadbw_byte(sum0, win[0,8], blk[0,8]);
    psadbw_byte(sum0, win[8,8], blk[8,8]);
    psadbw_byte(sum0, win[16,8], blk[16,8]);
    psadbw_byte(sum0, win[24,8], blk[24,8]);
    dst[0,16] = sum0;
    local sum1:2 = 0;
    psadbw_byte(sum1, win[8,8], blk[0,8]);
    psadbw_byte(sum1, win[16,8], blk[8,8]);
    psadbw_byte(sum1, win[24,8], blk[16,8]);
    psadbw_byte(sum1, win[32,8], blk[24,8]);
    dst[16,16] = sum1;
    local sum2:2 = 0;
    psadbw_byte(sum2, win[16,8], blk[0,8]);
    psadbw_byte(sum2, win[24,8], blk[8,8]);
    psadbw_byte(sum2, win[32,8], blk[16,8]);
    psadbw_byte(sum2, win[40,8], blk[24,8]);
    dst[32,16] = sum2;
    local sum3:2 = 0;
    psadbw_byte(sum3, win[24,8], blk[0,8]);
    psadbw_byte(sum3, win[32,8], blk[8,8]);
    psadbw_byte(sum3, win[40,8], blk[16,8]);
    psadbw_byte(sum3, win[48,8], blk[24,8]);
    dst[48,16] = sum3;
    local sum4:2 = 0;
    psadbw_byte(sum4, win[32,8], blk[0,8]);
    psadbw_byte(sum4, win[40,8], blk[8,8]);
    psadbw_byte(sum4, win[48,8], blk[16,8]);
    psadbw_byte(sum4, win[56,8], blk[24,8]);
    dst[64,16] = sum4;
    local sum5:2 = 0;
    psadbw_byte(sum5, win[40,8], blk[0,8]);
    psadbw_byte(sum5, win[48,8], blk[8,8]);
    psadbw_byte(sum5, win[56,8], blk[16,8]);
    psadbw_byte(sum5, win[64,8], blk[24,8]);
    dst[80,16] = sum5;
    local sum6:2 = 0;
    psadbw_byte(sum6, win[48,8], blk[0,8]);
    psadbw_byte(sum6, win[56,8], blk[8,8]);
    psadbw_byte(sum6, win[64,8], blk[16,8]);
    psadbw_byte(sum6, win[72,8], blk[24,8]);
    dst[96,16] = sum6;
    local sum7:2 = 0;
    psadbw_byte(sum7, win[56,8], blk[0,8]);
    psadbw_byte(sum7, win[64,8], blk[8,8]);
    psadbw_byte(sum7, win[72,8], blk[16,8]);
    psadbw_byte(sum7, win[80,8], blk[24,8]);
    dst[112,16] = sum7;
}


with : lockprefx=0 {

#@family sse
:LDMXCSR m32		is vexMode=0 & byte=0xf; byte=0xae; ( mod != 0b11 & reg_opcode=2 ) ... & m32 { MXCSR = m32; }

:STMXCSR m32        is vexMode=0 & byte=0xf; byte=0xae; ( mod != 0b11 & reg_opcode=3 ) ... & m32 { m32 = MXCSR; }

:ADDPD            XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x58; XmmReg1 ... & XmmReg2_m128
{
    XmmReg1[0,64]  = XmmReg1[0,64]  f+ XmmReg2_m128[0,64];
    XmmReg1[64,64] = XmmReg1[64,64] f+ XmmReg2_m128[64,64];
}

:ADDPS            XmmReg1, XmmReg2_m128  is vexMode=0 & mandover=0 & byte=0x0F; byte=0x58; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;	# Guarantee value is in a fixed location
    XmmReg1[0,32] = XmmReg1[0,32] f+ m[0,32];
    XmmReg1[32,32] = XmmReg1[32,32] f+ m[32,32];
    XmmReg1[64,32] = XmmReg1[64,32] f+ m[64,32];
    XmmReg1[96,32] = XmmReg1[96,32] f+ m[96,32];
}

:ADDSD        XmmReg, m64      is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x58; m64 & XmmReg ...
{
    XmmReg[0,64] = XmmReg[0,64] f+ m64;
}

:ADDSD        XmmReg1, XmmReg2 is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x58; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,64] = XmmReg1[0,64] f+ XmmReg2[0,64];
}

:ADDSS        XmmReg, m32      is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x58; m32 & XmmReg ...
{
    XmmReg[0,32] = XmmReg[0,32] f+ m32;
}

:ADDSS        XmmReg1, XmmReg2 is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x58; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,32] = XmmReg1[0,32] f+ XmmReg2[0,32];
}

:ADDSUBPD         XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0xD0; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = XmmReg1[0,64] f- m[0,64];
    XmmReg1[64,64] = XmmReg1[64,64] f+ m[64,64];
}

:ADDSUBPS         XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0xD0; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = XmmReg1[0,32] f- m[0,32];
    XmmReg1[32,32] = XmmReg1[32,32] f+ m[32,32];
    XmmReg1[64,32] = XmmReg1[64,32] f- m[64,32];
    XmmReg1[96,32] = XmmReg1[96,32] f+ m[96,32];
}

# special FLOATING POINT bitwise AND
:ANDPD      XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x54; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = XmmReg1[0,64] & m[0,64];
    XmmReg1[64,64] = XmmReg1[64,64] & m[64,64];
}

# special FLOATING POINT bitwise AND
# special FLOATING POINT bitwise AND
:ANDPS            XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x54; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = XmmReg1[0,32] & m[0,32];
    XmmReg1[32,32] = XmmReg1[32,32] & m[32,32];
    XmmReg1[64,32] = XmmReg1[64,32] & m[64,32];
    XmmReg1[96,32] = XmmReg1[96,32] & m[96,32];
}

# special FLOATING POINT bitwise AND
# special FLOATING POINT bitwise AND NOT
:ANDNPD           XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x55; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = ~XmmReg1[0,64] & m[0,64];
    XmmReg1[64,64] = ~XmmReg1[64,64] & m[64,64];
}

# special FLOATING POINT bitwise AND NOT
:ANDNPS           XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x55; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = ~XmmReg1[0,32] & m[0,32];
    XmmReg1[32,32] = ~XmmReg1[32,32] & m[32,32];
    XmmReg1[64,32] = ~XmmReg1[64,32] & m[64,32];
    XmmReg1[96,32] = ~XmmReg1[96,32] & m[96,32];
}

:CMP^XmmCondPD^"PD"        XmmReg,m128^CMPPD_OPERAND      is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xC2; (m128 & XmmReg ...); XmmCondPD & CMPPD_OPERAND
{
    local m:16 = m128;
	xmmTmp1_Qa = XmmReg[0,64];
	xmmTmp1_Qb = XmmReg[64,64];

	xmmTmp2_Qa = m[0,64];
	xmmTmp2_Qb = m[64,64];

	build XmmCondPD;
	
	XmmReg[0,64] = xmmTmp1_Qa;
	XmmReg[64,64] = xmmTmp1_Qb;
}

:CMP^XmmCondPD^"PD"        XmmReg1,XmmReg2^CMPPD_OPERAND  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xC2; xmmmod=3 & XmmReg1 & XmmReg2; XmmCondPD & CMPPD_OPERAND 
{
	xmmTmp1_Qa = XmmReg1[0,64];
	xmmTmp1_Qb = XmmReg1[64,64];
	
	xmmTmp2_Qa = XmmReg2[0,64];
	xmmTmp2_Qb = XmmReg2[64,64];
	
	build XmmCondPD;
	
	XmmReg1[0,64] = xmmTmp1_Qa;
	XmmReg1[64,64] = xmmTmp1_Qb;
}

:CMP^XmmCondPS^"PS"        XmmReg,m128^CMPPS_OPERAND      is vexMode=0 &  mandover=0 & byte=0x0F; byte=0xC2; (m128 & XmmReg ...); XmmCondPS & CMPPS_OPERAND
{
    local m:16 = m128;
	xmmTmp1_Da = XmmReg[0,32];
	xmmTmp1_Db = XmmReg[32,32];
	xmmTmp1_Dc = XmmReg[64,32];
	xmmTmp1_Dd = XmmReg[96,32];

	xmmTmp2_Da = m[0,32];
	xmmTmp2_Db = m[32,32];
	xmmTmp2_Dc = m[64,32];
	xmmTmp2_Dd = m[96,32];

	build XmmCondPS;
	
	XmmReg[0,32] = xmmTmp1_Da;
	XmmReg[32,32] = xmmTmp1_Db;
	XmmReg[64,32] = xmmTmp1_Dc;
	XmmReg[96,32] = xmmTmp1_Dd;
}

:CMP^XmmCondPS^"PS"        XmmReg1,XmmReg2^CMPPS_OPERAND  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0xC2; xmmmod=3 & XmmReg1 & XmmReg2; XmmCondPS & CMPPS_OPERAND 
{
	xmmTmp1_Da = XmmReg1[0,32];
	xmmTmp1_Db = XmmReg1[32,32];
	xmmTmp1_Dc = XmmReg1[64,32];
	xmmTmp1_Dd = XmmReg1[96,32];
	
	xmmTmp2_Da = XmmReg2[0,32];
	xmmTmp2_Db = XmmReg2[32,32];
	xmmTmp2_Dc = XmmReg2[64,32];
	xmmTmp2_Dd = XmmReg2[96,32];
	
	build XmmCondPS;
	
	XmmReg1[0,32] = xmmTmp1_Da;
	XmmReg1[32,32] = xmmTmp1_Db;
	XmmReg1[64,32] = xmmTmp1_Dc;
	XmmReg1[96,32] = xmmTmp1_Dd;
}

:CMP^XmmCondSD^"SD"  XmmReg, m64^CMPSD_OPERAND  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0xC2; (m64 & XmmReg ...); XmmCondSD & CMPSD_OPERAND
{ 
	xmmTmp1_Qa = XmmReg[0,64];
	xmmTmp2_Qa = m64;
	build XmmCondSD;
	XmmReg[0,64] = xmmTmp1_Qa;
}

:CMP^XmmCondSD^"SD"  XmmReg1, XmmReg2^CMPSD_OPERAND  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0xC2; xmmmod=3 & XmmReg1 & XmmReg2; XmmCondSD & CMPSD_OPERAND
{ 
	xmmTmp1_Qa = XmmReg1[0,64];
	xmmTmp2_Qa = XmmReg2[0,64];
	build XmmCondSD;
	XmmReg1[0,64] = xmmTmp1_Qa;
}

:CMP^XmmCondSS^"SS"  XmmReg, m32^CMPSS_OPERAND  is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0xC2; (m32 & XmmReg ...); XmmCondSS & CMPSS_OPERAND
{ 
	xmmTmp1_Da = XmmReg[0,32];
	xmmTmp2_Da = m32;
	build XmmCondSS;
	XmmReg[0,32] = xmmTmp1_Da;
}

:CMP^XmmCondSS^"SS"  XmmReg1, XmmReg2^CMPSS_OPERAND  is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0xC2; xmmmod=3 & XmmReg1 & XmmReg2; XmmCondSS & CMPSS_OPERAND
{ 
	xmmTmp1_Da = XmmReg1[0,32];
	xmmTmp2_Da = XmmReg2[0,32];
	build XmmCondSS;
	XmmReg1[0,32] = xmmTmp1_Da;
}

:COMISD       XmmReg, m64   is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2F; m64 & XmmReg ...
{
  fucompe(XmmReg[0,64], m64);
}

:COMISD       XmmReg1, XmmReg2  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2F; xmmmod=3 & XmmReg1 & XmmReg2
{
  fucompe(XmmReg1[0,64], XmmReg2[0,64]);
}

:COMISS       XmmReg, m32       is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2F; m32 & XmmReg ...
{
  fucompe(XmmReg[0,32], m32);
}

:COMISS       XmmReg1, XmmReg2  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2F; xmmmod=3 & XmmReg1 & XmmReg2
{
  fucompe(XmmReg1[0,32], XmmReg2[0,32]);
}

:CVTDQ2PD     XmmReg, m64       is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0xE6; m64 & XmmReg ...
{
    local m:8 = m64;
    XmmReg[0,64] = int2float( m[0,32] );
    XmmReg[64,64] = int2float( m[32,32] );
}

:CVTDQ2PD     XmmReg1, XmmReg2  is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0xE6; xmmmod=3 & XmmReg1 & XmmReg2
{
    local tmp:8 = XmmReg2[0,64];
    XmmReg1[0,64] = int2float( tmp[0,32] );
    XmmReg1[64,64] = int2float( tmp[32,32] );
}

:CVTDQ2PS          XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x5B; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = int2float( m[0,32] );
    XmmReg1[32,32] = int2float( m[32,32] );
    XmmReg1[64,32] = int2float( m[64,32] );
    XmmReg1[96,32] = int2float( m[96,32] );
}

:CVTPD2DQ          XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0xE6; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = trunc( m[0,64] );
    XmmReg1[32,32] = trunc( m[64,64] );
    XmmReg1[64,32] = 0;
    XmmReg1[96,32] = 0;
}

:CVTPD2PI     mmxregop, m128        is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2D; mmxregop ... & m128
{
    local m:16 = m128;
    mmxregop[0,32] = trunc( m[0,64] );
    mmxregop[32,32] = trunc( m[64,64] );
}

:CVTPD2PI     mmxreg1op, XmmReg2    is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2D; xmmmod=3 & mmxreg1op & XmmReg2
{
    mmxreg1op[0,32] = trunc( XmmReg2[0,64] );
    mmxreg1op[32,32] = trunc( XmmReg2[64,64] );
}

:CVTPD2PS          XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x5A; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = float2float( m[0,64] );
    XmmReg1[32,32] = float2float( m[64,64] );
    XmmReg1[64,32] = 0;
    XmmReg1[96,32] = 0;
}

:CVTPI2PD     XmmReg, m64       is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2A; m64 & XmmReg ...
{
  local m:8 = m64;
  XmmReg[0,64] =  int2float(m[0,32]);
  XmmReg[64,64] =  int2float(m[32,32]);
}

:CVTPI2PD     XmmReg1, mmxreg2op  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2A; xmmmod=3 & XmmReg1 & mmxreg2op
{
  XmmReg1[0,64] = int2float(mmxreg2op[0,32]);
  XmmReg1[64,64] = int2float(mmxreg2op[32,32]);
}

:CVTPI2PS     XmmReg, m64       is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2A; m64 & XmmReg ...
{
  local m:8 = m64;
  XmmReg[0,32] = int2float(m[0,32]);
  XmmReg[32,32] = int2float(m[32,32]);
}

:CVTPI2PS     XmmReg1, mmxreg2op  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2A; xmmmod=3 & XmmReg1 & mmxreg2op
{
  XmmReg1[0,32] = int2float(mmxreg2op[0,32]);
  XmmReg1[32,32] = int2float(mmxreg2op[32,32]);
}

:CVTPS2DQ             XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x5B; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = trunc( m[0,32] );
    XmmReg1[32,32] = trunc( m[32,32] );
    XmmReg1[64,32] = trunc( m[64,32] );
    XmmReg1[96,32] = trunc( m[96,32] );
}

:CVTPS2PD     XmmReg, m64       is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x5A; m64 & XmmReg ...
{
    local m:8 = m64;
    XmmReg[0,64] = float2float( m[0,32] );
    XmmReg[64,64] = float2float( m[32,32] );
}

:CVTPS2PD     XmmReg1, XmmReg2  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x5A; xmmmod=3 & XmmReg1 & XmmReg2
{
    local tmp:8 = XmmReg2[0,64];
    XmmReg1[0,64] = float2float( tmp[0,32] );
    XmmReg1[64,64] = float2float( tmp[32,32] );
}

:CVTPS2PI     mmxreg1op, XmmReg2    is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2D; xmmmod=3 & mmxreg1op & XmmReg2
{
  mmxreg1op[0,32] = round(XmmReg2[0,32]);
  mmxreg1op[32,32] = round(XmmReg2[32,32]);
  FPUTagWord = 0x0000;         
}

:CVTSD2SI     Reg32, m64    is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x2D; (Reg32 & check_Reg32_dest) ... & m64
{
  Reg32 = trunc(round(m64));
  build check_Reg32_dest;
}

:CVTSD2SI     Reg32, XmmReg2 is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x2D; xmmmod=3 & Reg32 & check_Reg32_dest & XmmReg2
{
  Reg32 = trunc(round(XmmReg2[0,64]));
  build check_Reg32_dest;
}

@ifdef IA64
:CVTSD2SI     Reg64, m64    is $(LONGMODE_ON) & vexMode=0 & opsize=2 & $(PRE_F2) & byte=0x0F; byte=0x2D; Reg64 ... & m64
{
  Reg64 = trunc(round(m64));
}

:CVTSD2SI     Reg64, XmmReg2 is vexMode=0 & opsize=2 & $(PRE_F2) & byte=0x0F; byte=0x2D; xmmmod=3 & Reg64 & XmmReg2
{
  Reg64 = trunc(round(XmmReg2[0,64]));
}

@endif
:CVTSD2SS     XmmReg, m64       is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x5A; m64 & XmmReg ...
{
  XmmReg[0,32] = float2float(m64);
}

:CVTSD2SS     XmmReg1, XmmReg2  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x5A; xmmmod=3 & XmmReg1 & XmmReg2
{
  XmmReg1[0,32] = float2float(XmmReg2[0,64]);
}

:CVTSI2SD     XmmReg, rm32    is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0x2A; rm32 & XmmReg ...
{
  XmmReg[0,64] = int2float(rm32);
}

@ifdef IA64
:CVTSI2SD     XmmReg, rm64    is $(LONGMODE_ON) & vexMode=0 & opsize=2 & $(PRE_F2) & byte=0x0F; byte=0x2A; rm64 & XmmReg ...
{
  XmmReg[0,64] = int2float(rm64);
}

@endif
:CVTSI2SS     XmmReg, rm32    is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x2A; rm32 & XmmReg ...
{
  XmmReg[0,32] = int2float(rm32);
}

@ifdef IA64
:CVTSI2SS     XmmReg, rm64    is $(LONGMODE_ON) & vexMode=0 & opsize=2 & $(PRE_F3) & byte=0x0F; byte=0x2A; rm64 & XmmReg ...
{
  XmmReg[0,32] = int2float(rm64);
}

@endif
:CVTSS2SD     XmmReg, m32    is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x5A; m32 & XmmReg ...
{
  XmmReg[0,64] = float2float(m32);
}

:CVTSS2SD     XmmReg1, XmmReg2  is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x5A; xmmmod=3 & XmmReg1 & XmmReg2
{
  XmmReg1[0,64] = float2float(XmmReg2[0,32]);
}

:CVTSS2SI     Reg32, m32    is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x2D; (Reg32 & check_Reg32_dest) ... & m32
{
  Reg32 = trunc(round(m32));
  build check_Reg32_dest;
}

:CVTSS2SI     Reg32, XmmReg2 is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x2D; xmmmod=3 & Reg32 & check_Reg32_dest & XmmReg2
{
  Reg32 = trunc(round(XmmReg2[0,32]));
  build check_Reg32_dest;
}

@ifdef IA64
:CVTSS2SI     Reg64, m32    is $(LONGMODE_ON) & vexMode=0 & opsize=2 & $(PRE_F3) & byte=0x0F; byte=0x2D; Reg64 ... & m32
{
  Reg64 = trunc(round(m32));
}

:CVTSS2SI     Reg64, XmmReg2 is vexMode=0 & opsize=2 & $(PRE_F3) & byte=0x0F; byte=0x2D; xmmmod=3 & Reg64 & XmmReg2
{
  Reg64 = trunc(round(XmmReg2[0,32]));
}

@endif
:CVTTPD2PI    mmxregop, m128        is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2C; mmxregop ... & m128
{
  local m:16 = m128;
  mmxregop[0,32] = trunc(m[0,64]);
  mmxregop[32,32] = trunc(m[64,64]);
  FPUTagWord = 0x0000;         
}

:CVTTPD2PI    mmxreg1op, XmmReg2    is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2C; xmmmod=3 & mmxreg1op & XmmReg2
{
  mmxreg1op[0,32] = trunc(XmmReg2[0,64]);
  mmxreg1op[32,32] = trunc(XmmReg2[64,64]);
  FPUTagWord = 0x0000;         
}

:CVTTPD2DQ           XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xE6; XmmReg1 ... & XmmReg2_m128
{
  local m:16 = XmmReg2_m128;
  XmmReg1[0,32] = trunc(m[0,64]);
  XmmReg1[32,32] = trunc(m[64,64]);
  XmmReg1[64,32] = 0;
  XmmReg1[96,32] = 0;
}

:CVTTPS2DQ           XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x5B; XmmReg1 ... & XmmReg2_m128
{
  local m:16 = XmmReg2_m128;
  XmmReg1[0,32] = trunc(m[0,32]);
  XmmReg1[32,32] = trunc(m[32,32]);
  XmmReg1[64,32] = trunc(m[64,32]);
  XmmReg1[96,32] = trunc(m[96,32]);
}

:CVTTPS2PI    mmxreg1op, XmmReg2    is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2C; xmmmod=3 & mmxreg1op & XmmReg2
{
  mmxreg1op[0,32] = trunc(XmmReg2[0,32]);
  mmxreg1op[32,32] = trunc(XmmReg2[32,32]);
  FPUTagWord = 0x0000;         
}

:CVTTSD2SI    Reg32, m64  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x2C; (Reg32 & check_Reg32_dest) ... & m64
{
  Reg32 = trunc(m64);
  build check_Reg32_dest;
}

:CVTTSD2SI    Reg32, XmmReg2  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x2C; xmmmod=3 & Reg32 & check_Reg32_dest & XmmReg2
{
  Reg32 = trunc(XmmReg2[0,64]);
  build check_Reg32_dest;
}

