    XmmReg2[64,64] = XmmReg1[64,64];
}

:MOVUPS           XmmReg1, XmmReg2_m128  is vexMode=0 &  byte=0x0F; byte=0x10; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = m[0,32];
    XmmReg1[32,32] = m[32,32];
    XmmReg1[64,32] = m[64,32];
    XmmReg1[96,32] = m[96,32];
}

:MOVUPS       m128, XmmReg     is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x11; m128 & XmmReg ...
{
    m128 = XmmReg;
}

:MOVUPS       XmmReg2, XmmReg1 is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x11; xmmmod = 3 & XmmReg1 & XmmReg2
{
    XmmReg2[0,32] = XmmReg1[0,32];
    XmmReg2[32,32] = XmmReg1[32,32];
    XmmReg2[64,32] = XmmReg1[64,32];
    XmmReg2[96,32] = XmmReg1[96,32];
}

:MULPD            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x59; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    sse_mul64(XmmReg1[0,64], XmmReg1[0,64], m[0,64]);
    sse_mul64(XmmReg1[64,64], XmmReg1[64,64], m[64,64]);
}

:MULPS            XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x59; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    sse_mul32(XmmReg1[0,32], XmmReg1[0,32], m[0,32]);
    sse_mul32(XmmReg1[32,32], XmmReg1[32,32], m[32,32]);
    sse_mul32(XmmReg1[64,32], XmmReg1[64,32], m[64,32]);
    sse_mul32(XmmReg1[96,32], XmmReg1[96,32], m[96,32]);
}

:MULSD        XmmReg, m64      is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0x59;  m64 & XmmReg ...
{
    sse_mul64(XmmReg[0,64], XmmReg[0,64], m64);
}

:MULSD        XmmReg1, XmmReg2 is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0x59; xmmmod = 3 & XmmReg1 & XmmReg2
{
    sse_mul64(XmmReg1[0,64], XmmReg1[0,64], XmmReg2[0,64]);
}

:MULSS        XmmReg, m32      is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x59; m32 & XmmReg ...
{
    sse_mul32(XmmReg[0,32], XmmReg[0,32], m32);
}

:MULSS        XmmReg1, XmmReg2 is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x59; xmmmod = 3 & XmmReg1 & XmmReg2
{
    sse_mul32(XmmReg1[0,32], XmmReg1[0,32], XmmReg2[0,32]);
}

:ORPD              XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x56; XmmReg1 ... & XmmReg2_m128
{ XmmReg1 = XmmReg1 | XmmReg2_m128; }

:ORPS              XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x56; XmmReg1 ... & XmmReg2_m128
{ XmmReg1 = XmmReg1 | XmmReg2_m128; }

:PACKSSWB          XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x63; XmmReg1 ... & XmmReg2_m128
{ packsswb_xmm(XmmReg1, XmmReg2_m128); }

:PACKSSDW          XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x6B; XmmReg1 ... & XmmReg2_m128
{ packssdw_xmm(XmmReg1, XmmReg2_m128); }

:PACKUSWB          XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x67; XmmReg1 ... & XmmReg2_m128
{
    local dest_copy:16 = XmmReg1;
    local src_copy:16 = XmmReg2_m128;
    local ubyte:1 = 0;
    sswub(dest_copy[0,16],ubyte);
    XmmReg1[0,8] = ubyte;
    sswub(dest_copy[16,16],ubyte);
    XmmReg1[8,8] = ubyte;
    sswub(dest_copy[32,16],ubyte);
    XmmReg1[16,8] = ubyte;
    sswub(dest_copy[48,16],ubyte);
    XmmReg1[24,8] = ubyte;
    sswub(dest_copy[64,16],ubyte);
    XmmReg1[32,8] = ubyte;
    sswub(dest_copy[80,16],ubyte);
    XmmReg1[40,8] = ubyte;
    sswub(dest_copy[96,16],ubyte);
    XmmReg1[48,8] = ubyte;
    sswub(dest_copy[112,16],ubyte);
    XmmReg1[56,8] = ubyte;

    sswub(src_copy[0,16],ubyte);
    XmmReg1[64,8] = ubyte;
    sswub(src_copy[16,16],ubyte);
    XmmReg1[72,8] = ubyte;
    sswub(src_copy[32,16],ubyte);
    XmmReg1[80,8] = ubyte;
    sswub(src_copy[48,16],ubyte);
    XmmReg1[88,8] = ubyte;
    sswub(src_copy[64,16],ubyte);
    XmmReg1[96,8] = ubyte;
    sswub(src_copy[80,16],ubyte);
    XmmReg1[104,8] = ubyte;
    sswub(src_copy[96,16],ubyte);
    XmmReg1[112,8] = ubyte;
    sswub(src_copy[112,16],ubyte);
    XmmReg1[120,8] = ubyte;
}

:PABSB             XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x1c; XmmReg1 ... & XmmReg2_m128
{
    local src:16 = XmmReg2_m128;
    XmmReg1[0,8] = (zext(src[0,8] s< 0) * (0 - src[0,8])) | (zext(!(src[0,8] s< 0)) * src[0,8]);
    XmmReg1[8,8] = (zext(src[8,8] s< 0) * (0 - src[8,8])) | (zext(!(src[8,8] s< 0)) * src[8,8]);
    XmmReg1[16,8] = (zext(src[16,8] s< 0) * (0 - src[16,8])) | (zext(!(src[16,8] s< 0)) * src[16,8]);
    XmmReg1[24,8] = (zext(src[24,8] s< 0) * (0 - src[24,8])) | (zext(!(src[24,8] s< 0)) * src[24,8]);
    XmmReg1[32,8] = (zext(src[32,8] s< 0) * (0 - src[32,8])) | (zext(!(src[32,8] s< 0)) * src[32,8]);
    XmmReg1[40,8] = (zext(src[40,8] s< 0) * (0 - src[40,8])) | (zext(!(src[40,8] s< 0)) * src[40,8]);
    XmmReg1[48,8] = (zext(src[48,8] s< 0) * (0 - src[48,8])) | (zext(!(src[48,8] s< 0)) * src[48,8]);
    XmmReg1[56,8] = (zext(src[56,8] s< 0) * (0 - src[56,8])) | (zext(!(src[56,8] s< 0)) * src[56,8]);
    XmmReg1[64,8] = (zext(src[64,8] s< 0) * (0 - src[64,8])) | (zext(!(src[64,8] s< 0)) * src[64,8]);
    XmmReg1[72,8] = (zext(src[72,8] s< 0) * (0 - src[72,8])) | (zext(!(src[72,8] s< 0)) * src[72,8]);
    XmmReg1[80,8] = (zext(src[80,8] s< 0) * (0 - src[80,8])) | (zext(!(src[80,8] s< 0)) * src[80,8]);
    XmmReg1[88,8] = (zext(src[88,8] s< 0) * (0 - src[88,8])) | (zext(!(src[88,8] s< 0)) * src[88,8]);
    XmmReg1[96,8] = (zext(src[96,8] s< 0) * (0 - src[96,8])) | (zext(!(src[96,8] s< 0)) * src[96,8]);
    XmmReg1[104,8] = (zext(src[104,8] s< 0) * (0 - src[104,8])) | (zext(!(src[104,8] s< 0)) * src[104,8]);
    XmmReg1[112,8] = (zext(src[112,8] s< 0) * (0 - src[112,8])) | (zext(!(src[112,8] s< 0)) * src[112,8]);
    XmmReg1[120,8] = (zext(src[120,8] s< 0) * (0 - src[120,8])) | (zext(!(src[120,8] s< 0)) * src[120,8]);
}

:PABSW             XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x1d; XmmReg1 ... & XmmReg2_m128
{
    local src:16 = XmmReg2_m128;
    XmmReg1[0,16] = (zext(src[0,16] s< 0) * (0 - src[0,16])) | (zext(!(src[0,16] s< 0)) * src[0,16]);
    XmmReg1[16,16] = (zext(src[16,16] s< 0) * (0 - src[16,16])) | (zext(!(src[16,16] s< 0)) * src[16,16]);
    XmmReg1[32,16] = (zext(src[32,16] s< 0) * (0 - src[32,16])) | (zext(!(src[32,16] s< 0)) * src[32,16]);
    XmmReg1[48,16] = (zext(src[48,16] s< 0) * (0 - src[48,16])) | (zext(!(src[48,16] s< 0)) * src[48,16]);
    XmmReg1[64,16] = (zext(src[64,16] s< 0) * (0 - src[64,16])) | (zext(!(src[64,16] s< 0)) * src[64,16]);
    XmmReg1[80,16] = (zext(src[80,16] s< 0) * (0 - src[80,16])) | (zext(!(src[80,16] s< 0)) * src[80,16]);
    XmmReg1[96,16] = (zext(src[96,16] s< 0) * (0 - src[96,16])) | (zext(!(src[96,16] s< 0)) * src[96,16]);
    XmmReg1[112,16] = (zext(src[112,16] s< 0) * (0 - src[112,16])) | (zext(!(src[112,16] s< 0)) * src[112,16]);
}

:PABSD             XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x1e; XmmReg1 ... & XmmReg2_m128
{
    local src:16 = XmmReg2_m128;
    XmmReg1[0,32] = (zext(src[0,32] s< 0) * (0 - src[0,32])) | (zext(!(src[0,32] s< 0)) * src[0,32]);
    XmmReg1[32,32] = (zext(src[32,32] s< 0) * (0 - src[32,32])) | (zext(!(src[32,32] s< 0)) * src[32,32]);
    XmmReg1[64,32] = (zext(src[64,32] s< 0) * (0 - src[64,32])) | (zext(!(src[64,32] s< 0)) * src[64,32]);
    XmmReg1[96,32] = (zext(src[96,32] s< 0) * (0 - src[96,32])) | (zext(!(src[96,32] s< 0)) * src[96,32]);
}

:PADDB               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xFC; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,8] = XmmReg1[0,8] + m[0,8];
    XmmReg1[8,8] = XmmReg1[8,8] + m[8,8];
    XmmReg1[16,8] = XmmReg1[16,8] + m[16,8];
    XmmReg1[24,8] = XmmReg1[24,8] + m[24,8];
    XmmReg1[32,8] = XmmReg1[32,8] + m[32,8];
    XmmReg1[40,8] = XmmReg1[40,8] + m[40,8];
    XmmReg1[48,8] = XmmReg1[48,8] + m[48,8];
    XmmReg1[56,8] = XmmReg1[56,8] + m[56,8];
    XmmReg1[64,8] = XmmReg1[64,8] + m[64,8];
    XmmReg1[72,8] = XmmReg1[72,8] + m[72,8];
    XmmReg1[80,8] = XmmReg1[80,8] + m[80,8];
    XmmReg1[88,8] = XmmReg1[88,8] + m[88,8];
    XmmReg1[96,8] = XmmReg1[96,8] + m[96,8];
    XmmReg1[104,8] = XmmReg1[104,8] + m[104,8];
    XmmReg1[112,8] = XmmReg1[112,8] + m[112,8];
    XmmReg1[120,8] = XmmReg1[120,8] + m[120,8];
}

# full set of XMM byte registers
:PADDW               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xFD; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,16] = XmmReg1[0,16] + m[0,16];
    XmmReg1[16,16] = XmmReg1[16,16] + m[16,16];
    XmmReg1[32,16] = XmmReg1[32,16] + m[32,16];
    XmmReg1[48,16] = XmmReg1[48,16] + m[48,16];
    XmmReg1[64,16] = XmmReg1[64,16] + m[64,16];
    XmmReg1[80,16] = XmmReg1[80,16] + m[80,16];
    XmmReg1[96,16] = XmmReg1[96,16] + m[96,16];
    XmmReg1[112,16] = XmmReg1[112,16] + m[112,16];
}

:PADDD               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xFE; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = XmmReg1[0,32] + m[0,32];
    XmmReg1[32,32] = XmmReg1[32,32] + m[32,32];
    XmmReg1[64,32] = XmmReg1[64,32] + m[64,32];
    XmmReg1[96,32] = XmmReg1[96,32] + m[96,32];
}

:PADDQ               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xD4; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = XmmReg1[0,64] + m[0,64];
    XmmReg1[64,64] = XmmReg1[64,64] + m[64,64];
}

:PADDSB         XmmReg1, XmmReg2_m128      is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xEC; XmmReg1 ... & XmmReg2_m128 { XmmReg1 = paddsb(XmmReg1, XmmReg2_m128); }

:PADDSW         XmmReg1, XmmReg2_m128      is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xED; XmmReg1 ... & XmmReg2_m128 { XmmReg1 = paddsw(XmmReg1, XmmReg2_m128); }

:PADDUSB        XmmReg1, XmmReg2_m128      is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xDC; XmmReg1 ... & XmmReg2_m128 { XmmReg1 = paddusb(XmmReg1, XmmReg2_m128); }

:PADDUSW        XmmReg1, XmmReg2_m128      is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xDD; XmmReg1 ... & XmmReg2_m128 { XmmReg1 = paddusw(XmmReg1, XmmReg2_m128); }

:PALIGNR        XmmReg1, m128, imm8     is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x3A; byte=0x0F; m128 & XmmReg1 ...; imm8
{
    # 256-bit intermediate shifted by `imm8 * 8`, on 128-bit halves: the low
    # half is the source, the high half the destination. A shift of 16 to 31
    # bytes reads only the destination, 32 or more yields zero.
    local n:1 = imm8:1;
    local bits:2 = zext(n) * 8;
    local src:16 = m128;
    local dst:16 = XmmReg1;
    local low:16 = (src >> bits) | (dst << (128:2 - bits));
    local high:16 = dst >> (bits - 128:2);
    local r:16;
    conditionalAssign(r, n < 16, low, high);
    conditionalAssign(r, n >= 32, 0:16, r);
    XmmReg1 = r;
}

:PALIGNR        XmmReg1, XmmReg2, imm8  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x3A; byte=0x0F; xmmmod=3 & XmmReg1 & XmmReg2; imm8
{
    # 256-bit intermediate shifted by `imm8 * 8`, on 128-bit halves: the low
    # half is the source, the high half the destination. A shift of 16 to 31
    # bytes reads only the destination, 32 or more yields zero.
    local n:1 = imm8:1;
    local bits:2 = zext(n) * 8;
    local src:16 = XmmReg2;
    local dst:16 = XmmReg1;
    local low:16 = (src >> bits) | (dst << (128:2 - bits));
    local high:16 = dst >> (bits - 128:2);
    local r:16;
    conditionalAssign(r, n < 16, low, high);
    conditionalAssign(r, n >= 32, 0:16, r);
    XmmReg1 = r;
}

:PAND               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xDB; XmmReg1 ... & XmmReg2_m128
{ XmmReg1 = XmmReg1 & XmmReg2_m128; }

:PANDN              XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xDF; XmmReg1 ... & XmmReg2_m128
{ XmmReg1 = ~XmmReg1 & XmmReg2_m128; }

:PAVGB               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xE0; XmmReg1 ... & XmmReg2_m128
{
