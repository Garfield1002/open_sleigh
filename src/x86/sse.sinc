}

@endif
:DIVPD            XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x5E; XmmReg1 ... & XmmReg2_m128
{ divpd128(XmmReg1, XmmReg2_m128); }

:DIVPS            XmmReg1, XmmReg2_m128  is vexMode=0 & mandover=0 & byte=0x0F; byte=0x5E; XmmReg1 ... & XmmReg2_m128
{ divps128(XmmReg1, XmmReg2_m128); }

:DIVSD        XmmReg, m64      is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x5E; m64 & XmmReg ...
{
    XmmReg[0,64] = XmmReg[0,64] f/ m64;
}

:DIVSD        XmmReg1, XmmReg2 is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x5E; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,64] = XmmReg1[0,64] f/ XmmReg2[0,64];
}

:DIVSS        XmmReg, m32      is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x5E; m32 & XmmReg ...
{
    XmmReg[0,32] = XmmReg[0,32] f/ m32;
}

:DIVSS        XmmReg1, XmmReg2 is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x5E; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,32] = XmmReg1[0,32] f/ XmmReg2[0,32];
}

:HADDPD               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x7C; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = XmmReg1[0,64] f+ XmmReg1[64,64];
    XmmReg1[64,64] = m[0,64]   f+ m[64,64];
}

:HADDPS               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0x7C; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = XmmReg1[0,32] f+ XmmReg1[32,32];
    XmmReg1[32,32] = XmmReg1[64,32] f+ XmmReg1[96,32];
    XmmReg1[64,32] = m[0,32]   f+ m[32,32];
    XmmReg1[96,32] = m[64,32]   f+ m[96,32];
}

:HSUBPD               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x7D; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = XmmReg1[0,64] f- XmmReg1[64,64];
    XmmReg1[64,64] = m[0,64]   f- m[64,64];
}

:HSUBPS               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0x7D; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = XmmReg1[0,32] f- XmmReg1[32,32];
    XmmReg1[32,32] = XmmReg1[64,32] f- XmmReg1[96,32];
    XmmReg1[64,32] = m[0,32]   f- m[32,32];
    XmmReg1[96,32] = m[64,32]   f- m[96,32];
}

:LDDQU        XmmReg, m128        is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0xF0; XmmReg ... & m128 { XmmReg = lddqu(XmmReg, m128); }

# The 128-bit masked store. Like MASKMOVQ this writes DS:[rDI] rather than the
# register, and leaves the source alone. No hardware capture covers it yet, so
# it follows MASKMOVQ's validated shape rather than being confirmed directly.
:MASKMOVDQU        XmmReg1, XmmReg2   is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0xF7; XmmReg1 & XmmReg2 & maskmovDI
{
    local data:16 = XmmReg1;
    local mask:16 = XmmReg2;
    local address:8 = maskmovDI;
    maskmov_byte(data[  0,8], mask[  7,1], address, 0);
    maskmov_byte(data[  8,8], mask[ 15,1], address, 1);
    maskmov_byte(data[ 16,8], mask[ 23,1], address, 2);
    maskmov_byte(data[ 24,8], mask[ 31,1], address, 3);
    maskmov_byte(data[ 32,8], mask[ 39,1], address, 4);
    maskmov_byte(data[ 40,8], mask[ 47,1], address, 5);
    maskmov_byte(data[ 48,8], mask[ 55,1], address, 6);
    maskmov_byte(data[ 56,8], mask[ 63,1], address, 7);
    maskmov_byte(data[ 64,8], mask[ 71,1], address, 8);
    maskmov_byte(data[ 72,8], mask[ 79,1], address, 9);
    maskmov_byte(data[ 80,8], mask[ 87,1], address, 10);
    maskmov_byte(data[ 88,8], mask[ 95,1], address, 11);
    maskmov_byte(data[ 96,8], mask[103,1], address, 12);
    maskmov_byte(data[104,8], mask[111,1], address, 13);
    maskmov_byte(data[112,8], mask[119,1], address, 14);
    maskmov_byte(data[120,8], mask[127,1], address, 15);
}

:MAXPD               XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x5F; XmmReg1 ... & XmmReg2_m128
{ maxpd128(XmmReg1, XmmReg2_m128); }

:MAXPS               XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x5F; XmmReg1 ... & XmmReg2_m128
{ maxps128(XmmReg1, XmmReg2_m128); }

:MAXSD        XmmReg, m64         is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0x5F; XmmReg ... & m64
{
    local tmp:8 = m64;
    if (tmp f< XmmReg[0,64]) goto inst_next;
    XmmReg[0,64] = tmp;
}

:MAXSD        XmmReg1, XmmReg2    is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0x5F; xmmmod=3 & XmmReg1 & XmmReg2
{
    if (XmmReg2[0,64] f< XmmReg1[0,64]) goto inst_next;
    XmmReg1[0,64] = XmmReg2[0,64];
}

:MAXSS        XmmReg, m32         is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x5F; XmmReg ... & m32
{
    local tmp:4 = m32;
    if (tmp f< XmmReg[0,32]) goto inst_next;
    XmmReg[0,32] = tmp;
}

:MAXSS        XmmReg1, XmmReg2    is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x5F; xmmmod=3 & XmmReg1 & XmmReg2
{
    if (XmmReg2[0,32] f< XmmReg1[0,32]) goto inst_next;
    XmmReg1[0,32] = XmmReg2[0,32];
}

