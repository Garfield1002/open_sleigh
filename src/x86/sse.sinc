    XmmReg1[0,32] = zext(XmmReg1[0,32] s> m[0,32]) * 0xFFFFFFFF;
    XmmReg1[32,32] = zext(XmmReg1[32,32] s> m[32,32]) * 0xFFFFFFFF;
    XmmReg1[64,32] = zext(XmmReg1[64,32] s> m[64,32]) * 0xFFFFFFFF;
