# The SSE unit through SSE4.2 and the AES/PCLMUL-era crypto forms: every
# constructor with an XMM operand, the user-ops and macros only they use, and
# MXCSR. The XMM register file, the XmmReg operand subtables and the lane
# macros the MMX forms share are defined in ia.sinc, which must be included
# first; the AVX files reuse the same operands and come after.

define pcodeop lddqu;

define pcodeop movdq2q;

define pcodeop movmskpd;

define pcodeop movmskps;

define pcodeop pabsb;

define pcodeop pabsw;

define pcodeop pabsd;

define pcodeop paddusw;

define pcodeop phaddd;

define pcodeop phaddw;

define pcodeop phaddsw;

define pcodeop phsubd;

define pcodeop phsubw;

define pcodeop phsubsw;

define pcodeop pmaddubsw;

define pcodeop pmulhrsw;

define pcodeop pshufb;

define pcodeop psignb;

define pcodeop psignw;

define pcodeop psignd;

define pcodeop rcpps;

define pcodeop rcpss;

define pcodeop rsqrtps;

define pcodeop rsqrtss;

define pcodeop mpsadbw;

define pcodeop phminposuw;

define pcodeop pmuldq;

define pcodeop pmulld;

define pcodeop dpps;

define pcodeop dppd;

define pcodeop blendps;

define pcodeop blendpd;

define pcodeop blendvps;

define pcodeop blendvpd;

define pcodeop pblendvb;

define pcodeop pblendw;

define pcodeop roundps;

define pcodeop roundss;

define pcodeop roundpd;

define pcodeop roundsd;

define pcodeop insertps;

define pcodeop extractps;

define pcodeop pmovsxbw;

define pcodeop pmovsxbd;

define pcodeop pmovsxbq;

define pcodeop pmovsxwd;

define pcodeop pmovsxwq;

define pcodeop pmovsxdq;

define pcodeop pmovzxbw;

define pcodeop pmovzxbd;

define pcodeop pmovzxbq;

define pcodeop pmovzxwd;

define pcodeop pmovzxwq;

define pcodeop pmovzxdq;

define pcodeop packusdw;

define pcodeop movntdqa;

define pcodeop pcmpestri;

define pcodeop pcmpestrm;

define pcodeop pcmpistri;

define pcodeop pcmpistrm;

define pcodeop aesdec;

define pcodeop aesdeclast;

define pcodeop aesenc;

define pcodeop aesenclast;

define pcodeop aesimc;

define pcodeop aeskeygenassist;


# floating point NaN comparison into EFLAGS
macro fucompe(val1, val2) {
    PF = nan(val1) || nan(val2 );
    ZF = PF | ( val1 f== val2 );
    CF = PF | ( val1 f< val2 );    
 
    OF = 0;
    AF = 0;
    SF = 0;
}

# The packed float operations are lifted lane by lane in p-code. MXCSR
# rounding and exception flags are deliberately not modelled.
macro divpd128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    dst[  0,64] = a[  0,64] f/ b[  0,64];
    dst[ 64,64] = a[ 64,64] f/ b[ 64,64];
}

macro divps128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    dst[  0,32] = a[  0,32] f/ b[  0,32];
    dst[ 32,32] = a[ 32,32] f/ b[ 32,32];
    dst[ 64,32] = a[ 64,32] f/ b[ 64,32];
    dst[ 96,32] = a[ 96,32] f/ b[ 96,32];
}

# SSE MIN returns its second operand whenever either operand is a NaN or both
# operands are zero of either sign, and the smaller operand otherwise; MAX is
# symmetric. An ordered `f<` is false in exactly the return-the-second-operand
# cases, so one comparison per lane selects the source, and the lane is moved
# bit-for-bit so that a NaN payload survives unchanged.
macro maxpd128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    local pick0:8 = 0 - zext(b[  0,64] f< a[  0,64]);
    dst[  0,64] = (a[  0,64] & pick0) | (b[  0,64] & (~pick0));
    local pick1:8 = 0 - zext(b[ 64,64] f< a[ 64,64]);
    dst[ 64,64] = (a[ 64,64] & pick1) | (b[ 64,64] & (~pick1));
}

macro maxps128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    local pick0:4 = 0 - zext(b[  0,32] f< a[  0,32]);
    dst[  0,32] = (a[  0,32] & pick0) | (b[  0,32] & (~pick0));
    local pick1:4 = 0 - zext(b[ 32,32] f< a[ 32,32]);
    dst[ 32,32] = (a[ 32,32] & pick1) | (b[ 32,32] & (~pick1));
    local pick2:4 = 0 - zext(b[ 64,32] f< a[ 64,32]);
    dst[ 64,32] = (a[ 64,32] & pick2) | (b[ 64,32] & (~pick2));
    local pick3:4 = 0 - zext(b[ 96,32] f< a[ 96,32]);
    dst[ 96,32] = (a[ 96,32] & pick3) | (b[ 96,32] & (~pick3));
}

macro minpd128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    local pick0:8 = 0 - zext(a[  0,64] f< b[  0,64]);
    dst[  0,64] = (a[  0,64] & pick0) | (b[  0,64] & (~pick0));
    local pick1:8 = 0 - zext(a[ 64,64] f< b[ 64,64]);
    dst[ 64,64] = (a[ 64,64] & pick1) | (b[ 64,64] & (~pick1));
}

macro minps128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    local pick0:4 = 0 - zext(a[  0,32] f< b[  0,32]);
    dst[  0,32] = (a[  0,32] & pick0) | (b[  0,32] & (~pick0));
    local pick1:4 = 0 - zext(a[ 32,32] f< b[ 32,32]);
    dst[ 32,32] = (a[ 32,32] & pick1) | (b[ 32,32] & (~pick1));
    local pick2:4 = 0 - zext(a[ 64,32] f< b[ 64,32]);
    dst[ 64,32] = (a[ 64,32] & pick2) | (b[ 64,32] & (~pick2));
    local pick3:4 = 0 - zext(a[ 96,32] f< b[ 96,32]);
    dst[ 96,32] = (a[ 96,32] & pick3) | (b[ 96,32] & (~pick3));
}

macro packsswb_xmm(dst, src) {
	# A bit range passed as a macro output parameter is an rvalue, so the
	# assignment inside the saturating macro lands on a discarded
	# temporary and the lane is never written. Saturate into a local.
	local a:16 = dst;
	local lane:1;
	local b:16 = src;

	sswsb(a[  0,16], lane);	dst[0,8] = lane;
	sswsb(a[ 16,16], lane);	dst[8,8] = lane;
	sswsb(a[ 32,16], lane);	dst[16,8] = lane;
	sswsb(a[ 48,16], lane);	dst[24,8] = lane;
	sswsb(a[ 64,16], lane);	dst[32,8] = lane;
	sswsb(a[ 80,16], lane);	dst[40,8] = lane;
	sswsb(a[ 96,16], lane);	dst[48,8] = lane;
	sswsb(a[112,16], lane);	dst[56,8] = lane;

	sswsb(b[  0,16], lane);	dst[64,8] = lane;
	sswsb(b[ 16,16], lane);	dst[72,8] = lane;
	sswsb(b[ 32,16], lane);	dst[80,8] = lane;
	sswsb(b[ 48,16], lane);	dst[88,8] = lane;
	sswsb(b[ 64,16], lane);	dst[96,8] = lane;
	sswsb(b[ 80,16], lane);	dst[104,8] = lane;
	sswsb(b[ 96,16], lane);	dst[112,8] = lane;
	sswsb(b[112,16], lane);	dst[120,8] = lane;
}

macro packssdw_xmm(dst, src) {
	# A bit range passed as a macro output parameter is an rvalue, so the
	# assignment inside the saturating macro lands on a discarded
	# temporary and the lane is never written. Saturate into a local.
	local a:16 = dst;
	local lane:2;
	local b:16 = src;

	ssdsw(a[ 0,32], lane);	dst[0,16] = lane;
	ssdsw(a[32,32], lane);	dst[16,16] = lane;
	ssdsw(a[64,32], lane);	dst[32,16] = lane;
	ssdsw(a[96,32], lane);	dst[48,16] = lane;

	ssdsw(b[ 0,32], lane);	dst[64,16] = lane;
	ssdsw(b[32,32], lane);	dst[80,16] = lane;
	ssdsw(b[64,32], lane);	dst[96,16] = lane;
	ssdsw(b[96,32], lane);	dst[112,16] = lane;
}

macro pmulhw128(xmm1, xmm2) {
	local tmp0:8 = sext(xmm1[  0,16]) * sext(xmm2[  0,16]);
    xmm1[  0,16] = tmp0[16,16];
	local tmp1:8 = sext(xmm1[ 16,16]) * sext(xmm2[ 16,16]);
    xmm1[ 16,16] = tmp1[16,16];
	local tmp2:8 = sext(xmm1[ 32,16]) * sext(xmm2[ 32,16]);
    xmm1[ 32,16] = tmp2[16,16];
	local tmp3:8 = sext(xmm1[ 48,16]) * sext(xmm2[ 48,16]);
    xmm1[ 48,16] = tmp3[16,16];
	local tmp4:8 = sext(xmm1[ 64,16]) * sext(xmm2[ 64,16]);
    xmm1[ 64,16] = tmp4[16,16];
	local tmp5:8 = sext(xmm1[ 80,16]) * sext(xmm2[ 80,16]);
    xmm1[ 80,16] = tmp5[16,16];
	local tmp6:8 = sext(xmm1[ 96,16]) * sext(xmm2[ 96,16]);
    xmm1[ 96,16] = tmp6[16,16];
	local tmp7:8 = sext(xmm1[112,16]) * sext(xmm2[112,16]);
    xmm1[112,16] = tmp7[16,16];
}

# The XMM form is two independent MMX-shaped halves: each 64-bit half becomes
# the 16-bit sum of its eight absolute byte differences, zero extended.
macro psadbw_xmm(dst, src) {
    local left:16 = dst;
    local right:16 = src;
    local lo:8 = left[0,64];
    local rlo:8 = right[0,64];
    psadbw_mmx(lo, rlo);
    local hi:8 = left[64,64];
    local rhi:8 = right[64,64];
    psadbw_mmx(hi, rhi);
    dst[0,64] = lo;
    dst[64,64] = hi;
}

macro shuffle_4(dest,ord,c0,c1,c2,c3){
    dest = zext(ord == 0) * c0 + zext(ord == 1) * c1 + zext(ord == 2) * c2 + zext(ord == 3) * c3;
}

# The SSE shift-by-count forms take a single 64-bit count from the low quadword
# of the source operand -- it is not a per-lane count -- and a count at or
# beyond the lane width produces an all-zero lane (an all-sign-bits lane for an
# arithmetic shift). Clamp the count to the lane width the way the MMX macros
# above do, so that SLEIGH's narrowing of the count to the lane width cannot
# silently wrap an oversized count.
macro psllw128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    xmm[  0,16] = xmm[  0,16] << amount;
    xmm[ 16,16] = xmm[ 16,16] << amount;
    xmm[ 32,16] = xmm[ 32,16] << amount;
    xmm[ 48,16] = xmm[ 48,16] << amount;
    xmm[ 64,16] = xmm[ 64,16] << amount;
    xmm[ 80,16] = xmm[ 80,16] << amount;
    xmm[ 96,16] = xmm[ 96,16] << amount;
    xmm[112,16] = xmm[112,16] << amount;
}

macro pslld128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    xmm[  0,32] = xmm[  0,32] << amount;
    xmm[ 32,32] = xmm[ 32,32] << amount;
    xmm[ 64,32] = xmm[ 64,32] << amount;
    xmm[ 96,32] = xmm[ 96,32] << amount;
}

macro psllq128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 63);
    local amount:8 = (n & (over - 1)) | (over * 64);
    xmm[  0,64] = xmm[  0,64] << amount;
    xmm[ 64,64] = xmm[ 64,64] << amount;
}

macro psrlw128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    xmm[  0,16] = xmm[  0,16] >> amount;
    xmm[ 16,16] = xmm[ 16,16] >> amount;
    xmm[ 32,16] = xmm[ 32,16] >> amount;
    xmm[ 48,16] = xmm[ 48,16] >> amount;
    xmm[ 64,16] = xmm[ 64,16] >> amount;
    xmm[ 80,16] = xmm[ 80,16] >> amount;
    xmm[ 96,16] = xmm[ 96,16] >> amount;
    xmm[112,16] = xmm[112,16] >> amount;
}

macro psrld128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    xmm[  0,32] = xmm[  0,32] >> amount;
    xmm[ 32,32] = xmm[ 32,32] >> amount;
    xmm[ 64,32] = xmm[ 64,32] >> amount;
    xmm[ 96,32] = xmm[ 96,32] >> amount;
}

macro psrlq128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 63);
    local amount:8 = (n & (over - 1)) | (over * 64);
    xmm[  0,64] = xmm[  0,64] >> amount;
    xmm[ 64,64] = xmm[ 64,64] >> amount;
}

macro psraw128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    xmm[  0,16] = xmm[  0,16] s>> amount;
    xmm[ 16,16] = xmm[ 16,16] s>> amount;
    xmm[ 32,16] = xmm[ 32,16] s>> amount;
    xmm[ 48,16] = xmm[ 48,16] s>> amount;
    xmm[ 64,16] = xmm[ 64,16] s>> amount;
    xmm[ 80,16] = xmm[ 80,16] s>> amount;
    xmm[ 96,16] = xmm[ 96,16] s>> amount;
    xmm[112,16] = xmm[112,16] s>> amount;
}

macro psrad128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    xmm[  0,32] = xmm[  0,32] s>> amount;
    xmm[ 32,32] = xmm[ 32,32] s>> amount;
    xmm[ 64,32] = xmm[ 64,32] s>> amount;
    xmm[ 96,32] = xmm[ 96,32] s>> amount;
}

macro sqrtpd128(dst, src) {
    local b:16 = src;
    dst[  0,64] = sqrt(b[  0,64]);
    dst[ 64,64] = sqrt(b[ 64,64]);
}

macro sqrtps128(dst, src) {
    local b:16 = src;
    dst[  0,32] = sqrt(b[  0,32]);
    dst[ 32,32] = sqrt(b[ 32,32]);
    dst[ 64,32] = sqrt(b[ 64,32]);
    dst[ 96,32] = sqrt(b[ 96,32]);
}


with : lockprefx=0 {

#@family sse
:LDMXCSR m32		is vexMode=0 & byte=0xf; byte=0xae; ( mod != 0b11 & reg_opcode=2 ) ... & m32 { MXCSR = m32; }

:STMXCSR m32        is vexMode=0 & byte=0xf; byte=0xae; ( mod != 0b11 & reg_opcode=3 ) ... & m32 { m32 = MXCSR; }

:ADDPD        XmmReg, m128     is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x58; XmmReg ... & m128
{
    XmmReg[0,64]  = XmmReg[0,64]  f+ m128[0,64];
    XmmReg[64,64] = XmmReg[64,64] f+ m128[64,64];
}

:ADDPD        XmmReg1, XmmReg2 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x58; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,64]  = XmmReg1[0,64]  f+ XmmReg2[0,64];
    XmmReg1[64,64] = XmmReg1[64,64] f+ XmmReg2[64,64];
}

:ADDPS        XmmReg, m128     is vexMode=0 & mandover=0 & byte=0x0F; byte=0x58; m128 & XmmReg ...
{
    local m:16 = m128;	# Guarantee value is in a fixed location
    XmmReg[0,32] = XmmReg[0,32] f+ m[0,32];
    XmmReg[32,32] = XmmReg[32,32] f+ m[32,32];
    XmmReg[64,32] = XmmReg[64,32] f+ m[64,32];
    XmmReg[96,32] = XmmReg[96,32] f+ m[96,32];
}

:ADDPS        XmmReg1, XmmReg2 is vexMode=0 & mandover=0 & byte=0x0F; byte=0x58; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,32] = XmmReg1[0,32] f+ XmmReg2[0,32];
    XmmReg1[32,32] = XmmReg1[32,32] f+ XmmReg2[32,32];
    XmmReg1[64,32] = XmmReg1[64,32] f+ XmmReg2[64,32];
    XmmReg1[96,32] = XmmReg1[96,32] f+ XmmReg2[96,32];
}

:ADDSD        XmmReg, m64      is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x58; m64 & XmmReg ...
{
    XmmReg[0,64] = XmmReg[0,64] f+ m64;
}

:ADDSD        XmmReg1, XmmReg2 is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x58; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,64] = XmmReg1[0,64] f+ XmmReg2[0,64];
}

:ADDSS        XmmReg, m32      is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x58; m32 & XmmReg ...
{
    XmmReg[0,32] = XmmReg[0,32] f+ m32;
}

:ADDSS        XmmReg1, XmmReg2 is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x58; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,32] = XmmReg1[0,32] f+ XmmReg2[0,32];
}

:ADDSUBPD     XmmReg, m128     is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0xD0; m128 & XmmReg ...
{
    local m:16 = m128;
    XmmReg[0,64] = XmmReg[0,64] f- m[0,64];
    XmmReg[64,64] = XmmReg[64,64] f+ m[64,64];
}

:ADDSUBPD     XmmReg1, XmmReg2 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0xD0; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,64] = XmmReg1[0,64] f- XmmReg2[0,64];
    XmmReg1[64,64] = XmmReg1[64,64] f+ XmmReg2[64,64];
}

:ADDSUBPS     XmmReg, m128     is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0xD0; m128 & XmmReg ...
{
    local m:16 = m128;
    XmmReg[0,32] = XmmReg[0,32] f- m[0,32];
    XmmReg[32,32] = XmmReg[32,32] f+ m[32,32];
    XmmReg[64,32] = XmmReg[64,32] f- m[64,32];
    XmmReg[96,32] = XmmReg[96,32] f+ m[96,32];
}

:ADDSUBPS     XmmReg1, XmmReg2 is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0xD0; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,32] = XmmReg1[0,32] f- XmmReg2[0,32];
    XmmReg1[32,32] = XmmReg1[32,32] f+ XmmReg2[32,32];
    XmmReg1[64,32] = XmmReg1[64,32] f- XmmReg2[64,32];
    XmmReg1[96,32] = XmmReg1[96,32] f+ XmmReg2[96,32];
}

# special FLOATING POINT bitwise AND
:ANDPD  XmmReg, m128     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x54; m128 & XmmReg ...
{
    local m:16 = m128;
    XmmReg[0,64] = XmmReg[0,64] & m[0,64];
    XmmReg[64,64] = XmmReg[64,64] & m[64,64];
}

# special FLOATING POINT bitwise AND
:ANDPD  XmmReg1, XmmReg2 is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x54; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,64] = XmmReg1[0,64] & XmmReg2[0,64];
    XmmReg1[64,64] = XmmReg1[64,64] & XmmReg2[64,64];
}

# special FLOATING POINT bitwise AND
:ANDPS        XmmReg, m128     is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x54; m128 & XmmReg ...
{
    local m:16 = m128;
    XmmReg[0,32] = XmmReg[0,32] & m[0,32];
    XmmReg[32,32] = XmmReg[32,32] & m[32,32];
    XmmReg[64,32] = XmmReg[64,32] & m[64,32];
    XmmReg[96,32] = XmmReg[96,32] & m[96,32];
}

# special FLOATING POINT bitwise AND
:ANDPS        XmmReg1, XmmReg2 is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x54; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,32] = XmmReg1[0,32] & XmmReg2[0,32];
    XmmReg1[32,32] = XmmReg1[32,32] & XmmReg2[32,32];
    XmmReg1[64,32] = XmmReg1[64,32] & XmmReg2[64,32];
    XmmReg1[96,32] = XmmReg1[96,32] & XmmReg2[96,32];
}

# special FLOATING POINT bitwise AND NOT
:ANDNPD       XmmReg, m128     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x55; m128 & XmmReg ...
{
    local m:16 = m128;
    XmmReg[0,64] = ~XmmReg[0,64] & m[0,64];
    XmmReg[64,64] = ~XmmReg[64,64] & m[64,64];
}

:ANDNPD       XmmReg1, XmmReg2 is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x55; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,64] = ~XmmReg1[0,64] & XmmReg2[0,64];
    XmmReg1[64,64] = ~XmmReg1[64,64] & XmmReg2[64,64];
}

# special FLOATING POINT bitwise AND NOT
:ANDNPS       XmmReg, m128     is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x55; m128 & XmmReg ...
{
    local m:16 = m128;
    XmmReg[0,32] = ~XmmReg[0,32] & m[0,32];
    XmmReg[32,32] = ~XmmReg[32,32] & m[32,32];
    XmmReg[64,32] = ~XmmReg[64,32] & m[64,32];
    XmmReg[96,32] = ~XmmReg[96,32] & m[96,32];
}

:ANDNPS       XmmReg1, XmmReg2 is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x55; xmmmod=3 & XmmReg1 & XmmReg2
{
    XmmReg1[0,32] = ~XmmReg1[0,32] & XmmReg2[0,32];
    XmmReg1[32,32] = ~XmmReg1[32,32] & XmmReg2[32,32];
