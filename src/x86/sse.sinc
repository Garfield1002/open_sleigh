:PHMINPOSUW     XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x38; byte=0x41; XmmReg1 ... & XmmReg2_m128
{
    # Lowest unsigned word and its index, the first on ties.
    local s:16 = XmmReg2_m128;
    local min:2 = s[0,16];
    local idx:2 = 0;
    local less:1;
    less = s[16,16] < min;
    conditionalAssign(idx, less, 1:2, idx);
    conditionalAssign(min, less, s[16,16], min);
    less = s[32,16] < min;
    conditionalAssign(idx, less, 2:2, idx);
    conditionalAssign(min, less, s[32,16], min);
    less = s[48,16] < min;
    conditionalAssign(idx, less, 3:2, idx);
    conditionalAssign(min, less, s[48,16], min);
    less = s[64,16] < min;
    conditionalAssign(idx, less, 4:2, idx);
    conditionalAssign(min, less, s[64,16], min);
    less = s[80,16] < min;
    conditionalAssign(idx, less, 5:2, idx);
    conditionalAssign(min, less, s[80,16], min);
    less = s[96,16] < min;
    conditionalAssign(idx, less, 6:2, idx);
    conditionalAssign(min, less, s[96,16], min);
    less = s[112,16] < min;
    conditionalAssign(idx, less, 7:2, idx);
    conditionalAssign(min, less, s[112,16], min);
    XmmReg1 = zext(min) | (zext(idx) << 16);
}

