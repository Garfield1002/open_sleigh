    psllq128(XmmReg1, m[0,64]);
}

:PSLLQ           XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x73; mod = 0b11 & reg_opcode=6 & XmmReg2; imm8
{
