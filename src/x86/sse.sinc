:PMULHRSW           XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x0B; XmmReg1 ... & XmmReg2_m128
{
    local rsrc:16 = XmmReg2_m128;
    local rdst:16 = XmmReg1;
    local prod:4;
    local rounded:4;
    prod = sext(rdst[0,16]) * sext(rsrc[0,16]);
    rounded = ((prod s>> 14) + 1) s>> 1;
    XmmReg1[0,16] = rounded:2;
    prod = sext(rdst[16,16]) * sext(rsrc[16,16]);
    rounded = ((prod s>> 14) + 1) s>> 1;
    XmmReg1[16,16] = rounded:2;
    prod = sext(rdst[32,16]) * sext(rsrc[32,16]);
    rounded = ((prod s>> 14) + 1) s>> 1;
    XmmReg1[32,16] = rounded:2;
    prod = sext(rdst[48,16]) * sext(rsrc[48,16]);
    rounded = ((prod s>> 14) + 1) s>> 1;
    XmmReg1[48,16] = rounded:2;
    prod = sext(rdst[64,16]) * sext(rsrc[64,16]);
    rounded = ((prod s>> 14) + 1) s>> 1;
    XmmReg1[64,16] = rounded:2;
    prod = sext(rdst[80,16]) * sext(rsrc[80,16]);
    rounded = ((prod s>> 14) + 1) s>> 1;
    XmmReg1[80,16] = rounded:2;
    prod = sext(rdst[96,16]) * sext(rsrc[96,16]);
    rounded = ((prod s>> 14) + 1) s>> 1;
    XmmReg1[96,16] = rounded:2;
    prod = sext(rdst[112,16]) * sext(rsrc[112,16]);
    rounded = ((prod s>> 14) + 1) s>> 1;
    XmmReg1[112,16] = rounded:2;
}

