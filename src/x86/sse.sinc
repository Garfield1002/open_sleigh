:PSHUFD         XmmReg1, XmmReg2_m128, imm8     is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x70; (XmmReg2_m128 & XmmReg1 ...); imm8 & Order0 & Order1 & Order2 & Order3
{
    local c0 = XmmReg2_m128[0,32];
    local c1 = XmmReg2_m128[32,32];
    local c2 = XmmReg2_m128[64,32];
    local c3 = XmmReg2_m128[96,32];

    shuffle_4(XmmReg1[0,32],Order0,c0,c1,c2,c3);
    shuffle_4(XmmReg1[32,32],Order1,c0,c1,c2,c3);
    shuffle_4(XmmReg1[64,32],Order2,c0,c1,c2,c3);
    shuffle_4(XmmReg1[96,32],Order3,c0,c1,c2,c3);
}

# PSHUFHW shuffles the four high words through the two-bit fields of imm8 and
# copies the low quadword unchanged; PSHUFLW does the reverse. Like PSHUFW the
# selector is not a literal, so shift the half down by `selector * 16` instead
# of indexing a bit range, and copy the source first because the destination
# may alias it.
:PSHUFHW        XmmReg1, XmmReg2_m128, imm8     is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x70; XmmReg2_m128 & XmmReg1 ...; imm8
{
    local src:16 = XmmReg2_m128;
    local half:8 = src[64,64];
    local sel:8 = zext(imm8:1);
    local w0:8 = half >> ((sel & 3) * 16);
    local w1:8 = half >> (((sel >> 2) & 3) * 16);
    local w2:8 = half >> (((sel >> 4) & 3) * 16);
    local w3:8 = half >> (((sel >> 6) & 3) * 16);
    XmmReg1[0,64] = src[0,64];
    XmmReg1[64,16] = w0[0,16];
    XmmReg1[80,16] = w1[0,16];
    XmmReg1[96,16] = w2[0,16];
    XmmReg1[112,16] = w3[0,16];
}

:PSHUFLW        XmmReg1, XmmReg2_m128, imm8     is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x70; XmmReg2_m128 & XmmReg1 ...; imm8
{
    local src:16 = XmmReg2_m128;
    local half:8 = src[0,64];
    local sel:8 = zext(imm8:1);
    local w0:8 = half >> ((sel & 3) * 16);
    local w1:8 = half >> (((sel >> 2) & 3) * 16);
    local w2:8 = half >> (((sel >> 4) & 3) * 16);
    local w3:8 = half >> (((sel >> 6) & 3) * 16);
    XmmReg1[64,64] = src[64,64];
    XmmReg1[0,16] = w0[0,16];
    XmmReg1[16,16] = w1[0,16];
    XmmReg1[32,16] = w2[0,16];
    XmmReg1[48,16] = w3[0,16];
}

:PSIGNB             XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x08; XmmReg1 ... & XmmReg2_m128
{
    local psignsrc:16 = XmmReg2_m128;
    XmmReg1[0,8] = (zext(psignsrc[0,8] s< 0) * (0 - XmmReg1[0,8])) | (zext(psignsrc[0,8] s> 0) * XmmReg1[0,8]);
    XmmReg1[8,8] = (zext(psignsrc[8,8] s< 0) * (0 - XmmReg1[8,8])) | (zext(psignsrc[8,8] s> 0) * XmmReg1[8,8]);
    XmmReg1[16,8] = (zext(psignsrc[16,8] s< 0) * (0 - XmmReg1[16,8])) | (zext(psignsrc[16,8] s> 0) * XmmReg1[16,8]);
    XmmReg1[24,8] = (zext(psignsrc[24,8] s< 0) * (0 - XmmReg1[24,8])) | (zext(psignsrc[24,8] s> 0) * XmmReg1[24,8]);
    XmmReg1[32,8] = (zext(psignsrc[32,8] s< 0) * (0 - XmmReg1[32,8])) | (zext(psignsrc[32,8] s> 0) * XmmReg1[32,8]);
    XmmReg1[40,8] = (zext(psignsrc[40,8] s< 0) * (0 - XmmReg1[40,8])) | (zext(psignsrc[40,8] s> 0) * XmmReg1[40,8]);
    XmmReg1[48,8] = (zext(psignsrc[48,8] s< 0) * (0 - XmmReg1[48,8])) | (zext(psignsrc[48,8] s> 0) * XmmReg1[48,8]);
    XmmReg1[56,8] = (zext(psignsrc[56,8] s< 0) * (0 - XmmReg1[56,8])) | (zext(psignsrc[56,8] s> 0) * XmmReg1[56,8]);
    XmmReg1[64,8] = (zext(psignsrc[64,8] s< 0) * (0 - XmmReg1[64,8])) | (zext(psignsrc[64,8] s> 0) * XmmReg1[64,8]);
    XmmReg1[72,8] = (zext(psignsrc[72,8] s< 0) * (0 - XmmReg1[72,8])) | (zext(psignsrc[72,8] s> 0) * XmmReg1[72,8]);
    XmmReg1[80,8] = (zext(psignsrc[80,8] s< 0) * (0 - XmmReg1[80,8])) | (zext(psignsrc[80,8] s> 0) * XmmReg1[80,8]);
    XmmReg1[88,8] = (zext(psignsrc[88,8] s< 0) * (0 - XmmReg1[88,8])) | (zext(psignsrc[88,8] s> 0) * XmmReg1[88,8]);
    XmmReg1[96,8] = (zext(psignsrc[96,8] s< 0) * (0 - XmmReg1[96,8])) | (zext(psignsrc[96,8] s> 0) * XmmReg1[96,8]);
    XmmReg1[104,8] = (zext(psignsrc[104,8] s< 0) * (0 - XmmReg1[104,8])) | (zext(psignsrc[104,8] s> 0) * XmmReg1[104,8]);
    XmmReg1[112,8] = (zext(psignsrc[112,8] s< 0) * (0 - XmmReg1[112,8])) | (zext(psignsrc[112,8] s> 0) * XmmReg1[112,8]);
    XmmReg1[120,8] = (zext(psignsrc[120,8] s< 0) * (0 - XmmReg1[120,8])) | (zext(psignsrc[120,8] s> 0) * XmmReg1[120,8]);
}

:PSIGNW             XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x09; XmmReg1 ... & XmmReg2_m128
{
    local psignsrc:16 = XmmReg2_m128;
    XmmReg1[0,16] = (zext(psignsrc[0,16] s< 0) * (0 - XmmReg1[0,16])) | (zext(psignsrc[0,16] s> 0) * XmmReg1[0,16]);
    XmmReg1[16,16] = (zext(psignsrc[16,16] s< 0) * (0 - XmmReg1[16,16])) | (zext(psignsrc[16,16] s> 0) * XmmReg1[16,16]);
    XmmReg1[32,16] = (zext(psignsrc[32,16] s< 0) * (0 - XmmReg1[32,16])) | (zext(psignsrc[32,16] s> 0) * XmmReg1[32,16]);
    XmmReg1[48,16] = (zext(psignsrc[48,16] s< 0) * (0 - XmmReg1[48,16])) | (zext(psignsrc[48,16] s> 0) * XmmReg1[48,16]);
    XmmReg1[64,16] = (zext(psignsrc[64,16] s< 0) * (0 - XmmReg1[64,16])) | (zext(psignsrc[64,16] s> 0) * XmmReg1[64,16]);
    XmmReg1[80,16] = (zext(psignsrc[80,16] s< 0) * (0 - XmmReg1[80,16])) | (zext(psignsrc[80,16] s> 0) * XmmReg1[80,16]);
    XmmReg1[96,16] = (zext(psignsrc[96,16] s< 0) * (0 - XmmReg1[96,16])) | (zext(psignsrc[96,16] s> 0) * XmmReg1[96,16]);
    XmmReg1[112,16] = (zext(psignsrc[112,16] s< 0) * (0 - XmmReg1[112,16])) | (zext(psignsrc[112,16] s> 0) * XmmReg1[112,16]);
}

:PSIGND             XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x38; byte=0x0a; XmmReg1 ... & XmmReg2_m128
{
    local psignsrc:16 = XmmReg2_m128;
    XmmReg1[0,32] = (zext(psignsrc[0,32] s< 0) * (0 - XmmReg1[0,32])) | (zext(psignsrc[0,32] s> 0) * XmmReg1[0,32]);
    XmmReg1[32,32] = (zext(psignsrc[32,32] s< 0) * (0 - XmmReg1[32,32])) | (zext(psignsrc[32,32] s> 0) * XmmReg1[32,32]);
    XmmReg1[64,32] = (zext(psignsrc[64,32] s< 0) * (0 - XmmReg1[64,32])) | (zext(psignsrc[64,32] s> 0) * XmmReg1[64,32]);
    XmmReg1[96,32] = (zext(psignsrc[96,32] s< 0) * (0 - XmmReg1[96,32])) | (zext(psignsrc[96,32] s> 0) * XmmReg1[96,32]);
}

#break into two 64-bit chunks so decompiler can follow constants
:PSLLDQ         XmmReg2, imm8    is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x73; xmmmod = 3 & reg_opcode=7 & XmmReg2; imm8 
{ 
	if (imm8:1 > 15:1) goto <zero>;
    local low64copy:8 = XmmReg2[0,64];
    XmmReg2[0,64] = XmmReg2[0,64] << (8:1 * imm8:1);
    if (imm8:1 > 8:1)  goto <greater>;
    XmmReg2[64,64] = (XmmReg2[64,64] << (8:1 * imm8:1)) | (low64copy >> (8:1 * (8 - imm8:1)));
    goto <end>;
<greater>
    XmmReg2[64,64] = low64copy << (8:1 * (imm8 - 8));
    goto <end>;
<zero>
    XmmReg2[0,64] = 0:8;
    XmmReg2[64,64] = 0:8;
<end>
}

:PSLLW                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xF1; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    psllw128(XmmReg1, m[0,64]);
}

:PSLLW           XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x71; mod = 0b11 & reg_opcode=6 & XmmReg2; imm8
{
    psllw128(XmmReg2, zext(imm8));
}

:PSLLD                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xF2; XmmReg1 ... & XmmReg2_m128
{
