{
    local a:8 = sext(XmmReg1[0,32]);
    local b:8 = sext(XmmReg2_m128[0,32]);
    XmmReg1[0,64]  = a * b;
    local c:8 = sext(XmmReg1[64,32]);
    local d:8 = sext(XmmReg2_m128[64,32]);
    XmmReg1[64,64] = c * d;
}

