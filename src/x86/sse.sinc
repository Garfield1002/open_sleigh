}

macro sse_div64(dest, lhs, rhs) {
    local a:8 = lhs;
    local b:8 = rhs;
    local de_a:1; sse_daz64(a, de_a);
    local de_b:1; sse_daz64(b, de_b);
    local rc:1; sse_rc(rc);
    local result:8 = float_div(a, b, rc);
    local flags:1 = float_div_flags(a, b, rc);
    sse_invalid64(a, b, flags, result);
    sse_ftz64(result, flags);
    local nan_operand:1 = ((a[52,11] == 0x7ff) && (a[0,52] != 0)) ||
                          ((b[52,11] == 0x7ff) && (b[0,52] != 0));
    sse_report(flags, (de_a || de_b) && !nan_operand);
    dest = result;
}

macro sse_sqrt64(dest, source) {
    local a:8 = source;
    local de_a:1; sse_daz64(a, de_a);
    local rc:1; sse_rc(rc);
    local result:8 = float_sqrt(a, rc);
    local flags:1 = float_sqrt_flags(a, rc);
    sse_invalid64(a, a, flags, result);
    sse_ftz64(result, flags);
    local nan_operand:1 = (a[52,11] == 0x7ff) && (a[0,52] != 0);
    sse_report(flags, de_a && !nan_operand);
    dest = result;
}

# A compare reads its operands but produces no floating result, so only the
# operand facts are reported: a denormal raises DE, and a NaN raises IE - any
# NaN when `strict` is non-zero (COMIS and the ordered CMP predicates), a
# signalling one alone otherwise (UCOMIS and the equality/ordering ones).
# The operands come back flushed by DAZ, because the comparison itself must
# see the flushed values.
macro sse_compare32(a, b, strict) {
    local de_a:1; sse_daz32(a, de_a);
    local de_b:1; sse_daz32(b, de_b);
    local a_nan:1 = (a[23,8] == 0xff) && (a[0,23] != 0);
    local b_nan:1 = (b[23,8] == 0xff) && (b[0,23] != 0);
    local signaling:1 = (a_nan && (a[22,1] == 0)) || (b_nan && (b[22,1] == 0));
    local any:1 = (strict != 0) && (a_nan || b_nan);
    local flags:1 = zext(signaling || any);
    sse_report(flags, (de_a || de_b) && !(a_nan || b_nan));
}

# SSE MIN returns its second operand whenever either operand is a NaN or both
# operands are zero of either sign, and the smaller operand otherwise; MAX is
# symmetric. An ordered `f<` is false in exactly the return-the-second-operand
# cases, so one comparison per lane selects the source, and the lane is moved
# bit-for-bit so that a NaN payload survives unchanged. Either NaN raises IE.
macro sse_min32(dest, lhs, rhs) {
    local a:4 = lhs;
    local b:4 = rhs;
    sse_compare32(a, b, 1:1);
    local pick:4 = 0 - zext(a f< b);
    dest = (a & pick) | (b & ~pick);
}

macro sse_max32(dest, lhs, rhs) {
    local a:4 = lhs;
    local b:4 = rhs;
    sse_compare32(a, b, 1:1);
    local pick:4 = 0 - zext(b f< a);
    dest = (a & pick) | (b & ~pick);
}

# COMIS raises IE for any NaN, UCOMIS only for a signalling one; both raise DE
# for a denormal. EFLAGS follow the flushed operands.
macro sse_comis32(lhs, rhs, strict) {
    local a:4 = lhs;
    local b:4 = rhs;
    sse_compare32(a, b, strict);
    fucompe(a, b);
}

# A compare reads its operands but produces no floating result, so only the
# operand facts are reported: a denormal raises DE, and a NaN raises IE - any
# NaN when `strict` is non-zero (COMIS and the ordered CMP predicates), a
# signalling one alone otherwise (UCOMIS and the equality/ordering ones).
# The operands come back flushed by DAZ, because the comparison itself must
# see the flushed values.
macro sse_compare64(a, b, strict) {
    local de_a:1; sse_daz64(a, de_a);
    local de_b:1; sse_daz64(b, de_b);
    local a_nan:1 = (a[52,11] == 0x7ff) && (a[0,52] != 0);
    local b_nan:1 = (b[52,11] == 0x7ff) && (b[0,52] != 0);
    local signaling:1 = (a_nan && (a[51,1] == 0)) || (b_nan && (b[51,1] == 0));
    local any:1 = (strict != 0) && (a_nan || b_nan);
    local flags:1 = zext(signaling || any);
    sse_report(flags, (de_a || de_b) && !(a_nan || b_nan));
}

# SSE MIN returns its second operand whenever either operand is a NaN or both
# operands are zero of either sign, and the smaller operand otherwise; MAX is
# symmetric. An ordered `f<` is false in exactly the return-the-second-operand
# cases, so one comparison per lane selects the source, and the lane is moved
# bit-for-bit so that a NaN payload survives unchanged. Either NaN raises IE.
macro sse_min64(dest, lhs, rhs) {
    local a:8 = lhs;
    local b:8 = rhs;
    sse_compare64(a, b, 1:1);
    local pick:8 = 0 - zext(a f< b);
    dest = (a & pick) | (b & ~pick);
}

macro sse_max64(dest, lhs, rhs) {
    local a:8 = lhs;
    local b:8 = rhs;
    sse_compare64(a, b, 1:1);
    local pick:8 = 0 - zext(b f< a);
    dest = (a & pick) | (b & ~pick);
}

# COMIS raises IE for any NaN, UCOMIS only for a signalling one; both raise DE
# for a denormal. EFLAGS follow the flushed operands.
macro sse_comis64(lhs, rhs, strict) {
    local a:8 = lhs;
    local b:8 = rhs;
    sse_compare64(a, b, strict);
    fucompe(a, b);
}

# CMPPS/CMPPD/CMPSS/CMPSD signal invalid for any NaN under the ordered
# predicates LT, LE, NLT and NLE, and for a signalling NaN alone under EQ,
# UNORD, NEQ and ORD. The immediate is not readable from the constructor's own
# semantics, and the compiler takes only one further operand beside the
# memory form's ellipsis, so this replaces the CMP*_OPERAND suffix: it prints
# exactly as that did and exports the distinction as well.
XmmCmpOrdered:           is imm8=1 | imm8=2 | imm8=5 | imm8=6 { export 1:1; }
XmmCmpOrdered:           is imm8=0 | imm8=3 | imm8=4 | imm8=7 { export 0:1; }
XmmCmpOrdered: ", "^imm8 is imm8                              { export 0:1; }

# --- SSE conversions --------------------------------------------------------
# Every conversion reads a source operand, so DAZ and the denormal report apply
# to it exactly as they do to arithmetic. The conversions themselves are the
# generic IEEE operations; the integer indefinite an invalid conversion stores,
# and the QNaN indefinite a narrowing stores, are x86's.

# Widening a single to a double is exact, so only the source facts are
# reported: DE for a denormal, IE for a signalling NaN, which the conversion
# quiets.
macro sse_widen32(dest, source) {
    local a:4 = source;
    local de:1; sse_daz32(a, de);
    local a_nan:1 = (a[23,8] == 0xff) && (a[0,23] != 0);
    local flags:1 = zext(a_nan && (a[22,1] == 0));
    sse_report(flags, de && !a_nan);
    dest = float2float(a);
}

# Narrowing a double to a single can round, overflow or go tiny. A NaN source
# is quieted and keeps its payload; any other invalid stores the single
# precision indefinite.
macro sse_narrow64(dest, source) {
    local a:8 = source;
    local de:1; sse_daz64(a, de);
    local rc:1; sse_rc(rc);
    local result:4 = float_narrow(a, 4:1, rc);
    local flags:1 = float_narrow_flags(a, 4:1, rc);
    local a_nan:1 = (a[52,11] == 0x7ff) && (a[0,52] != 0);
    local substitute:4 = 0 - zext(((flags & 1) != 0) && !a_nan);
    result = (0xffc00000 & substitute) | (result & ~substitute);
    sse_ftz32(result, flags);
    sse_report(flags, de && !a_nan);
    dest = result;
}

# A NaN, an infinity or a value outside the destination's range is invalid and
# stores the integer indefinite. The rounding mode is the caller's: MXCSR's for
# the CVT forms, toward zero for the CVTT ones.
macro sse_f32_to_i4(dest, source, rc) {
    local a:4 = source;
    local de:1; sse_daz32(a, de);
    local result:4 = float_to_int(a, 4:1, rc);
    local flags:1 = float_to_int_flags(a, 4:1, rc);
    local invalid:4 = 0 - zext((flags & 1) != 0);
    result = (0x80000000 & invalid) | (result & ~invalid);
    # A conversion to an integer reports invalid and precision alone: a
    # denormal source raises no DE, it simply converts inexactly to zero, so
    # only DAZ's flushing of the source survives here.
    sse_report(flags, 0:1);
    dest = result;
}

# A NaN, an infinity or a value outside the destination's range is invalid and
# stores the integer indefinite. The rounding mode is the caller's: MXCSR's for
# the CVT forms, toward zero for the CVTT ones.
macro sse_f32_to_i8(dest, source, rc) {
    local a:4 = source;
    local de:1; sse_daz32(a, de);
    local result:8 = float_to_int(a, 8:1, rc);
    local flags:1 = float_to_int_flags(a, 8:1, rc);
    local invalid:8 = 0 - zext((flags & 1) != 0);
    result = (0x8000000000000000 & invalid) | (result & ~invalid);
    # A conversion to an integer reports invalid and precision alone: a
    # denormal source raises no DE, it simply converts inexactly to zero, so
    # only DAZ's flushing of the source survives here.
    sse_report(flags, 0:1);
    dest = result;
}

# A NaN, an infinity or a value outside the destination's range is invalid and
# stores the integer indefinite. The rounding mode is the caller's: MXCSR's for
# the CVT forms, toward zero for the CVTT ones.
macro sse_f64_to_i4(dest, source, rc) {
    local a:8 = source;
    local de:1; sse_daz64(a, de);
    local result:4 = float_to_int(a, 4:1, rc);
    local flags:1 = float_to_int_flags(a, 4:1, rc);
    local invalid:4 = 0 - zext((flags & 1) != 0);
    result = (0x80000000 & invalid) | (result & ~invalid);
    # A conversion to an integer reports invalid and precision alone: a
    # denormal source raises no DE, it simply converts inexactly to zero, so
    # only DAZ's flushing of the source survives here.
    sse_report(flags, 0:1);
    dest = result;
}

# A NaN, an infinity or a value outside the destination's range is invalid and
# stores the integer indefinite. The rounding mode is the caller's: MXCSR's for
# the CVT forms, toward zero for the CVTT ones.
macro sse_f64_to_i8(dest, source, rc) {
    local a:8 = source;
    local de:1; sse_daz64(a, de);
    local result:8 = float_to_int(a, 8:1, rc);
    local flags:1 = float_to_int_flags(a, 8:1, rc);
    local invalid:8 = 0 - zext((flags & 1) != 0);
    result = (0x8000000000000000 & invalid) | (result & ~invalid);
    # A conversion to an integer reports invalid and precision alone: a
    # denormal source raises no DE, it simply converts inexactly to zero, so
    # only DAZ's flushing of the source survives here.
    sse_report(flags, 0:1);
    dest = result;
}

# An integer to float conversion can only be inexact, and needs the rounding
# mode for that.
macro sse_i4_to_f32(dest, source) {
    local a:4 = source;
    local rc:1; sse_rc(rc);
    local result:4 = float_from_int(a, 4:1, rc);
    local flags:1 = float_from_int_flags(a, 4:1, rc);
    sse_report(flags, 0:1);
    dest = result;
}

# An integer to float conversion can only be inexact, and needs the rounding
# mode for that.
macro sse_i4_to_f64(dest, source) {
    local a:4 = source;
    local rc:1; sse_rc(rc);
    local result:8 = float_from_int(a, 8:1, rc);
    local flags:1 = float_from_int_flags(a, 8:1, rc);
    sse_report(flags, 0:1);
    dest = result;
}

# An integer to float conversion can only be inexact, and needs the rounding
# mode for that.
macro sse_i8_to_f32(dest, source) {
    local a:8 = source;
    local rc:1; sse_rc(rc);
    local result:4 = float_from_int(a, 4:1, rc);
    local flags:1 = float_from_int_flags(a, 4:1, rc);
    sse_report(flags, 0:1);
    dest = result;
}

# An integer to float conversion can only be inexact, and needs the rounding
# mode for that.
macro sse_i8_to_f64(dest, source) {
    local a:8 = source;
    local rc:1; sse_rc(rc);
    local result:8 = float_from_int(a, 8:1, rc);
    local flags:1 = float_from_int_flags(a, 8:1, rc);
    sse_report(flags, 0:1);
    dest = result;
}

# The packed float operations are lifted lane by lane in p-code.
macro divpd128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    sse_div64(dst[  0,64], a[  0,64], b[  0,64]);
    sse_div64(dst[ 64,64], a[ 64,64], b[ 64,64]);
}

macro divps128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    sse_div32(dst[  0,32], a[  0,32], b[  0,32]);
    sse_div32(dst[ 32,32], a[ 32,32], b[ 32,32]);
    sse_div32(dst[ 64,32], a[ 64,32], b[ 64,32]);
    sse_div32(dst[ 96,32], a[ 96,32], b[ 96,32]);
}

# SSE MIN returns its second operand whenever either operand is a NaN or both
# operands are zero of either sign, and the smaller operand otherwise; MAX is
# symmetric. An ordered `f<` is false in exactly the return-the-second-operand
# cases, so one comparison per lane selects the source, and the lane is moved
# bit-for-bit so that a NaN payload survives unchanged.
macro maxpd128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    sse_max64(dst[  0,64], a[  0,64], b[  0,64]);
    sse_max64(dst[ 64,64], a[ 64,64], b[ 64,64]);
}

macro maxps128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    sse_max32(dst[  0,32], a[  0,32], b[  0,32]);
    sse_max32(dst[ 32,32], a[ 32,32], b[ 32,32]);
    sse_max32(dst[ 64,32], a[ 64,32], b[ 64,32]);
    sse_max32(dst[ 96,32], a[ 96,32], b[ 96,32]);
}

macro minpd128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    sse_min64(dst[  0,64], a[  0,64], b[  0,64]);
    sse_min64(dst[ 64,64], a[ 64,64], b[ 64,64]);
}

macro minps128(dst, src) {
    local a:16 = dst;
    local b:16 = src;
    sse_min32(dst[  0,32], a[  0,32], b[  0,32]);
    sse_min32(dst[ 32,32], a[ 32,32], b[ 32,32]);
    sse_min32(dst[ 64,32], a[ 64,32], b[ 64,32]);
    sse_min32(dst[ 96,32], a[ 96,32], b[ 96,32]);
}

# Signed doubleword to unsigned word with saturation, for PACKUSDW.
macro ssduw(sdword, uword) {
    local negative:1 = sdword s< 0;
    local large:1 = sdword s> 0xffff:4;
    local inbounds:1 = !(negative || large);
    uword = (sdword:2 * zext(inbounds)) + (0xffff:2 * zext(large));
}

macro packsswb_xmm(dst, src) {
	# A bit range passed as a macro output parameter is an rvalue, so the
	# assignment inside the saturating macro lands on a discarded
	# temporary and the lane is never written. Saturate into a local.
	local a:16 = dst;
	local lane:1;
	local b:16 = src;

	sswsb(a[  0,16], lane);	dst[0,8] = lane;
	sswsb(a[ 16,16], lane);	dst[8,8] = lane;
	sswsb(a[ 32,16], lane);	dst[16,8] = lane;
	sswsb(a[ 48,16], lane);	dst[24,8] = lane;
	sswsb(a[ 64,16], lane);	dst[32,8] = lane;
	sswsb(a[ 80,16], lane);	dst[40,8] = lane;
	sswsb(a[ 96,16], lane);	dst[48,8] = lane;
	sswsb(a[112,16], lane);	dst[56,8] = lane;

	sswsb(b[  0,16], lane);	dst[64,8] = lane;
	sswsb(b[ 16,16], lane);	dst[72,8] = lane;
	sswsb(b[ 32,16], lane);	dst[80,8] = lane;
	sswsb(b[ 48,16], lane);	dst[88,8] = lane;
	sswsb(b[ 64,16], lane);	dst[96,8] = lane;
	sswsb(b[ 80,16], lane);	dst[104,8] = lane;
	sswsb(b[ 96,16], lane);	dst[112,8] = lane;
	sswsb(b[112,16], lane);	dst[120,8] = lane;
}

macro packssdw_xmm(dst, src) {
	# A bit range passed as a macro output parameter is an rvalue, so the
	# assignment inside the saturating macro lands on a discarded
	# temporary and the lane is never written. Saturate into a local.
	local a:16 = dst;
	local lane:2;
	local b:16 = src;

	ssdsw(a[ 0,32], lane);	dst[0,16] = lane;
	ssdsw(a[32,32], lane);	dst[16,16] = lane;
	ssdsw(a[64,32], lane);	dst[32,16] = lane;
	ssdsw(a[96,32], lane);	dst[48,16] = lane;

	ssdsw(b[ 0,32], lane);	dst[64,16] = lane;
	ssdsw(b[32,32], lane);	dst[80,16] = lane;
	ssdsw(b[64,32], lane);	dst[96,16] = lane;
	ssdsw(b[96,32], lane);	dst[112,16] = lane;
}

macro pmulhw128(xmm1, xmm2) {
	local tmp0:8 = sext(xmm1[  0,16]) * sext(xmm2[  0,16]);
    xmm1[  0,16] = tmp0[16,16];
	local tmp1:8 = sext(xmm1[ 16,16]) * sext(xmm2[ 16,16]);
    xmm1[ 16,16] = tmp1[16,16];
	local tmp2:8 = sext(xmm1[ 32,16]) * sext(xmm2[ 32,16]);
    xmm1[ 32,16] = tmp2[16,16];
	local tmp3:8 = sext(xmm1[ 48,16]) * sext(xmm2[ 48,16]);
    xmm1[ 48,16] = tmp3[16,16];
	local tmp4:8 = sext(xmm1[ 64,16]) * sext(xmm2[ 64,16]);
    xmm1[ 64,16] = tmp4[16,16];
	local tmp5:8 = sext(xmm1[ 80,16]) * sext(xmm2[ 80,16]);
    xmm1[ 80,16] = tmp5[16,16];
	local tmp6:8 = sext(xmm1[ 96,16]) * sext(xmm2[ 96,16]);
    xmm1[ 96,16] = tmp6[16,16];
	local tmp7:8 = sext(xmm1[112,16]) * sext(xmm2[112,16]);
    xmm1[112,16] = tmp7[16,16];
}

# The XMM form is two independent MMX-shaped halves: each 64-bit half becomes
# the 16-bit sum of its eight absolute byte differences, zero extended.
macro psadbw_xmm(dst, src) {
    local left:16 = dst;
    local right:16 = src;
    local lo:8 = left[0,64];
    local rlo:8 = right[0,64];
    psadbw_mmx(lo, rlo);
    local hi:8 = left[64,64];
    local rhi:8 = right[64,64];
    psadbw_mmx(hi, rhi);
    dst[0,64] = lo;
    dst[64,64] = hi;
}

macro shuffle_4(dest,ord,c0,c1,c2,c3){
    dest = zext(ord == 0) * c0 + zext(ord == 1) * c1 + zext(ord == 2) * c2 + zext(ord == 3) * c3;
}

# The SSE shift-by-count forms take a single 64-bit count from the low quadword
# of the source operand -- it is not a per-lane count -- and a count at or
# beyond the lane width produces an all-zero lane (an all-sign-bits lane for an
# arithmetic shift). Clamp the count to the lane width the way the MMX macros
# above do, so that SLEIGH's narrowing of the count to the lane width cannot
# silently wrap an oversized count.
macro psllw128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    xmm[  0,16] = xmm[  0,16] << amount;
    xmm[ 16,16] = xmm[ 16,16] << amount;
    xmm[ 32,16] = xmm[ 32,16] << amount;
    xmm[ 48,16] = xmm[ 48,16] << amount;
    xmm[ 64,16] = xmm[ 64,16] << amount;
    xmm[ 80,16] = xmm[ 80,16] << amount;
    xmm[ 96,16] = xmm[ 96,16] << amount;
    xmm[112,16] = xmm[112,16] << amount;
}

macro pslld128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    xmm[  0,32] = xmm[  0,32] << amount;
    xmm[ 32,32] = xmm[ 32,32] << amount;
    xmm[ 64,32] = xmm[ 64,32] << amount;
    xmm[ 96,32] = xmm[ 96,32] << amount;
}

macro psllq128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 63);
    local amount:8 = (n & (over - 1)) | (over * 64);
    xmm[  0,64] = xmm[  0,64] << amount;
    xmm[ 64,64] = xmm[ 64,64] << amount;
}

macro psrlw128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    xmm[  0,16] = xmm[  0,16] >> amount;
    xmm[ 16,16] = xmm[ 16,16] >> amount;
    xmm[ 32,16] = xmm[ 32,16] >> amount;
    xmm[ 48,16] = xmm[ 48,16] >> amount;
    xmm[ 64,16] = xmm[ 64,16] >> amount;
    xmm[ 80,16] = xmm[ 80,16] >> amount;
    xmm[ 96,16] = xmm[ 96,16] >> amount;
    xmm[112,16] = xmm[112,16] >> amount;
}

macro psrld128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    xmm[  0,32] = xmm[  0,32] >> amount;
    xmm[ 32,32] = xmm[ 32,32] >> amount;
    xmm[ 64,32] = xmm[ 64,32] >> amount;
    xmm[ 96,32] = xmm[ 96,32] >> amount;
}

macro psrlq128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 63);
    local amount:8 = (n & (over - 1)) | (over * 64);
    xmm[  0,64] = xmm[  0,64] >> amount;
    xmm[ 64,64] = xmm[ 64,64] >> amount;
}

macro psraw128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 15);
    local amount:8 = (n & (over - 1)) | (over * 16);
    xmm[  0,16] = xmm[  0,16] s>> amount;
    xmm[ 16,16] = xmm[ 16,16] s>> amount;
    xmm[ 32,16] = xmm[ 32,16] s>> amount;
    xmm[ 48,16] = xmm[ 48,16] s>> amount;
    xmm[ 64,16] = xmm[ 64,16] s>> amount;
    xmm[ 80,16] = xmm[ 80,16] s>> amount;
    xmm[ 96,16] = xmm[ 96,16] s>> amount;
    xmm[112,16] = xmm[112,16] s>> amount;
}

macro psrad128(xmm, count) {
    local n:8 = count;
    local over:8 = zext(n > 31);
    local amount:8 = (n & (over - 1)) | (over * 32);
    xmm[  0,32] = xmm[  0,32] s>> amount;
    xmm[ 32,32] = xmm[ 32,32] s>> amount;
    xmm[ 64,32] = xmm[ 64,32] s>> amount;
    xmm[ 96,32] = xmm[ 96,32] s>> amount;
}

macro sqrtpd128(dst, src) {
    local b:16 = src;
    sse_sqrt64(dst[  0,64], b[  0,64]);
    sse_sqrt64(dst[ 64,64], b[ 64,64]);
}

macro sqrtps128(dst, src) {
    local b:16 = src;
    sse_sqrt32(dst[  0,32], b[  0,32]);
    sse_sqrt32(dst[ 32,32], b[ 32,32]);
    sse_sqrt32(dst[ 64,32], b[ 64,32]);
    sse_sqrt32(dst[ 96,32], b[ 96,32]);
}

# --- SSE4.1 immediate-controlled lanes -------------------------------------
# The immediate is an 8-bit token: widening it to an eight-byte cast is an
# invalid bit range and hands the consumer garbage. Every macro below takes the
# control byte as a one-byte value and selects lanes from its bits.

macro blendps128(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    conditionalAssign(dst[  0,32], c[0,1], b[  0,32], dst[  0,32]);
    conditionalAssign(dst[ 32,32], c[1,1], b[ 32,32], dst[ 32,32]);
    conditionalAssign(dst[ 64,32], c[2,1], b[ 64,32], dst[ 64,32]);
    conditionalAssign(dst[ 96,32], c[3,1], b[ 96,32], dst[ 96,32]);
}

macro blendpd128(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    conditionalAssign(dst[  0,64], c[0,1], b[  0,64], dst[  0,64]);
    conditionalAssign(dst[ 64,64], c[1,1], b[ 64,64], dst[ 64,64]);
}

macro pblendw128(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    conditionalAssign(dst[  0,16], c[0,1], b[  0,16], dst[  0,16]);
    conditionalAssign(dst[ 16,16], c[1,1], b[ 16,16], dst[ 16,16]);
    conditionalAssign(dst[ 32,16], c[2,1], b[ 32,16], dst[ 32,16]);
    conditionalAssign(dst[ 48,16], c[3,1], b[ 48,16], dst[ 48,16]);
    conditionalAssign(dst[ 64,16], c[4,1], b[ 64,16], dst[ 64,16]);
    conditionalAssign(dst[ 80,16], c[5,1], b[ 80,16], dst[ 80,16]);
    conditionalAssign(dst[ 96,16], c[6,1], b[ 96,16], dst[ 96,16]);
    conditionalAssign(dst[112,16], c[7,1], b[112,16], dst[112,16]);
}

# DPPS/DPPD: the high nibble of the control byte masks the products, the low
# nibble masks which lanes receive the sum. A masked product is +0.0 and is
# not computed, so it raises nothing; the multiplies and the adds go through
# the MXCSR-aware lane macros so rounding control and the exception flags
# match hardware (-0.0 + +0.0 is -0.0 under round-down).
#
# The SDM sums once as (p0+p1)+(p2+p3) and broadcasts, but hardware reaches
# each lane through its own operand order, which only shows when two products
# are NaNs (the first operand's NaN wins): lane 0 is (p1+p0)+(p2+p3), lane 1
# (p0+p1)+(p2+p3), lane 2 (p3+p2)+(p1+p0), lane 3 (p2+p3)+(p0+p1); DPPD's
# lane 0 is p0+p1 and lane 1 p1+p0. Derived from the Binit captures (every
# NaN result of 207k states), numerically identical since each pairing is
# commutative.
macro dpps128(dst, src, ctl) {
    local a:16 = dst;
    local b:16 = src;
    local c:1 = ctl;
    local x0:4; local y0:4;
    local x1:4; local y1:4;
    local x2:4; local y2:4;
    local x3:4; local y3:4;
    conditionalAssign(x0, c[4,1], a[  0,32], 0:4); conditionalAssign(y0, c[4,1], b[  0,32], 0:4);
    conditionalAssign(x1, c[5,1], a[ 32,32], 0:4); conditionalAssign(y1, c[5,1], b[ 32,32], 0:4);
    conditionalAssign(x2, c[6,1], a[ 64,32], 0:4); conditionalAssign(y2, c[6,1], b[ 64,32], 0:4);
    conditionalAssign(x3, c[7,1], a[ 96,32], 0:4); conditionalAssign(y3, c[7,1], b[ 96,32], 0:4);
    local p0:4; sse_mul32(p0, x0, y0);
    local p1:4; sse_mul32(p1, x1, y1);
    local p2:4; sse_mul32(p2, x2, y2);
    local p3:4; sse_mul32(p3, x3, y3);
    local s01:4; sse_add32(s01, p0, p1);
    local s23:4; sse_add32(s23, p2, p3);
    local sum:4; sse_add32(sum, s01, s23);
    # The per-lane orders only differ in which NaN survives, so the three
    # adds above carry the numerics and the flags, and the reversed orders
    # are integer selects: a reversed pair differs from its pair only when
    # both products are NaNs, and a reversed outer add only when its first
    # pair is a NaN.
    local n0:1 = (p0[23,8] == 0xff) && (p0[0,23] != 0);
    local n1:1 = (p1[23,8] == 0xff) && (p1[0,23] != 0);
    local n2:1 = (p2[23,8] == 0xff) && (p2[0,23] != 0);
    local n3:1 = (p3[23,8] == 0xff) && (p3[0,23] != 0);
    local s10:4; conditionalAssign(s10, n0 && n1, p1, s01);
    local s32:4; conditionalAssign(s32, n2 && n3, p3, s23);
    local ns01:1 = (s01[23,8] == 0xff) && (s01[0,23] != 0);
    local ns23:1 = (s23[23,8] == 0xff) && (s23[0,23] != 0);
    local sum0:4; conditionalAssign(sum0, ns01, s10, sum);
    local sum1:4 = sum;
    local sum2:4; conditionalAssign(sum2, ns01, s10, sum);
    conditionalAssign(sum2, ns23, s32, sum2);
    local sum3:4; conditionalAssign(sum3, ns23, s23, sum);
    conditionalAssign(dst[  0,32], c[0,1], sum0, 0:4);
    conditionalAssign(dst[ 32,32], c[1,1], sum1, 0:4);
    conditionalAssign(dst[ 64,32], c[2,1], sum2, 0:4);
    conditionalAssign(dst[ 96,32], c[3,1], sum3, 0:4);
}

macro dppd128(dst, src, ctl) {
    local a:16 = dst;
    local b:16 = src;
    local c:1 = ctl;
    local x0:8; local y0:8;
    local x1:8; local y1:8;
    conditionalAssign(x0, c[4,1], a[  0,64], 0:8); conditionalAssign(y0, c[4,1], b[  0,64], 0:8);
    conditionalAssign(x1, c[5,1], a[ 64,64], 0:8); conditionalAssign(y1, c[5,1], b[ 64,64], 0:8);
    local p0:8; sse_mul64(p0, x0, y0);
    local p1:8; sse_mul64(p1, x1, y1);
    local sum0:8; sse_add64(sum0, p0, p1);
    local n0:1 = (p0[52,11] == 0x7ff) && (p0[0,52] != 0);
    local n1:1 = (p1[52,11] == 0x7ff) && (p1[0,52] != 0);
    local sum1:8; conditionalAssign(sum1, n0 && n1, p1, sum0);
    conditionalAssign(dst[  0,64], c[0,1], sum0, 0:8);
    conditionalAssign(dst[ 64,64], c[1,1], sum1, 0:8);
}

# ROUND*: bits 0-1 of the control byte select nearest/down/up/toward-zero, and
# bit 2 replaces that choice with MXCSR's RC field (bits 13-14).
macro sse_round_mode(mode, ctl) {
    local c:1 = ctl;
    local mxcsr:4 = MXCSR;
    local fromMxcsr:1 = zext(mxcsr[13,2]);
    local fromImm:1 = zext(c[0,2]);
    conditionalAssign(mode, c[2,1], fromMxcsr, fromImm);
}

# The rounding itself is the generic IEEE round-to-integral with the selected
# mode. Only IE (a signalling NaN, quieted the x86 way) and PE are reported:
# hardware raises neither DE for a denormal source nor UE for a tiny one that
# rounds to zero, which the generic op flags, and bit 3 of the control byte
# suppresses PE. DAZ still replaces a denormal source by zero.
macro sse_round32(dest, source, ctl) {
    local a:4 = source;
    local c:1 = ctl;
    local de:1; sse_daz32(a, de);
    local mode:1; sse_round_mode(mode, ctl);
    local result:4 = float_round_to_integral(a, mode);
    local flags:1 = float_round_to_integral_flags(a, mode);
    sse_invalid32(a, a, flags, result);
    local keep:1 = 0x21 & ~(zext(c[3,1]) * 0x20);
    flags = flags & keep;
    sse_report(flags, 0:1);
    dest = result;
}

macro sse_round64(dest, source, ctl) {
    local a:8 = source;
    local c:1 = ctl;
    local de:1; sse_daz64(a, de);
    local mode:1; sse_round_mode(mode, ctl);
    local result:8 = float_round_to_integral(a, mode);
    local flags:1 = float_round_to_integral_flags(a, mode);
    sse_invalid64(a, a, flags, result);
    local keep:1 = 0x21 & ~(zext(c[3,1]) * 0x20);
    flags = flags & keep;
    sse_report(flags, 0:1);
    dest = result;
}

macro roundps128(dst, src, ctl) {
    local b:16 = src;
    sse_round32(dst[  0,32], b[  0,32], ctl);
    sse_round32(dst[ 32,32], b[ 32,32], ctl);
    sse_round32(dst[ 64,32], b[ 64,32], ctl);
    sse_round32(dst[ 96,32], b[ 96,32], ctl);
}

macro roundpd128(dst, src, ctl) {
    local b:16 = src;
    sse_round64(dst[  0,64], b[  0,64], ctl);
    sse_round64(dst[ 64,64], b[ 64,64], ctl);
}

macro roundss128(dst, src, ctl) {
    local b:4 = src;
    sse_round32(dst[0,32], b, ctl);
}

macro roundsd128(dst, src, ctl) {
    local b:8 = src;
    sse_round64(dst[0,64], b, ctl);
}

# INSERTPS: bits 6-7 pick the source lane (register form only), bits 4-5 the
# destination lane, bits 0-3 zero the lanes they name -- after the insert.
macro insertps_lane(dst, lane, ctl) {
    local c:1 = ctl;
    local sel:4 = lane;
    local to:1 = zext(c[4,2]);
    conditionalAssign(dst[  0,32], to == 0, sel, dst[  0,32]);
    conditionalAssign(dst[ 32,32], to == 1, sel, dst[ 32,32]);
    conditionalAssign(dst[ 64,32], to == 2, sel, dst[ 64,32]);
    conditionalAssign(dst[ 96,32], to == 3, sel, dst[ 96,32]);
    conditionalAssign(dst[  0,32], c[0,1], 0:4, dst[  0,32]);
    conditionalAssign(dst[ 32,32], c[1,1], 0:4, dst[ 32,32]);
    conditionalAssign(dst[ 64,32], c[2,1], 0:4, dst[ 64,32]);
    conditionalAssign(dst[ 96,32], c[3,1], 0:4, dst[ 96,32]);
}

macro insertps128(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    local sel:4;
    shuffle_4(sel, c[6,2], b[0,32], b[32,32], b[64,32], b[96,32]);
    insertps_lane(dst, sel, ctl);
}

macro extractps32(dst, src, ctl) {
    local b:16 = src;
    local c:1 = ctl;
    shuffle_4(dst, c[0,2], b[0,32], b[32,32], b[64,32], b[96,32]);
}

# MPSADBW: bits 0-1 pick a four-byte block of the source, bit 2 a four-byte
# offset into the destination; each result word is the sum of four absolute
# byte differences over a sliding window. Fully unrolled: a SLEIGH bit range
# needs literal bounds, so the window offsets cannot be macro parameters.
macro mpsadbw128(dst, src, ctl) {
    local a:16 = dst;
    local b:16 = src;
    local c:1 = ctl;
    local blk:4;
    shuffle_4(blk, c[0,2], b[0,32], b[32,32], b[64,32], b[96,32]);
    local win:16;
    conditionalAssign(win, c[2,1], a >> 32, a);
    local sum0:2 = 0;
    psadbw_byte(sum0, win[0,8], blk[0,8]);
    psadbw_byte(sum0, win[8,8], blk[8,8]);
    psadbw_byte(sum0, win[16,8], blk[16,8]);
    psadbw_byte(sum0, win[24,8], blk[24,8]);
    dst[0,16] = sum0;
    local sum1:2 = 0;
    psadbw_byte(sum1, win[8,8], blk[0,8]);
    psadbw_byte(sum1, win[16,8], blk[8,8]);
    psadbw_byte(sum1, win[24,8], blk[16,8]);
    psadbw_byte(sum1, win[32,8], blk[24,8]);
    dst[16,16] = sum1;
    local sum2:2 = 0;
    psadbw_byte(sum2, win[16,8], blk[0,8]);
    psadbw_byte(sum2, win[24,8], blk[8,8]);
    psadbw_byte(sum2, win[32,8], blk[16,8]);
    psadbw_byte(sum2, win[40,8], blk[24,8]);
    dst[32,16] = sum2;
    local sum3:2 = 0;
    psadbw_byte(sum3, win[24,8], blk[0,8]);
    psadbw_byte(sum3, win[32,8], blk[8,8]);
    psadbw_byte(sum3, win[40,8], blk[16,8]);
    psadbw_byte(sum3, win[48,8], blk[24,8]);
    dst[48,16] = sum3;
    local sum4:2 = 0;
    psadbw_byte(sum4, win[32,8], blk[0,8]);
    psadbw_byte(sum4, win[40,8], blk[8,8]);
    psadbw_byte(sum4, win[48,8], blk[16,8]);
    psadbw_byte(sum4, win[56,8], blk[24,8]);
    dst[64,16] = sum4;
    local sum5:2 = 0;
    psadbw_byte(sum5, win[40,8], blk[0,8]);
    psadbw_byte(sum5, win[48,8], blk[8,8]);
    psadbw_byte(sum5, win[56,8], blk[16,8]);
    psadbw_byte(sum5, win[64,8], blk[24,8]);
    dst[80,16] = sum5;
    local sum6:2 = 0;
    psadbw_byte(sum6, win[48,8], blk[0,8]);
    psadbw_byte(sum6, win[56,8], blk[8,8]);
    psadbw_byte(sum6, win[64,8], blk[16,8]);
    psadbw_byte(sum6, win[72,8], blk[24,8]);
    dst[96,16] = sum6;
    local sum7:2 = 0;
    psadbw_byte(sum7, win[56,8], blk[0,8]);
    psadbw_byte(sum7, win[64,8], blk[8,8]);
    psadbw_byte(sum7, win[72,8], blk[16,8]);
    psadbw_byte(sum7, win[80,8], blk[24,8]);
    dst[112,16] = sum7;
}

with : lockprefx=0 {

#@family sse
:LDMXCSR m32		is vexMode=0 & byte=0xf; byte=0xae; ( mod != 0b11 & reg_opcode=2 ) ... & m32 { MXCSR = m32; }

:STMXCSR m32        is vexMode=0 & byte=0xf; byte=0xae; ( mod != 0b11 & reg_opcode=3 ) ... & m32 { m32 = MXCSR; }

:ADDPD            XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x58; XmmReg1 ... & XmmReg2_m128
{
    sse_add64(XmmReg1[0,64], XmmReg1[0,64], XmmReg2_m128[0,64]);
    sse_add64(XmmReg1[64,64], XmmReg1[64,64], XmmReg2_m128[64,64]);
}

:ADDPS            XmmReg1, XmmReg2_m128  is vexMode=0 & mandover=0 & byte=0x0F; byte=0x58; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;	# Guarantee value is in a fixed location
    sse_add32(XmmReg1[0,32], XmmReg1[0,32], m[0,32]);
    sse_add32(XmmReg1[32,32], XmmReg1[32,32], m[32,32]);
    sse_add32(XmmReg1[64,32], XmmReg1[64,32], m[64,32]);
    sse_add32(XmmReg1[96,32], XmmReg1[96,32], m[96,32]);
}

:ADDSD        XmmReg, m64      is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x58; m64 & XmmReg ...
{
    sse_add64(XmmReg[0,64], XmmReg[0,64], m64);
}

:ADDSD        XmmReg1, XmmReg2 is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x58; xmmmod=3 & XmmReg1 & XmmReg2
{
    sse_add64(XmmReg1[0,64], XmmReg1[0,64], XmmReg2[0,64]);
}

:ADDSS        XmmReg, m32      is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x58; m32 & XmmReg ...
{
    sse_add32(XmmReg[0,32], XmmReg[0,32], m32);
}

:ADDSS        XmmReg1, XmmReg2 is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x58; xmmmod=3 & XmmReg1 & XmmReg2
{
    sse_add32(XmmReg1[0,32], XmmReg1[0,32], XmmReg2[0,32]);
}

:ADDSUBPD         XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0xD0; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    sse_sub64(XmmReg1[0,64], XmmReg1[0,64], m[0,64]);
    sse_add64(XmmReg1[64,64], XmmReg1[64,64], m[64,64]);
}

:ADDSUBPS         XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0xD0; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    sse_sub32(XmmReg1[0,32], XmmReg1[0,32], m[0,32]);
    sse_add32(XmmReg1[32,32], XmmReg1[32,32], m[32,32]);
    sse_sub32(XmmReg1[64,32], XmmReg1[64,32], m[64,32]);
    sse_add32(XmmReg1[96,32], XmmReg1[96,32], m[96,32]);
}

# special FLOATING POINT bitwise AND
:ANDPD      XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x54; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = XmmReg1[0,64] & m[0,64];
    XmmReg1[64,64] = XmmReg1[64,64] & m[64,64];
}

# special FLOATING POINT bitwise AND
# special FLOATING POINT bitwise AND
:ANDPS            XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x54; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = XmmReg1[0,32] & m[0,32];
    XmmReg1[32,32] = XmmReg1[32,32] & m[32,32];
    XmmReg1[64,32] = XmmReg1[64,32] & m[64,32];
    XmmReg1[96,32] = XmmReg1[96,32] & m[96,32];
}

# special FLOATING POINT bitwise AND
# special FLOATING POINT bitwise AND NOT
:ANDNPD           XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x55; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = ~XmmReg1[0,64] & m[0,64];
    XmmReg1[64,64] = ~XmmReg1[64,64] & m[64,64];
}

# special FLOATING POINT bitwise AND NOT
:ANDNPS           XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x55; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = ~XmmReg1[0,32] & m[0,32];
    XmmReg1[32,32] = ~XmmReg1[32,32] & m[32,32];
    XmmReg1[64,32] = ~XmmReg1[64,32] & m[64,32];
    XmmReg1[96,32] = ~XmmReg1[96,32] & m[96,32];
}

:CMP^XmmCondPD^"PD"        XmmReg,m128^XmmCmpOrdered      is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xC2; (m128 & XmmReg ...); XmmCondPD & XmmCmpOrdered
{
    local m:16 = m128;
	local strict:1 = XmmCmpOrdered;
	local a0:8 = XmmReg[0,64];
	local b0:8 = m[0,64];
	sse_compare64(a0, b0, strict);
	xmmTmp1_Qa = a0;
	xmmTmp2_Qa = b0;
	local a1:8 = XmmReg[64,64];
	local b1:8 = m[64,64];
	sse_compare64(a1, b1, strict);
	xmmTmp1_Qb = a1;
	xmmTmp2_Qb = b1;

	build XmmCondPD;

	XmmReg[0,64] = xmmTmp1_Qa;
	XmmReg[64,64] = xmmTmp1_Qb;
}

:CMP^XmmCondPD^"PD"        XmmReg1,XmmReg2^XmmCmpOrdered  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xC2; xmmmod=3 & XmmReg1 & XmmReg2; XmmCondPD & XmmCmpOrdered 
{
	local strict:1 = XmmCmpOrdered;
	local a0:8 = XmmReg1[0,64];
	local b0:8 = XmmReg2[0,64];
	sse_compare64(a0, b0, strict);
	xmmTmp1_Qa = a0;
	xmmTmp2_Qa = b0;
	local a1:8 = XmmReg1[64,64];
	local b1:8 = XmmReg2[64,64];
	sse_compare64(a1, b1, strict);
	xmmTmp1_Qb = a1;
	xmmTmp2_Qb = b1;

	build XmmCondPD;

	XmmReg1[0,64] = xmmTmp1_Qa;
	XmmReg1[64,64] = xmmTmp1_Qb;
}

:CMP^XmmCondPS^"PS"        XmmReg,m128^XmmCmpOrdered      is vexMode=0 &  mandover=0 & byte=0x0F; byte=0xC2; (m128 & XmmReg ...); XmmCondPS & XmmCmpOrdered
{
    local m:16 = m128;
	local strict:1 = XmmCmpOrdered;
	local a0:4 = XmmReg[0,32];
	local b0:4 = m[0,32];
	sse_compare32(a0, b0, strict);
	xmmTmp1_Da = a0;
	xmmTmp2_Da = b0;
	local a1:4 = XmmReg[32,32];
	local b1:4 = m[32,32];
	sse_compare32(a1, b1, strict);
	xmmTmp1_Db = a1;
	xmmTmp2_Db = b1;
	local a2:4 = XmmReg[64,32];
	local b2:4 = m[64,32];
	sse_compare32(a2, b2, strict);
	xmmTmp1_Dc = a2;
	xmmTmp2_Dc = b2;
	local a3:4 = XmmReg[96,32];
	local b3:4 = m[96,32];
	sse_compare32(a3, b3, strict);
	xmmTmp1_Dd = a3;
	xmmTmp2_Dd = b3;

	build XmmCondPS;

	XmmReg[0,32] = xmmTmp1_Da;
	XmmReg[32,32] = xmmTmp1_Db;
	XmmReg[64,32] = xmmTmp1_Dc;
	XmmReg[96,32] = xmmTmp1_Dd;
}

:CMP^XmmCondPS^"PS"        XmmReg1,XmmReg2^XmmCmpOrdered  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0xC2; xmmmod=3 & XmmReg1 & XmmReg2; XmmCondPS & XmmCmpOrdered 
{
	local strict:1 = XmmCmpOrdered;
	local a0:4 = XmmReg1[0,32];
	local b0:4 = XmmReg2[0,32];
	sse_compare32(a0, b0, strict);
	xmmTmp1_Da = a0;
	xmmTmp2_Da = b0;
	local a1:4 = XmmReg1[32,32];
	local b1:4 = XmmReg2[32,32];
	sse_compare32(a1, b1, strict);
	xmmTmp1_Db = a1;
	xmmTmp2_Db = b1;
	local a2:4 = XmmReg1[64,32];
	local b2:4 = XmmReg2[64,32];
	sse_compare32(a2, b2, strict);
	xmmTmp1_Dc = a2;
	xmmTmp2_Dc = b2;
	local a3:4 = XmmReg1[96,32];
	local b3:4 = XmmReg2[96,32];
	sse_compare32(a3, b3, strict);
	xmmTmp1_Dd = a3;
	xmmTmp2_Dd = b3;

	build XmmCondPS;

	XmmReg1[0,32] = xmmTmp1_Da;
	XmmReg1[32,32] = xmmTmp1_Db;
	XmmReg1[64,32] = xmmTmp1_Dc;
	XmmReg1[96,32] = xmmTmp1_Dd;
}

:CMP^XmmCondSD^"SD"  XmmReg, m64^XmmCmpOrdered  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0xC2; (m64 & XmmReg ...); XmmCondSD & XmmCmpOrdered
{
	local strict:1 = XmmCmpOrdered;
	local a0:8 = XmmReg[0,64];
	local b0:8 = m64;
	sse_compare64(a0, b0, strict);
	xmmTmp1_Qa = a0;
	xmmTmp2_Qa = b0;
	build XmmCondSD;
	XmmReg[0,64] = xmmTmp1_Qa;
}

:CMP^XmmCondSD^"SD"  XmmReg1, XmmReg2^XmmCmpOrdered  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0xC2; xmmmod=3 & XmmReg1 & XmmReg2; XmmCondSD & XmmCmpOrdered
{
	local strict:1 = XmmCmpOrdered;
	local a0:8 = XmmReg1[0,64];
	local b0:8 = XmmReg2[0,64];
	sse_compare64(a0, b0, strict);
	xmmTmp1_Qa = a0;
	xmmTmp2_Qa = b0;
	build XmmCondSD;
	XmmReg1[0,64] = xmmTmp1_Qa;
}

:CMP^XmmCondSS^"SS"  XmmReg, m32^XmmCmpOrdered  is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0xC2; (m32 & XmmReg ...); XmmCondSS & XmmCmpOrdered
{
	local strict:1 = XmmCmpOrdered;
	local a0:4 = XmmReg[0,32];
	local b0:4 = m32;
	sse_compare32(a0, b0, strict);
	xmmTmp1_Da = a0;
	xmmTmp2_Da = b0;
	build XmmCondSS;
	XmmReg[0,32] = xmmTmp1_Da;
}

:CMP^XmmCondSS^"SS"  XmmReg1, XmmReg2^XmmCmpOrdered  is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0xC2; xmmmod=3 & XmmReg1 & XmmReg2; XmmCondSS & XmmCmpOrdered
{
	local strict:1 = XmmCmpOrdered;
	local a0:4 = XmmReg1[0,32];
	local b0:4 = XmmReg2[0,32];
	sse_compare32(a0, b0, strict);
	xmmTmp1_Da = a0;
	xmmTmp2_Da = b0;
	build XmmCondSS;
	XmmReg1[0,32] = xmmTmp1_Da;
}

:COMISD       XmmReg, m64   is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2F; m64 & XmmReg ...
{
  sse_comis64(XmmReg[0,64], m64, 1:1);
}

:COMISD       XmmReg1, XmmReg2  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2F; xmmmod=3 & XmmReg1 & XmmReg2
{
  sse_comis64(XmmReg1[0,64], XmmReg2[0,64], 1:1);
}

:COMISS       XmmReg, m32       is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2F; m32 & XmmReg ...
{
  sse_comis32(XmmReg[0,32], m32, 1:1);
}

:COMISS       XmmReg1, XmmReg2  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2F; xmmmod=3 & XmmReg1 & XmmReg2
{
  sse_comis32(XmmReg1[0,32], XmmReg2[0,32], 1:1);
}

:CVTDQ2PD     XmmReg, m64       is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0xE6; m64 & XmmReg ...
{
    local m:8 = m64;
    sse_i4_to_f64(XmmReg[0,64], m[0,32]);
    sse_i4_to_f64(XmmReg[64,64], m[32,32]);
}

:CVTDQ2PD     XmmReg1, XmmReg2  is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0xE6; xmmmod=3 & XmmReg1 & XmmReg2
{
    local tmp:8 = XmmReg2[0,64];
    sse_i4_to_f64(XmmReg1[0,64], tmp[0,32]);
    sse_i4_to_f64(XmmReg1[64,64], tmp[32,32]);
}

:CVTDQ2PS          XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x5B; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    sse_i4_to_f32(XmmReg1[0,32], m[0,32]);
    sse_i4_to_f32(XmmReg1[32,32], m[32,32]);
    sse_i4_to_f32(XmmReg1[64,32], m[64,32]);
    sse_i4_to_f32(XmmReg1[96,32], m[96,32]);
}

:CVTPD2DQ          XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_F2) & byte=0x0F; byte=0xE6; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    local rc:1; sse_rc(rc);
    sse_f64_to_i4(XmmReg1[0,32], m[0,64], rc);
    sse_f64_to_i4(XmmReg1[32,32], m[64,64], rc);
    XmmReg1[64,32] = 0;
    XmmReg1[96,32] = 0;
}

:CVTPD2PI     mmxregop, m128        is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2D; mmxregop ... & m128
{
    local m:16 = m128;
    local rc:1; sse_rc(rc);
    sse_f64_to_i4(mmxregop[0,32], m[0,64], rc);
    sse_f64_to_i4(mmxregop[32,32], m[64,64], rc);
}

:CVTPD2PI     mmxreg1op, XmmReg2    is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2D; xmmmod=3 & mmxreg1op & XmmReg2
{
    local rc:1; sse_rc(rc);
    sse_f64_to_i4(mmxreg1op[0,32], XmmReg2[0,64], rc);
    sse_f64_to_i4(mmxreg1op[32,32], XmmReg2[64,64], rc);
}

:CVTPD2PS          XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x5A; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    sse_narrow64(XmmReg1[0,32], m[0,64]);
    sse_narrow64(XmmReg1[32,32], m[64,64]);
    XmmReg1[64,32] = 0;
    XmmReg1[96,32] = 0;
}

:CVTPI2PD     XmmReg, m64       is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2A; m64 & XmmReg ...
{
  local m:8 = m64;
  sse_i4_to_f64(XmmReg[0,64], m[0,32]);
  sse_i4_to_f64(XmmReg[64,64], m[32,32]);
}

:CVTPI2PD     XmmReg1, mmxreg2op  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x2A; xmmmod=3 & XmmReg1 & mmxreg2op
{
  sse_i4_to_f64(XmmReg1[0,64], mmxreg2op[0,32]);
  sse_i4_to_f64(XmmReg1[64,64], mmxreg2op[32,32]);
}

:CVTPI2PS     XmmReg, m64       is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2A; m64 & XmmReg ...
{
  local m:8 = m64;
  sse_i4_to_f32(XmmReg[0,32], m[0,32]);
  sse_i4_to_f32(XmmReg[32,32], m[32,32]);
}

:CVTPI2PS     XmmReg1, mmxreg2op  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x2A; xmmmod=3 & XmmReg1 & mmxreg2op
{
  sse_i4_to_f32(XmmReg1[0,32], mmxreg2op[0,32]);
  sse_i4_to_f32(XmmReg1[32,32], mmxreg2op[32,32]);
}

:CVTPS2DQ             XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x5B; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    local rc:1; sse_rc(rc);
    sse_f32_to_i4(XmmReg1[0,32], m[0,32], rc);
    sse_f32_to_i4(XmmReg1[32,32], m[32,32], rc);
    sse_f32_to_i4(XmmReg1[64,32], m[64,32], rc);
    sse_f32_to_i4(XmmReg1[96,32], m[96,32], rc);
}

:CVTPS2PD     XmmReg, m64       is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x5A; m64 & XmmReg ...
{
    local m:8 = m64;
    sse_widen32(XmmReg[0,64], m[0,32]);
    sse_widen32(XmmReg[64,64], m[32,32]);
}

:CVTPS2PD     XmmReg1, XmmReg2  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x5A; xmmmod=3 & XmmReg1 & XmmReg2
{
