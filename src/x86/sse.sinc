    ssdsw(sum, lane);
    XmmReg1[64,16] = lane;
    lo = zext(mdst[80,8]) * sext(msrc[80,8]);
    hi = zext(mdst[88,8]) * sext(msrc[88,8]);
    sum = lo + hi;
    ssdsw(sum, lane);
    XmmReg1[80,16] = lane;
    lo = zext(mdst[96,8]) * sext(msrc[96,8]);
    hi = zext(mdst[104,8]) * sext(msrc[104,8]);
    sum = lo + hi;
    ssdsw(sum, lane);
    XmmReg1[96,16] = lane;
    lo = zext(mdst[112,8]) * sext(msrc[112,8]);
    hi = zext(mdst[120,8]) * sext(msrc[120,8]);
    sum = lo + hi;
    ssdsw(sum, lane);
