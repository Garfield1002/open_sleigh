    pslld128(XmmReg1, m[0,64]);
}

:PSLLD           XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x72; mod = 0b11 & reg_opcode=6 & XmmReg2; imm8
{
    pslld128(XmmReg2, zext(imm8));
}

:PSLLQ                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xF3; XmmReg1 ... & XmmReg2_m128
{
