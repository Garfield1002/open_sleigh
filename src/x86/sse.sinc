:PSLLQ           XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x73; mod = 0b11 & reg_opcode=6 & XmmReg2; imm8
{
    psllq128(XmmReg2, zext(imm8));
}

:PSRAW                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xE1; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    psraw128(XmmReg1, m[0,64]);
}

:PSRAW           XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x71; mod = 0b11 & reg_opcode=4 & XmmReg2; imm8
{
    psraw128(XmmReg2, zext(imm8));
}

:PSRAD                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xE2; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    psrad128(XmmReg1, m[0,64]);
}

:PSRAD           XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x72; mod = 0b11 & reg_opcode=4 & XmmReg2; imm8
{
    psrad128(XmmReg2, zext(imm8));
}

:PSRLDQ         XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x73; xmmmod=3 & reg_opcode=3 & XmmReg2; imm8
{
# a count greater than 15 just clears all the bits
    XmmReg2 = XmmReg2 >> (imm8 * 8);
}

:PSRLW                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xD1; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    psrlw128(XmmReg1, m[0,64]);
}

:PSRLW           XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x71; mod = 0b11 & reg_opcode=2 & XmmReg2; imm8
{
    psrlw128(XmmReg2, zext(imm8));
}

:PSRLD                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xD2; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    psrld128(XmmReg1, m[0,64]);
}

:PSRLD           XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x72; mod = 0b11 & reg_opcode=2 & XmmReg2; imm8
{
    psrld128(XmmReg2, zext(imm8));
}

:PSRLQ                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xD3; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    psrlq128(XmmReg1, m[0,64]);
}

:PSRLQ           XmmReg2, imm8     is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x73; mod = 0b11 & reg_opcode=2 & XmmReg2; imm8
{
    psrlq128(XmmReg2, zext(imm8));
}

:PSUBQ                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xFB; XmmReg1 ... & XmmReg2_m128
{
	local m:16 = XmmReg2_m128;
	XmmReg1[0,64] = XmmReg1[0,64] - m[0,64];
	XmmReg1[64,64] = XmmReg1[64,64] - m[64,64];
}

:PSUBB                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xF8; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,8]   = XmmReg1[0,8]   - m[0,8];
    XmmReg1[8,8]   = XmmReg1[8,8]   - m[8,8];
    XmmReg1[16,8]  = XmmReg1[16,8]  - m[16,8];
    XmmReg1[24,8]  = XmmReg1[24,8]  - m[24,8];
    XmmReg1[32,8]  = XmmReg1[32,8]  - m[32,8];
    XmmReg1[40,8]  = XmmReg1[40,8]  - m[40,8];
    XmmReg1[48,8]  = XmmReg1[48,8]  - m[48,8];
    XmmReg1[56,8]  = XmmReg1[56,8]  - m[56,8];
    XmmReg1[64,8]  = XmmReg1[64,8]  - m[64,8];
    XmmReg1[72,8]  = XmmReg1[72,8]  - m[72,8];
    XmmReg1[80,8]  = XmmReg1[80,8]  - m[80,8];
    XmmReg1[88,8]  = XmmReg1[88,8]  - m[88,8];
    XmmReg1[96,8]  = XmmReg1[96,8]  - m[96,8];
    XmmReg1[104,8] = XmmReg1[104,8] - m[104,8];
    XmmReg1[112,8] = XmmReg1[112,8] - m[112,8];
    XmmReg1[120,8] = XmmReg1[120,8] - m[120,8];
}

:PSUBW                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xF9; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,16] = XmmReg1[0,16] - m[0,16];
    XmmReg1[16,16] = XmmReg1[16,16] - m[16,16];
    XmmReg1[32,16] = XmmReg1[32,16] - m[32,16];
    XmmReg1[48,16] = XmmReg1[48,16] - m[48,16];
    XmmReg1[64,16] = XmmReg1[64,16] - m[64,16];
    XmmReg1[80,16] = XmmReg1[80,16] - m[80,16];
    XmmReg1[96,16] = XmmReg1[96,16] - m[96,16];
    XmmReg1[112,16] = XmmReg1[112,16] - m[112,16];
}

:PSUBD                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xFA; XmmReg1 ... & XmmReg2_m128
{
  local m:16 = XmmReg2_m128;
  XmmReg1[0,32] = XmmReg1[0,32] - m[0,32];
  XmmReg1[32,32] = XmmReg1[32,32] - m[32,32];
  XmmReg1[64,32] = XmmReg1[64,32] - m[64,32];
  XmmReg1[96,32] = XmmReg1[96,32] - m[96,32];
}

:PSUBSB          XmmReg1, XmmReg2_m128      is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0xE8; XmmReg1 ... & XmmReg2_m128 ... { XmmReg1 = psubsb(XmmReg1, XmmReg2_m128); }

:PSUBSW          XmmReg1, XmmReg2_m128      is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0xE9; XmmReg1 ... & XmmReg2_m128 ... { XmmReg1 = psubsw(XmmReg1, XmmReg2_m128); }

:PSUBUSB         XmmReg1, XmmReg2_m128      is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xD8; XmmReg1 ... & XmmReg2_m128 { XmmReg1 = psubusb(XmmReg1, XmmReg2_m128); }

:PSUBUSW         XmmReg1, XmmReg2_m128      is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xD9; XmmReg1 ... & XmmReg2_m128 { XmmReg1 = psubusw(XmmReg1, XmmReg2_m128); }

:PUNPCKHBW            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x68; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,8] = XmmReg1[64,8];
    XmmReg1[8,8] =   m[64,8];
    XmmReg1[16,8] = XmmReg1[72,8];
    XmmReg1[24,8] =   m[72,8];
    XmmReg1[32,8] = XmmReg1[80,8];
    XmmReg1[40,8] =   m[80,8];
    XmmReg1[48,8] = XmmReg1[88,8];
    XmmReg1[56,8] =   m[88,8];
    XmmReg1[64,8] = XmmReg1[96,8];
    XmmReg1[72,8] =   m[96,8];
    XmmReg1[80,8] = XmmReg1[104,8];
    XmmReg1[88,8] =   m[104,8];
    XmmReg1[96,8] = XmmReg1[112,8];
    XmmReg1[104,8] =   m[112,8];
    XmmReg1[112,8] = XmmReg1[120,8];
    XmmReg1[120,8] =   m[120,8];
}

# full set of XMM byte registers
:PUNPCKHWD            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x69; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,16] = XmmReg1[64,16];
    XmmReg1[16,16] =   m[64,16];
    XmmReg1[32,16] = XmmReg1[80,16];
    XmmReg1[48,16] =   m[80,16];
    XmmReg1[64,16] = XmmReg1[96,16];
    XmmReg1[80,16] =   m[96,16];
    XmmReg1[96,16] = XmmReg1[112,16];
    XmmReg1[112,16] =   m[112,16];
}

:PUNPCKHDQ            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x6A; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = XmmReg1[64,32];
    XmmReg1[32,32] =   m[64,32];
    XmmReg1[64,32] = XmmReg1[96,32];
    XmmReg1[96,32] =   m[96,32];
}

:PUNPCKHQDQ           XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x6D; XmmReg1 ... & XmmReg2_m128
{
    XmmReg1[0,64] = XmmReg1[64,64];
    XmmReg1[64,64] =   XmmReg2_m128[64,64];
}

:PUNPCKLBW            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x60; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[120,8] =   m[56,8];
    XmmReg1[112,8] = XmmReg1[56,8];
    XmmReg1[104,8] =   m[48,8];
    XmmReg1[96,8] = XmmReg1[48,8];
    XmmReg1[88,8] =   m[40,8];
    XmmReg1[80,8] = XmmReg1[40,8];
    XmmReg1[72,8] =   m[32,8];
    XmmReg1[64,8] = XmmReg1[32,8];
    XmmReg1[56,8] =   m[24,8];
    XmmReg1[48,8] = XmmReg1[24,8];
    XmmReg1[40,8] =   m[16,8];
    XmmReg1[32,8] = XmmReg1[16,8];
    XmmReg1[24,8] =   m[8,8];
    XmmReg1[16,8] = XmmReg1[8,8];
    XmmReg1[8,8] =   m[0,8];
#   XmmReg1[0,8] = XmmReg1[0,8]; superfluous
}

:PUNPCKLWD            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x61; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[112,16] =   m[48,16];
    XmmReg1[96,16] = XmmReg1[48,16];
    XmmReg1[80,16] =   m[32,16];
    XmmReg1[64,16] = XmmReg1[32,16];
    XmmReg1[48,16] =   m[16,16];
    XmmReg1[32,16] = XmmReg1[16,16];
    XmmReg1[16,16] =   m[0,16];
#   XmmReg1[0,16] = XmmReg1[0,16]; superfluous
}

:PUNPCKLDQ            XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x62; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[96,32] =   m[32,32];
    XmmReg1[64,32] = XmmReg1[32,32];
    XmmReg1[32,32] =   m[0,32];
#   XmmReg1[0,32] = XmmReg1[0,32]; superfluous
}

:PUNPCKLQDQ           XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0x6C; XmmReg1 ... & XmmReg2_m128
{
    XmmReg1[64,64] =   XmmReg2_m128[0,64];
#   XmmReg1[0,64] = XmmReg1[0,64]; superfluous
}

:PXOR                XmmReg1, XmmReg2_m128  is vexMode=0 &  $(PRE_66) & byte=0x0F; byte=0xEF; XmmReg1 ... & XmmReg2_m128
{ XmmReg1 = XmmReg1 ^ XmmReg2_m128; }

:RCPPS               XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x53; XmmReg1 ... & XmmReg2_m128
{ XmmReg1 = rcpps(XmmReg1, XmmReg2_m128); }

:RCPSS           XmmReg, m32      is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x53; XmmReg ... & m32 { XmmReg = rcpss(XmmReg, m32); }

:RCPSS           XmmReg1, XmmReg2 is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x53; xmmmod = 3 & XmmReg1 & XmmReg2 { XmmReg1 = rcpss(XmmReg1, XmmReg2); }

:RSQRTPS             XmmReg1, XmmReg2_m128  is vexMode=0 &  mandover=0 & byte=0x0F; byte=0x52; XmmReg1 ... & XmmReg2_m128
{ XmmReg1 = rsqrtps(XmmReg1, XmmReg2_m128); }

:RSQRTSS         XmmReg, m32      is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x52; XmmReg ... & m32 { XmmReg = rsqrtss(XmmReg, m32); }

:RSQRTSS         XmmReg1, XmmReg2 is vexMode=0 &  $(PRE_F3) & byte=0x0F; byte=0x52; xmmmod = 3 & XmmReg1 & XmmReg2 { XmmReg1 = rsqrtss(XmmReg1, XmmReg2); }

:SHUFPD          XmmReg1, XmmReg2_m128, imm8     is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0xC6; XmmReg1 ... & XmmReg2_m128; imm8 
{ 
    local srcLow:8 = XmmReg2_m128[0,64];
    local srcHigh:8 = XmmReg2_m128[64,64];
    local destLow:8 = XmmReg1[0,64];
    local destHigh:8 = XmmReg1[64,64];
    local control:1 = (imm8 & 0x1)== 0:1;
    conditionalAssign(XmmReg1[0,64],control,destLow,destHigh);
    control = (imm8 & 0x2) == 0:1;
    conditionalAssign(XmmReg1[64,64],control,srcLow,srcHigh); 
}

:SHUFPS  XmmReg1, XmmReg2_m128, imm8  is vexMode=0 & mandover=0 & byte=0x0F; byte=0xC6; (XmmReg2_m128 & XmmReg1 ...); imm8 & Order0 & Order1 & Order2 & Order3
{
    local xmmreg2_m128_c0 = XmmReg2_m128[0,32];
    local xmmreg2_m128_c1 = XmmReg2_m128[32,32];
    local xmmreg2_m128_c2 = XmmReg2_m128[64,32];
    local xmmreg2_m128_c3 = XmmReg2_m128[96,32];

    local xmm_c0 = XmmReg1[0,32];
    local xmm_c1 = XmmReg1[32,32];
    local xmm_c2 = XmmReg1[64,32];
    local xmm_c3 = XmmReg1[96,32];

    shuffle_4(XmmReg1[0,32],Order0,xmm_c0,xmm_c1,xmm_c2,xmm_c3);
    shuffle_4(XmmReg1[32,32],Order1,xmm_c0,xmm_c1,xmm_c2,xmm_c3);
    shuffle_4(XmmReg1[64,32],Order2,xmmreg2_m128_c0,xmmreg2_m128_c1,xmmreg2_m128_c2,xmmreg2_m128_c3);
    shuffle_4(XmmReg1[96,32],Order3,xmmreg2_m128_c0,xmmreg2_m128_c1,xmmreg2_m128_c2,xmmreg2_m128_c3);
}

:SQRTPD              XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x51; XmmReg1 ... & XmmReg2_m128
{ sqrtpd128(XmmReg1, XmmReg2_m128); }

:SQRTPS              XmmReg1, XmmReg2_m128  is vexMode=0 & mandover=0 & byte=0x0F; byte=0x51; XmmReg1 ... & XmmReg2_m128
{ sqrtps128(XmmReg1, XmmReg2_m128); }

:SQRTSD          XmmReg, m64      is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x51; XmmReg ... & m64 { XmmReg[0,64] = sqrt(m64); }

:SQRTSD          XmmReg1, XmmReg2  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x51; xmmmod=3 & XmmReg1 & XmmReg2 { XmmReg1[0,64] = sqrt(XmmReg2[0,64]); }

:SQRTSS          XmmReg, m32      is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x51; XmmReg ... & m32 { XmmReg[0,32] = sqrt(m32); }

:SQRTSS          XmmReg1, XmmReg2  is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x51; xmmmod=3 & XmmReg1 & XmmReg2 { XmmReg1[0,32] = sqrt(XmmReg2[0,32]); }

:SUBPD               XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x5C; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = XmmReg1[0,64] f- m[0,64];
    XmmReg1[64,64] = XmmReg1[64,64] f- m[64,64];
}

:SUBPS               XmmReg1, XmmReg2_m128  is vexMode=0 & mandover=0 & byte=0x0F; byte=0x5C; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = XmmReg1[0,32] f- m[0,32];
    XmmReg1[32,32] = XmmReg1[32,32] f- m[32,32];
    XmmReg1[64,32] = XmmReg1[64,32] f- m[64,32];
    XmmReg1[96,32] = XmmReg1[96,32] f- m[96,32];
}

:SUBSD           XmmReg, m64      is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x5C; XmmReg ... & m64 { XmmReg[0,64] = XmmReg[0,64] f- m64; }

:SUBSD           XmmReg1, XmmReg2  is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x5C; xmmmod=3 & XmmReg1 & XmmReg2 { XmmReg1[0,64] = XmmReg1[0,64] f- XmmReg2[0,64]; }

:SUBSS           XmmReg, m32      is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x5C; XmmReg ...& m32 { XmmReg[0,32] = XmmReg[0,32] f- m32; }

:SUBSS           XmmReg1, XmmReg2  is vexMode=0 & $(PRE_F3) & byte=0x0F; byte=0x5C; xmmmod=3 & XmmReg1 & XmmReg2 { XmmReg1[0,32] = XmmReg1[0,32] f- XmmReg2[0,32]; }

:UCOMISD         XmmReg, m64      is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x2E; m64 & XmmReg ...
{
	fucompe(XmmReg[0,64], m64);
}

:UCOMISD         XmmReg1, XmmReg2  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x2E; xmmmod=3 & XmmReg1 & XmmReg2
{
	fucompe(XmmReg1[0,64], XmmReg2[0,64]);
}

:UCOMISS         XmmReg, m32      is vexMode=0 & mandover=0 & byte=0x0F; byte=0x2E; m32 & XmmReg ...
{
    fucompe(XmmReg[0,32], m32);
}

:UCOMISS         XmmReg1, XmmReg2  is vexMode=0 & mandover=0 & byte=0x0F; byte=0x2E; xmmmod=3 & XmmReg1 & XmmReg2
{
    fucompe(XmmReg1[0,32], XmmReg2[0,32]);
}

:UNPCKHPD            XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x15; XmmReg1 ... & XmmReg2_m128
{
    XmmReg1[0,64] = XmmReg1[64,64];
    XmmReg1[64,64] = XmmReg2_m128[64,64];
}

:UNPCKHPS            XmmReg1, XmmReg2_m128  is vexMode=0 & mandover=0 & byte=0x0F; byte=0x15; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;  # XmmReg1 and XmmReg2 could be the same register
    XmmReg1[0,32] = XmmReg1[64,32];
    XmmReg1[64,32] = XmmReg1[96,32];
    XmmReg1[32,32] = m[64,32];
    XmmReg1[96,32] = m[96,32];
}

:UNPCKLPD            XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x14; XmmReg1 ... & XmmReg2_m128
{
#   XmmReg1[0,64] = XmmReg1[0,64]; superfluous
    XmmReg1[64,64] = XmmReg2_m128[0,64];
}

:UNPCKLPS            XmmReg1, XmmReg2_m128  is vexMode=0 & mandover=0 & byte=0x0F; byte=0x14; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;  # XmmReg1 and XmmReg2 could be the same register
#   XmmReg1[0,32] = XmmReg1[0,32]; superfluous
    XmmReg1[64,32] = XmmReg1[32,32];
    XmmReg1[32,32] = m[0,32];
    XmmReg1[96,32] = m[32,32];
}

:XORPD               XmmReg1, XmmReg2_m128  is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x57; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,64] = ( XmmReg1[0,64] ^ m[0,64] );
    XmmReg1[64,64] = ( XmmReg1[64,64] ^ m[64,64] );
}

:XORPS               XmmReg1, XmmReg2_m128  is vexMode=0 & mandover=0 & byte=0x0F; byte=0x57; XmmReg1 ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    XmmReg1[0,32] = ( XmmReg1[0,32] ^ m[0,32] );
    XmmReg1[32,32] = ( XmmReg1[32,32] ^ m[32,32] );
    XmmReg1[64,32] = ( XmmReg1[64,32] ^ m[64,32] );
