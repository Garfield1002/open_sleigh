    t = (!va[0,1] || (x[0,16] == y[0,16] && vb[0,1])) && (!va[1,1] || (x[16,16] == y[16,16] && vb[1,1])) && (!va[2,1] || (x[32,16] == y[32,16] && vb[2,1])) && (!va[3,1] || (x[48,16] == y[48,16] && vb[3,1])) && (!va[4,1] || (x[64,16] == y[64,16] && vb[4,1])) && (!va[5,1] || (x[80,16] == y[80,16] && vb[5,1])) && (!va[6,1] || (x[96,16] == y[96,16] && vb[6,1])) && (!va[7,1] || (x[112,16] == y[112,16] && vb[7,1])); m = m | (zext(t) << 0);
    t = (!va[0,1] || (x[0,16] == y[16,16] && vb[1,1])) && (!va[1,1] || (x[16,16] == y[32,16] && vb[2,1])) && (!va[2,1] || (x[32,16] == y[48,16] && vb[3,1])) && (!va[3,1] || (x[48,16] == y[64,16] && vb[4,1])) && (!va[4,1] || (x[64,16] == y[80,16] && vb[5,1])) && (!va[5,1] || (x[80,16] == y[96,16] && vb[6,1])) && (!va[6,1] || (x[96,16] == y[112,16] && vb[7,1])); m = m | (zext(t) << 1);
    t = (!va[0,1] || (x[0,16] == y[32,16] && vb[2,1])) && (!va[1,1] || (x[16,16] == y[48,16] && vb[3,1])) && (!va[2,1] || (x[32,16] == y[64,16] && vb[4,1])) && (!va[3,1] || (x[48,16] == y[80,16] && vb[5,1])) && (!va[4,1] || (x[64,16] == y[96,16] && vb[6,1])) && (!va[5,1] || (x[80,16] == y[112,16] && vb[7,1])); m = m | (zext(t) << 2);
    t = (!va[0,1] || (x[0,16] == y[48,16] && vb[3,1])) && (!va[1,1] || (x[16,16] == y[64,16] && vb[4,1])) && (!va[2,1] || (x[32,16] == y[80,16] && vb[5,1])) && (!va[3,1] || (x[48,16] == y[96,16] && vb[6,1])) && (!va[4,1] || (x[64,16] == y[112,16] && vb[7,1])); m = m | (zext(t) << 3);
    t = (!va[0,1] || (x[0,16] == y[64,16] && vb[4,1])) && (!va[1,1] || (x[16,16] == y[80,16] && vb[5,1])) && (!va[2,1] || (x[32,16] == y[96,16] && vb[6,1])) && (!va[3,1] || (x[48,16] == y[112,16] && vb[7,1])); m = m | (zext(t) << 4);
    t = (!va[0,1] || (x[0,16] == y[80,16] && vb[5,1])) && (!va[1,1] || (x[16,16] == y[96,16] && vb[6,1])) && (!va[2,1] || (x[32,16] == y[112,16] && vb[7,1])); m = m | (zext(t) << 5);
    t = (!va[0,1] || (x[0,16] == y[96,16] && vb[6,1])) && (!va[1,1] || (x[16,16] == y[112,16] && vb[7,1])); m = m | (zext(t) << 6);
    t = (!va[0,1] || (x[0,16] == y[112,16] && vb[7,1])); m = m | (zext(t) << 7);
    res = m;
}

macro pcmpstr_polarity_w(res, ctl, vb) {
    local c:1 = ctl;
    local flip:2; conditionalAssign(flip, c[5,1], vb, 0xff:2);
    local flipped:2 = res ^ flip;
    conditionalAssign(res, c[4,1], flipped, res);
}

macro pcmpstr_index_w(idx, res, ctl) {
    local c:1 = ctl;
    local r:2 = res;
    local lsb:4 = 8;
    conditionalAssign(lsb, r[7,1], 7:4, lsb);
    conditionalAssign(lsb, r[6,1], 6:4, lsb);
    conditionalAssign(lsb, r[5,1], 5:4, lsb);
    conditionalAssign(lsb, r[4,1], 4:4, lsb);
    conditionalAssign(lsb, r[3,1], 3:4, lsb);
    conditionalAssign(lsb, r[2,1], 2:4, lsb);
    conditionalAssign(lsb, r[1,1], 1:4, lsb);
    conditionalAssign(lsb, r[0,1], 0:4, lsb);
    local msb:4 = 8;
    conditionalAssign(msb, r[0,1], 0:4, msb);
    conditionalAssign(msb, r[1,1], 1:4, msb);
    conditionalAssign(msb, r[2,1], 2:4, msb);
    conditionalAssign(msb, r[3,1], 3:4, msb);
    conditionalAssign(msb, r[4,1], 4:4, msb);
    conditionalAssign(msb, r[5,1], 5:4, msb);
    conditionalAssign(msb, r[6,1], 6:4, msb);
    conditionalAssign(msb, r[7,1], 7:4, msb);
    conditionalAssign(idx, c[6,1], msb, lsb);
}

macro pcmpstr_mask_w(out, res, ctl) {
    local c:1 = ctl;
    local r:2 = res;
    local expanded:16 = 0;
    local lane:2;
    lane = 0 - zext(r[0,1]); expanded = expanded | (zext(lane) << 0);
    lane = 0 - zext(r[1,1]); expanded = expanded | (zext(lane) << 16);
    lane = 0 - zext(r[2,1]); expanded = expanded | (zext(lane) << 32);
    lane = 0 - zext(r[3,1]); expanded = expanded | (zext(lane) << 48);
    lane = 0 - zext(r[4,1]); expanded = expanded | (zext(lane) << 64);
    lane = 0 - zext(r[5,1]); expanded = expanded | (zext(lane) << 80);
    lane = 0 - zext(r[6,1]); expanded = expanded | (zext(lane) << 96);
    lane = 0 - zext(r[7,1]); expanded = expanded | (zext(lane) << 112);
    local narrow:16 = zext(r);
    conditionalAssign(out, c[6,1], expanded, narrow);
}

macro pcmpstr_flags_w(res, va, vb) {
    CF = res != 0;
    ZF = vb != 0xff:2;
    SF = va != 0xff:2;
    OF = res[0,1];
    AF = 0;
    PF = 0;
}

:PCMPESTRM XmmReg1, XmmReg2_m128, imm8 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x3A; byte=0x60; (XmmReg2_m128 & XmmReg1 ...); imm8
{
    local ctl:1 = imm8;
    local a:16 = XmmReg1;
    local b:16 = XmmReg2_m128;
    local mode:1 = (ctl >> 2) & 3;
    local va:2; local vb:2; local res:2;
    local out:16 = 0;
    if ((ctl & 1) != 0) goto <words>;
    pcmpstr_explicit_b(EAX, va);
    pcmpstr_explicit_b(EDX, vb);
    if (mode != 0) goto <b_ranges>;
    pcmpstr_any_b(res, a, b, va, vb);
    goto <b_done>;
<b_ranges>
    if (mode != 1) goto <b_each>;
    if ((ctl & 2) != 0) goto <b_sranges>;
    pcmpstr_ranges_b(res, a, b, va, vb);
    goto <b_done>;
<b_sranges>
    pcmpstr_rangess_b(res, a, b, va, vb);
    goto <b_done>;
<b_each>
    if (mode != 2) goto <b_ordered>;
    pcmpstr_each_b(res, a, b, va, vb);
    goto <b_done>;
<b_ordered>
    pcmpstr_ordered_b(res, a, b, va, vb);
<b_done>
    pcmpstr_polarity_b(res, ctl, vb);
    pcmpstr_mask_b(out, res, ctl);
    pcmpstr_flags_b(res, va, vb);
    goto <end>;
<words>
    pcmpstr_explicit_w(EAX, va);
    pcmpstr_explicit_w(EDX, vb);
    if (mode != 0) goto <w_ranges>;
    pcmpstr_any_w(res, a, b, va, vb);
    goto <w_done>;
<w_ranges>
    if (mode != 1) goto <w_each>;
    if ((ctl & 2) != 0) goto <w_sranges>;
    pcmpstr_ranges_w(res, a, b, va, vb);
    goto <w_done>;
<w_sranges>
    pcmpstr_rangess_w(res, a, b, va, vb);
    goto <w_done>;
<w_each>
    if (mode != 2) goto <w_ordered>;
    pcmpstr_each_w(res, a, b, va, vb);
    goto <w_done>;
<w_ordered>
    pcmpstr_ordered_w(res, a, b, va, vb);
<w_done>
    pcmpstr_polarity_w(res, ctl, vb);
    pcmpstr_mask_w(out, res, ctl);
    pcmpstr_flags_w(res, va, vb);
<end>
    XMM0 = out;
}

