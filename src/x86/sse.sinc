    XmmReg1[0,8] = pavgb(XmmReg1[0,8], m[0,8]);
    XmmReg1[8,8] = pavgb(XmmReg1[8,8], m[8,8]);
    XmmReg1[16,8] = pavgb(XmmReg1[16,8], m[16,8]);
