    local hi:16 = YmmReg2_m256_H;
    avx_fmin32(YmmReg1[0,64], vexVVVV_YmmReg_L[0,64], lo[0,64]);
    avx_fmin32(YmmReg1[64,64], vexVVVV_YmmReg_L[64,64], lo[64,64]);
    avx_fmin32(YmmReg1[128,64], vexVVVV_YmmReg_H[0,64], hi[0,64]);
