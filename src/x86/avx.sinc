{
    local lo:16 = YmmReg2_m256_L;
    local hi:16 = YmmReg2_m256_H;
    avx_fmin64(YmmReg1[0,64], vexVVVV_YmmReg_L[0,64], lo[0,64]);
    avx_fmin64(YmmReg1[64,64], vexVVVV_YmmReg_L[64,64], lo[64,64]);
    avx_fmin64(YmmReg1[128,64], vexVVVV_YmmReg_H[0,64], hi[0,64]);
    avx_fmin64(YmmReg1[192,64], vexVVVV_YmmReg_H[64,64], hi[64,64]);
}

# VMINPS
:VMINPS XmmReg1, vexVVVV_XmmReg, XmmReg2_m128 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_NONE) & $(VEX_0F) & $(VEX_WIG) & vexVVVV_XmmReg; byte=0x5D; (XmmReg1 & YmmReg1) ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    avx_fmin32(YmmReg1[0,64], vexVVVV_XmmReg[0,64], m[0,64]);
    avx_fmin32(YmmReg1[64,64], vexVVVV_XmmReg[64,64], m[64,64]);
    avx_zero_upper(YmmReg1);
}

