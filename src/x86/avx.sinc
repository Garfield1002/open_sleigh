#@family avx
# The regular three-operand packed AVX and AVX2 forms, on 64-bit lanes.
# Generated by scripts/avx_gen.py; do not edit. The lane macros live in
# avx_macros.sinc, the half-width operands in avx_operands.sinc, and the
# irregular instructions in avx_manual.sinc / avx2_manual.sinc.

# VADDPD
:VADDPD XmmReg1, vexVVVV_XmmReg, XmmReg2_m128 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F) & $(VEX_WIG) & vexVVVV_XmmReg; byte=0x58; (XmmReg1 & YmmReg1) ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    avx_fadd64(YmmReg1[0,64], vexVVVV_XmmReg[0,64], m[0,64]);
    avx_fadd64(YmmReg1[64,64], vexVVVV_XmmReg[64,64], m[64,64]);
    avx_zero_upper(YmmReg1);
}

