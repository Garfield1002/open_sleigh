{
    local x:16 = YmmReg2_L;
    local y:16 = YmmReg2_H;
    Reg32 = zext(x[31,1]) | (zext(x[63,1]) << 1) | (zext(x[95,1]) << 2) | (zext(x[127,1]) << 3)
          | (zext(y[31,1]) << 4) | (zext(y[63,1]) << 5) | (zext(y[95,1]) << 6) | (zext(y[127,1]) << 7);
    build check_Reg32_dest;
}

