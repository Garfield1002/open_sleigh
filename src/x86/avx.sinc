# VINSERTPS
:VINSERTPS XmmReg1, vexVVVV_XmmReg, XmmReg2_m32, imm8 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F3A) & $(VEX_WIG) & vexVVVV_XmmReg; byte=0x21; (XmmReg1 & YmmReg1) ... & XmmReg2_m32; imm8
{
    local m:4 = XmmReg2_m32;
    local va:16 = vexVVVV_XmmReg;
    local s:1 = imm8;
    local src:4 = m;
    local d:16 = va;
    local dsel:1 = (s >> 4) & 3;
    local zm:1 = s & 0xf;
    local v0:4 = d[0,32] * zext(dsel != 0) + src * zext(dsel == 0);
    local v1:4 = d[32,32] * zext(dsel != 1) + src * zext(dsel == 1);
    local v2:4 = d[64,32] * zext(dsel != 2) + src * zext(dsel == 2);
    local v3:4 = d[96,32] * zext(dsel != 3) + src * zext(dsel == 3);
    YmmReg1[0,32] = v0 * zext(zm[0,1] == 0);
    YmmReg1[32,32] = v1 * zext(zm[1,1] == 0);
    YmmReg1[64,32] = v2 * zext(zm[2,1] == 0);
    YmmReg1[96,32] = v3 * zext(zm[3,1] == 0);
    avx_zero_upper(YmmReg1);
}

