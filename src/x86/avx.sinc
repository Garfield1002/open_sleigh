# VMOVMSKPD
:VMOVMSKPD Reg32, XmmReg2 is $(VEX_NONE) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F) & $(VEX_WIG); byte=0x50; Reg32 & check_Reg32_dest & (mod=0x3 & XmmReg2)
{
    local x:16 = XmmReg2;
    Reg32 = zext(x[63,1]) | (zext(x[127,1]) << 1);
    build check_Reg32_dest;
}

# VMOVMSKPD
:VMOVMSKPD Reg32, YmmReg2 is $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F) & $(VEX_WIG); byte=0x50; Reg32 & check_Reg32_dest & (mod=0x3 & YmmReg2 & YmmReg2_L & YmmReg2_H)
{
    local x:16 = YmmReg2_L;
    local y:16 = YmmReg2_H;
    Reg32 = zext(x[63,1]) | (zext(x[127,1]) << 1) | (zext(y[63,1]) << 2) | (zext(y[127,1]) << 3);
    build check_Reg32_dest;
}

# VMOVMSKPS
:VMOVMSKPS Reg32, XmmReg2 is $(VEX_NONE) & $(VEX_L128) & $(VEX_PRE_NONE) & $(VEX_0F) & $(VEX_WIG); byte=0x50; Reg32 & check_Reg32_dest & (mod=0x3 & XmmReg2)
