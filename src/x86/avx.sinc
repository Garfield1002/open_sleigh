# VPCMPEQQ
:VPCMPEQQ XmmReg1, vexVVVV_XmmReg, XmmReg2_m128 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_WIG) & vexVVVV_XmmReg; byte=0x29; (XmmReg1 & YmmReg1) ... & XmmReg2_m128
{
    local m:16 = XmmReg2_m128;
    avx_cmpeq64(YmmReg1[0,64], vexVVVV_XmmReg[0,64], m[0,64]);
    avx_cmpeq64(YmmReg1[64,64], vexVVVV_XmmReg[64,64], m[64,64]);
    avx_zero_upper(YmmReg1);
}

# VPMOVMSKB
:VPMOVMSKB Reg32, XmmReg2 is $(VEX_NONE) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F) & $(VEX_WIG); byte=0xD7; Reg32 & (mod=0x3 & XmmReg2) & check_Reg32_dest
{
    local x:16 = XmmReg2;
    local r:4; avx_bytemask(r[0,8], x[0,64]); avx_bytemask(r[8,8], x[64,64]); r[16,16] = 0;
    Reg32 = r;
    build check_Reg32_dest;
}

# VPCMPEQQ
:VPCMPEQQ YmmReg1, vexVVVV_YmmReg, YmmReg2_m256 is $(VEX_NDS) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_WIG) & vexVVVV_YmmReg & vexVVVV_YmmReg_L & vexVVVV_YmmReg_H; byte=0x29; (YmmReg1 & YmmReg2_m256) ... & YmmReg2_m256_L & YmmReg2_m256_H
{
    local lo:16 = YmmReg2_m256_L;
    local hi:16 = YmmReg2_m256_H;
    avx_cmpeq64(YmmReg1[0,64], vexVVVV_YmmReg_L[0,64], lo[0,64]);
    avx_cmpeq64(YmmReg1[64,64], vexVVVV_YmmReg_L[64,64], lo[64,64]);
    avx_cmpeq64(YmmReg1[128,64], vexVVVV_YmmReg_H[0,64], hi[0,64]);
    avx_cmpeq64(YmmReg1[192,64], vexVVVV_YmmReg_H[64,64], hi[64,64]);
}

# VPMOVMSKB
:VPMOVMSKB Reg32, YmmReg2 is $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F) & $(VEX_WIG); byte=0xD7; Reg32 & (mod=0x3 & YmmReg2 & YmmReg2_L & YmmReg2_H) & check_Reg32_dest
{
    local x:16 = YmmReg2_L;
    local y:16 = YmmReg2_H;
    local r:4;
    avx_bytemask(r[0,8], x[0,64]); avx_bytemask(r[8,8], x[64,64]);
    avx_bytemask(r[16,8], y[0,64]); avx_bytemask(r[24,8], y[64,64]);
    Reg32 = r;
    build check_Reg32_dest;
}

# VINSERTI128
:VINSERTI128 YmmReg1, vexVVVV_YmmReg, XmmReg2_m128, imm8 is $(VEX_NDS) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F3A) & $(VEX_W0) & vexVVVV_YmmReg & vexVVVV_YmmReg_L & vexVVVV_YmmReg_H; byte=0x38; YmmReg1 ... & XmmReg2_m128; imm8
{
    local m:16 = XmmReg2_m128;
    local vlo:16 = vexVVVV_YmmReg_L;
    local vhi:16 = vexVVVV_YmmReg_H;
    local s:1 = imm8 & 1;
    local kl:8 = 0 - zext(s == 0);
    local kh:8 = ~kl;
    YmmReg1[0,64] = (m[0,64] & kl) | (vlo[0,64] & kh);
    YmmReg1[64,64] = (m[64,64] & kl) | (vlo[64,64] & kh);
    YmmReg1[128,64] = (m[0,64] & kh) | (vhi[0,64] & kl);
    YmmReg1[192,64] = (m[64,64] & kh) | (vhi[64,64] & kl);
}

