#@family avx
# Hand-written AVX forms that do not fit the generated lane shapes. Everything
# else VEX-encoded is produced by scripts/avx_gen.py into avx.sinc.

# VZEROUPPER clears bits 128-255 of every YMM; VZEROALL clears the whole
# register. Both also zero the ZMM upper bits, which are left untouched here
# (see avx_macros.sinc).
:VZEROUPPER  is $(VEX_NONE) & $(VEX_L128) & $(VEX_PRE_NONE) & $(VEX_0F) & $(VEX_WIG); byte=0x77
{
    avx_zero_upper(YMM0);
    avx_zero_upper(YMM1);
    avx_zero_upper(YMM2);
    avx_zero_upper(YMM3);
    avx_zero_upper(YMM4);
    avx_zero_upper(YMM5);
    avx_zero_upper(YMM6);
    avx_zero_upper(YMM7);
}

@ifdef IA64
:VZEROUPPER  is $(LONGMODE_ON) & $(VEX_NONE) & $(VEX_L128) & $(VEX_PRE_NONE) & $(VEX_0F) & $(VEX_WIG); byte=0x77
{
    avx_zero_upper(YMM0);
    avx_zero_upper(YMM1);
    avx_zero_upper(YMM2);
    avx_zero_upper(YMM3);
    avx_zero_upper(YMM4);
    avx_zero_upper(YMM5);
    avx_zero_upper(YMM6);
    avx_zero_upper(YMM7);
    avx_zero_upper(YMM8);
    avx_zero_upper(YMM9);
    avx_zero_upper(YMM10);
    avx_zero_upper(YMM11);
    avx_zero_upper(YMM12);
    avx_zero_upper(YMM13);
    avx_zero_upper(YMM14);
    avx_zero_upper(YMM15);
}
@endif

:VZEROALL  is $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_NONE) & $(VEX_0F) & $(VEX_WIG); byte=0x77
{
    YMM0[0,64] = 0:8; YMM0[64,64] = 0:8; avx_zero_upper(YMM0);
    YMM1[0,64] = 0:8; YMM1[64,64] = 0:8; avx_zero_upper(YMM1);
    YMM2[0,64] = 0:8; YMM2[64,64] = 0:8; avx_zero_upper(YMM2);
    YMM3[0,64] = 0:8; YMM3[64,64] = 0:8; avx_zero_upper(YMM3);
    YMM4[0,64] = 0:8; YMM4[64,64] = 0:8; avx_zero_upper(YMM4);
    YMM5[0,64] = 0:8; YMM5[64,64] = 0:8; avx_zero_upper(YMM5);
    YMM6[0,64] = 0:8; YMM6[64,64] = 0:8; avx_zero_upper(YMM6);
    YMM7[0,64] = 0:8; YMM7[64,64] = 0:8; avx_zero_upper(YMM7);
}

@ifdef IA64
:VZEROALL  is $(LONGMODE_ON) & $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_NONE) & $(VEX_0F) & $(VEX_WIG); byte=0x77
{
    YMM0[0,64] = 0:8; YMM0[64,64] = 0:8; avx_zero_upper(YMM0);
    YMM1[0,64] = 0:8; YMM1[64,64] = 0:8; avx_zero_upper(YMM1);
    YMM2[0,64] = 0:8; YMM2[64,64] = 0:8; avx_zero_upper(YMM2);
    YMM3[0,64] = 0:8; YMM3[64,64] = 0:8; avx_zero_upper(YMM3);
    YMM4[0,64] = 0:8; YMM4[64,64] = 0:8; avx_zero_upper(YMM4);
    YMM5[0,64] = 0:8; YMM5[64,64] = 0:8; avx_zero_upper(YMM5);
    YMM6[0,64] = 0:8; YMM6[64,64] = 0:8; avx_zero_upper(YMM6);
    YMM7[0,64] = 0:8; YMM7[64,64] = 0:8; avx_zero_upper(YMM7);
    YMM8[0,64] = 0:8; YMM8[64,64] = 0:8; avx_zero_upper(YMM8);
    YMM9[0,64] = 0:8; YMM9[64,64] = 0:8; avx_zero_upper(YMM9);
    YMM10[0,64] = 0:8; YMM10[64,64] = 0:8; avx_zero_upper(YMM10);
    YMM11[0,64] = 0:8; YMM11[64,64] = 0:8; avx_zero_upper(YMM11);
    YMM12[0,64] = 0:8; YMM12[64,64] = 0:8; avx_zero_upper(YMM12);
    YMM13[0,64] = 0:8; YMM13[64,64] = 0:8; avx_zero_upper(YMM13);
    YMM14[0,64] = 0:8; YMM14[64,64] = 0:8; avx_zero_upper(YMM14);
    YMM15[0,64] = 0:8; YMM15[64,64] = 0:8; avx_zero_upper(YMM15);
}
@endif
